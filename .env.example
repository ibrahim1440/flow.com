# ═══════════════════════════════════════════════════════════════════════════════
#  HIQBAH COFFEE — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  Never commit the real .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
#
# Get both URLs from your database provider:
#
#  Supabase  →  Project Settings → Database → Connection string
#               DATABASE_URL : "Transaction" mode  (port 6543)
#               DIRECT_URL   : "Session" mode      (port 5432)
#
#  Neon      →  Project Dashboard → Connection Details
#               DATABASE_URL : Pooled connection string
#               DIRECT_URL   : Direct (non-pooled) connection string
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
#
# Generate a strong secret (minimum 32 characters):
#   openssl rand -base64 32
#
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"

# ─── PIN login ────────────────────────────────────────────────────────────────
#
# REQUIRED. PIN login finds an employee by an HMAC of the entered PIN, keyed by this
# value; without it the application refuses to authenticate anyone by PIN.
#
# Its own secret, deliberately: not JWT_SECRET and not the rate-limit pepper. Sharing one
# value would mean a single leak compromised session forgery and credential recovery
# together. Minimum 32 characters, and placeholder values are refused.
#
#   openssl rand -base64 32
#
# ROTATION IS A MAINTENANCE WINDOW, NOT A CONFIG CHANGE. A stored lookup does not say
# which key produced it, so there is no way to find the rows still on the old secret
# without every plaintext PIN. To rotate: disable PIN login, set the new value, reissue
# every PIN, verify, reopen. Changing this value alone locks every employee out.
#
PIN_LOOKUP_SECRET="your-pin-lookup-secret-minimum-32-characters"

# ─── Database seeding (prisma/seed.ts) ────────────────────────────────────────
# The seed writes demo employees and a demo dataset. It is fail-closed:
#   • it requires a real PostgreSQL DATABASE_URL (no SQLite fallback),
#   • it refuses to run unless ERP_SEED_ENABLED is exactly "true",
#   • it refuses the Production and Demo endpoints by name.
# Each demo employee's PIN is supplied here as an explicit SIX-DIGIT value (Secure Version B:
# the seed stores bcrypt(verifier input) + the keyed lookup, never a raw PIN and never the
# legacy pinHash). No PIN is hard-coded in the repository. Demo/training only.
# ERP_SEED_ENABLED="true"
# SEED_PIN_ADMIN="123456"
# SEED_PIN_INVENTORY="234561"
# SEED_PIN_ROASTING="345612"
# SEED_PIN_QC="456123"
# SEED_PIN_DISPATCH="561234"

# ─── Destructive-reset authorization (admin/reset, admin/training-reset) ──────
# The destructive-reset endpoints refuse unless the running configuration explicitly names
# THIS host and database as a disposable target. Set only in disposable environments.
# ERP_TRAINING_RESET_ENABLED="true"
# ERP_RESET_ALLOWED_HOST="your-disposable-endpoint.example.neon.tech"
# ERP_RESET_ALLOWED_DATABASE="your_disposable_db"

# Optional: HMAC pepper for rate-limit key hashing.
# If unset, JWT_SECRET is used as the fallback pepper.
# Recommended for production: set a separate strong random value.
# RATE_LIMIT_SECRET=""

# ─── External APIs ────────────────────────────────────────────────────────────

# Optional: Google Cloud Translation API key used by POST /api/translate.
# If unset, the system falls back to the MyMemory translation service.
# WARNING: Enabling this may incur Google Cloud Translation API costs.
# TRANSLATION_API_KEY=""

  entityId   String
  before     Json?
  after      Json?
  reason     String?  @db.Text
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model CuppingSessionBatch {

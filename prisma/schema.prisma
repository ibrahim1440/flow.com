// ─── Inventory Ledger ─────────────────────────────────────────────────────────

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  LOSS
}

enum InventoryCategory {
  RAW_MATERIAL
  FINISHED_GOODS
  ROASTED_COFFEE // intermediate stock between roasting and packaging
  PACKAGING_MATERIAL // MaterialItem stock: bags, labels, cartons
}

enum SourceDocType {
  PURCHASE
  ROASTING_BATCH
  DELIVERY
  BLEND
  MANUAL_ADJUSTMENT
  PACKING
  BOM_CONSUMPTION // packaging drawing roasted coffee + materials per a SKU's BOM
  PRODUCTION_ORDER
  OPENING_BALANCE // the stock a new green bean / packaging material is created with (IN)
  RECEIVING // a packaging-material delivery received under inventory › receive (IN, audited)
  STOCK_TRANSFER // phase 3: a transfer between two locations (an OUT and an IN, same transfer id)
}

model InventoryMovement {
  id                String            @id @default(cuid())
  type              MovementType
  category          InventoryCategory
  referenceEntityId String?
  quantityChanged   Float
  previousQuantity  Float
  newQuantity       Float
  sourceDocType     SourceDocType
  sourceDocId       String?
  userId            String?
  timestamp         DateTime          @default(now())
  notes             String?

  /// Phase 3 (20261115090000_stock_locations): WHERE the movement happened. Default: the transaction's location
  /// (stock_location_current() — the hiqbah.stock_location setting, else the default site). A transfer's two rows
  /// name the other site as counterpartLocationId and carry the transfer's id; their previous / new quantities are
  /// that location's balance (every other movement keeps the company-wide total there, as before).
  locationId            String         @default(dbgenerated("stock_location_current()"))
  location              StockLocation  @relation("MovementLocation", fields: [locationId], references: [id])
  counterpartLocationId String?
  counterpartLocation   StockLocation? @relation("MovementCounterpart", fields: [counterpartLocationId], references: [id], onDelete: Restrict)
  transferId            String?
  transfer              StockTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([timestamp])
  @@index([category, timestamp])
  @@index([referenceEntityId])
  // 20261020100000_inventory_counts: the movements of one source document (a count session's
  // adjustments, a roast's draws) for the count review and the lot traceability page.
  @@index([sourceDocType, sourceDocId])
  @@index([locationId, timestamp])
  @@index([transferId])
}

// ─── Inventory count sessions (migration 20261020100000_inventory_counts) ─────
//
// A physical stock count of several items at once («الجرد والتسويات», Figma 278:4772): a
// session is started, counted quantities are entered line by line, the variances are reviewed,
// and the session is POSTED in one step. Posting books each non-zero variance through the
// existing adjustment service (src/lib/services/inventory-adjustment.ts) — an ADJUSTMENT
// movement with sourceDocType MANUAL_ADJUSTMENT and sourceDocId = the session id, the new
// balance and the INVENTORY_ADJUSTED person audit — so the ledger and the balances move exactly
// as a single-item count does. These two tables never hold stock: they are the count sheet.

enum InventoryCountStatus {
  OPEN // being counted; lines may be added, counted, removed
  POSTED // variances booked; read-only
  CANCELLED // abandoned; nothing booked; read-only
}

model InventoryCountSession {
  id     String               @id @default(cuid())
  /// Human reference («جرد #12»), a SERIAL.
  number Int                  @unique @default(autoincrement())
  status InventoryCountStatus @default(OPEN)
  title  String?
  notes  String?

  // Employee.id, denormalised (the InventoryMovement.userId convention): no FK.
  createdById   String?
  postedById    String?
  /// The reason given when posting (normalizeAdjustmentReason) — carried onto every movement.
  postReason    String?
  postedAt      DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines InventoryCountLine[]

  /// Phase 3: the location counted. Its lines' system quantities and the variances posted are that location's.
  locationId String        @default(dbgenerated("stock_location_current()"))
  location   StockLocation @relation(fields: [locationId], references: [id])

  @@index([status, createdAt])
  @@index([locationId])
}

model InventoryCountLine {
  id        String                @id @default(cuid())
  sessionId String
  session   InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  /// RAW_MATERIAL (GreenBean, kg) or PACKAGING_MATERIAL (MaterialItem, its unit). CHECK in SQL.
  category InventoryCategory
  /// GreenBean.id or MaterialItem.id (untyped, like InventoryMovement.referenceEntityId).
  entityId String

  /// The system balance when the counted quantity was entered (or when the line was added, until
  /// it is counted). The variance a count observes is countedQty − systemQty; posting applies
  /// that variance to the balance as it stands at posting time, so stock that moved between the
  /// count and the posting (a roast, a receipt) is not wiped out by the count.
  systemQty   Float
  countedQty  Float?
  countedAt   DateTime?
  countedById String?
  notes       String?

  // Filled when the session is posted (null for a zero variance: nothing booked).
  postedPreviousQty Float?
  postedNewQty      Float?
  postedVariance    Float?
  movementId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, category, entityId])
  @@index([category, entityId])
}

// ─── Finished Goods ───────────────────────────────────────────────────────────

enum LotStatus {
  AVAILABLE
  RESERVED
  SHIPPED

  /// A physical package that exists but is not a complete sellable unit — a 1 KG bag
  /// holding 250 g, for instance. It is real inventory: the coffee left the roast and the
  /// bag was used, and both are accounted for. It simply is not a sellable SKU yet.
  ///
  /// The status is what keeps it out of allocation. Every path that can promise or ship
  /// stock — availableUnitsBySku, reserveFinishedUnits, consumeFinishedUnits, the shelf
  /// allocator, fulfillment-options — already requires status = AVAILABLE, so a PARTIAL lot
  /// is invisible to all of them without a line of change in any of them. Topping the
  /// package up to its nominal weight flips it to AVAILABLE, and that is the only way it
  /// becomes sellable.
  PARTIAL
}

model FinishedGoodsLot {
  id              String         @id @default(cuid())
  productId       String
  product         CoffeeProduct  @relation(fields: [productId], references: [id])
  productSkuId    String?
  productSku      ProductSKU?    @relation(fields: [productSkuId], references: [id])
  batchNumber     String
  roastingBatchId String?        @unique
  roastingBatch   RoastingBatch? @relation(fields: [roastingBatchId], references: [id])
  quantityKg      Float
  availableQty    Float

  // ─── Shelf allocation ────────────────────────────────────────────────────
  // Kilograms already promised to an order item but not yet shipped. Denormalised
  // sum of the RESERVED StockAllocation rows pointing at this lot — kept on the lot
  // itself so "is there enough free stock" is answerable by a single conditional
  // UPDATE (availableQty - reservedQty >= n), the same atomic pattern the delivery
  // deduction already uses. Free-to-promise is always availableQty - reservedQty.
  reservedQty Float             @default(0)
  allocations StockAllocation[]

  status    LotStatus @default(AVAILABLE)
  createdAt DateTime  @default(now())

  // ─── Unit-native finished goods ──────────────────────────────────────────
  // For a SKU-tracked lot, UNITS are the single source of truth: kg-equivalent is
  // always derived as units x (ProductSKU.weightGrams / 1000), never stored twice.
  //
  // `isUnitTracked` is the discriminator, not a second opinion on the same balance.
  // A lot is EITHER unit-tracked (new packaging output; units* authoritative,
  // availableQty/reservedQty frozen at 0) OR legacy kg (rows produced before this
  // change; availableQty/reservedQty authoritative, units* stay 0). The legacy rows
  // cannot be converted honestly — 8.45 kg against a 1 KG SKU is not a whole number
  // of bags — so they keep serving the legacy bean-based order lines in kg and are
  // never rewritten.
  isUnitTracked  Boolean @default(false)
  unitsProduced  Int     @default(0)
  unitsAvailable Int     @default(0)
  unitsReserved  Int     @default(0)

  // Which roast this lot was packed from. Distinct from `roastingBatchId` above, and not
  // a duplicate of it: that column is 1:1 and UNIQUE — "this lot is that batch's entire
  // packaged output", the legacy shape where a batch became exactly one kg lot. One roast
  // can be packed into several SKUs (a 1 KG lot and a 250 g lot from the same batch), so
  // the unit-tracked path needs a MANY:1 link and cannot reuse a unique column.
  //
  // Unit-tracked lots set this and leave `roastingBatchId` null; legacy lots are the
  // reverse. Nothing sets both, so batch traceability is unambiguous either way.
  packedFromBatchId String?
  packedFromBatch   RoastingBatch? @relation("PackedFromBatch", fields: [packedFromBatchId], references: [id])

  packagingOperations PackagingOperation[]

  // ─── Actual fill, in whole grams ─────────────────────────────────────────
  // Integers, not Float. Packaging arithmetic decides whether a package is sellable, and
  // "is 0.1 + 0.2 === 0.3" is not a question inventory may depend on. Grams are the
  // smallest unit anyone weighs here, so an Int holds the exact figure and comparisons
  // against the nominal weight are exact. Float stays where it already is elsewhere in the
  // packaging domain; nothing here re-denominates existing columns.
  //
  // Both are null on legacy rows and on ordinary standard lots, where the SKU's nominal
  // weight times the unit count is the whole truth.

  /// What is physically inside the package(s) of this lot. For a PARTIAL lot this is the
  /// under-nominal fill; for a standard lot recorded through the unified workflow it is the
  /// real weight that went in, which may legitimately exceed nominal (1005 g in a 1 KG bag).
  actualContentGrams Int?

  /// The SKU's nominal net weight at the moment of packing, copied so a later change to
  /// master data cannot retroactively reclassify a package that was correct when it was made.
  nominalContentGrams Int?

  /// Whether the physical packaging materials for this lot have already been drawn. Set on
  /// first pack and never cleared: topping a partial package up consumes more coffee but not
  /// a second bag, and this flag is what makes that decision from data rather than from
  /// inference about the operation's shape.
  materialsConsumed Boolean @default(false)

  /// Where the coffee in this lot came from, in grams per contributing roast. A top-up may
  /// draw from a different batch than the original fill, so lineage cannot be a single
  /// column — packedFromBatchId still names the first roast, and this carries the full story.
  sources PackagingSource[]

  /// Deliveries that drew from this lot (Phase D; empty for dispatches before DeliveryLine).
  deliveryLines DeliveryLine[]

  /// Phase 3: where the lot is (the production site that packed it; a lot is not split across locations).
  locationId String        @default(dbgenerated("stock_location_current()"))
  location   StockLocation @relation(fields: [locationId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([productSkuId, status])
  @@index([isUnitTracked, status])
  @@index([packedFromBatchId])
  @@index([locationId])
}

/// One roast's contribution to one packaged lot.
///
/// Packaging used to be one roast in, one lot out, so a single column carried the lineage.
/// A partial package that is finished later from a second roast breaks that: the bag holds
/// coffee from two batches and both have to remain traceable, with the grams each supplied.
/// Rows are append-only — a correction adds a reversing packaging operation, it does not
/// rewrite where the coffee came from.
model PackagingSource {
  id String @id @default(cuid())

  finishedGoodsLotId String
  finishedGoodsLot   FinishedGoodsLot @relation(fields: [finishedGoodsLotId], references: [id], onDelete: Cascade)

  roastingBatchId String
  roastingBatch   RoastingBatch @relation("PackagingSourceBatch", fields: [roastingBatchId], references: [id], onDelete: Restrict)

  /// Whole grams this roast contributed. Integer for the same reason as the lot columns.
  gramsContributed Int

  /// The packaging operation that recorded this contribution, for audit join-up.
  packagingOperationId String?

  createdAt DateTime @default(now())

  @@index([finishedGoodsLotId])
  @@index([roastingBatchId])
  @@index([packagingOperationId])
}

enum AllocationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

// One order item may be covered by several lots, so the promise is a row per
// (order item, lot) pair rather than a column on either side. RESERVED rows are the
// detail behind FinishedGoodsLot.reservedQty; CONSUMED rows record what a delivery
// actually shipped; RELEASED rows are cancelled promises kept for audit.
model StockAllocation {
  id                 String           @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  finishedGoodsLotId String
  finishedGoodsLot   FinishedGoodsLot @relation(fields: [finishedGoodsLotId], references: [id])
  quantityKg         Float
  status             AllocationStatus @default(RESERVED)
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Whole sellable units reserved, for allocations against a unit-tracked lot.
  // Null on the legacy kg allocations (including the four written by the
  // 20260826120000 backfill), where quantityKg remains authoritative. Exactly one of
  // the two is meaningful per row, decided by the lot's isUnitTracked flag.
  quantityUnits Int?

  @@index([orderItemId, status])
  @@index([finishedGoodsLotId, status])
}

// ─── Product Catalog & Production Planning ────────────────────────────────────

enum PackagingMethod {
  KG // the legacy kilogram bag path — PUT /api/roasting-batches/[id]/package
  UNIT // the finished-SKU path      — POST /api/roasting-batches/[id]/pack-sku

  /// The unified workflow — POST /api/roasting-batches/[id]/pack.
  ///
  /// Not a third way of packaging: it is the only one an operator now sees. The two values
  /// above are retained because they label operations that were already recorded, and an
  /// audit row must keep saying what actually happened. New operations are always PACK.
  PACK
}

/**
 * One packaging SUBMIT, recorded so that a retry can be recognised instead of re-executed.
 * Packaging is not naturally idempotent and never can be. Packing a roast in several goes
 * is ordinary operational reality, so "the same request twice" and "two genuine partial
 * packs" are indistinguishable from the payload alone — the two are separated only by the
 * key the client chose. That is why identity lives here, on the operation, and not as a
 * single request key on RoastingBatch: one key per batch would make the second partial pack
 * look like a replay of the first.
 * Scoped to (batchId, requestKey) rather than requestKey alone. A key is meaningful only
 * against the batch it was submitted for; a global unique would make two unrelated roasts
 * collide if a client ever reused a key, and would turn a local mistake into a cross-batch
 * failure.
 * The row is written in the SAME transaction as the stock it describes, so a failed
 * packaging leaves no operation behind and the same key may legitimately be retried.
 */
model PackagingOperation {
  id String @id @default(cuid())

  // RESTRICT, deliberately. This table is the audit record of stock that physically moved,
  // so a cascade would erase the history at exactly the moment it matters most. The batch
  // DELETE route carries a matching domain guard that answers 409 before the database is
  // reached — the constraint is the backstop, not the user-facing behaviour.
  batchId String
  batch   RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  // Client-supplied idempotency key, or a server-generated one for callers that predate
  // the contract. A server-generated key gives the operation an audit identity but cannot
  // deduplicate a retry, because the retry would arrive without the original key.
  requestKey String

  // SHA-256 over the NORMALISED request intent, never over raw JSON text — property order
  // must not change the hash. Same key + different hash is a client error, not a replay.
  requestHash String

  method PackagingMethod

  // Kilograms for the KG path, whole units for the UNIT path. Float to match the rest of
  // the packaging domain (StockAllocation.quantityKg, FinishedGoodsLot.availableQty);
  // the Decimal columns in this schema belong to accounting.
  quantityKg    Float?
  quantityUnits Int?

  productSkuId String?
  productSku   ProductSKU? @relation(fields: [productSkuId], references: [id])

  finishedGoodsLotId String?
  finishedGoodsLot   FinishedGoodsLot? @relation(fields: [finishedGoodsLotId], references: [id])

  // The response the first execution returned, replayed verbatim to a retry.
  responseStatus Int
  responseJson   Json

  // Employee.id, denormalized — no FK relation (matches the InventoryMovement /
  // OrderActivity / WorkItemClaim audit-table convention).
  userId String?

  createdAt DateTime @default(now())

  @@unique([batchId, requestKey])
  @@index([batchId, createdAt])
}

enum ProductionOrderStatus {
  PENDING
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  ROASTED_COFFEE
  GREEN_COFFEE
  MERCHANDISE
  OTHER
}

enum UnitOfMeasure {
  UNIT // a discrete sellable pack (bag, box) — the default for finished SKUs
  KG
  GRAM
  PIECE
  /// Litre (café stock such as milk). Added by 20261112090000_item_categories.
  LITER
}

enum MaterialCategory {
  PACKAGING // bags, cartons
  LABEL // stickers, printed labels
  CONSUMABLE
  OTHER
}

// Stocked non-coffee inventory: the bags, labels and cartons a BOM consumes.
// Deliberately separate from GreenBean (coffee, kg-denominated) — these are counted
// in discrete pieces and are never roasted. PurchaseRecord.materialItemId links a
// PACKAGING purchase to the item it restocks, so buying bags can raise stock instead
// of only recording cost.
model MaterialItem {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  nameAr         String?
  category       MaterialCategory @default(PACKAGING)
  unitOfMeasure  UnitOfMeasure    @default(PIECE)
  quantityOnHand Float            @default(0)
  reorderPoint   Float            @default(0)
  isActive       Boolean          @default(true)
  notes          String?
  /// The shelf label's barcode payload (20261114090000_green_lot_labels): 'MT-00007', from a sequence.
  labelCode      String           @unique @default(dbgenerated("('MT-'::text || lpad((nextval('\"MaterialItem_labelCode_seq\"'::regclass))::text, 5, '0'::text))"))
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// The user-defined inventory category (20261112090000_item_categories). Nullable in the database for
  /// safety; the API requires it for new items and a trigger fills it from `category` when a writer omits
  /// it. `category` (the legacy enum) is kept in step with it by the same trigger: BOM, packaging, labels,
  /// receiving, counts and the cost ledger read the enum unchanged.
  categoryId   String?
  itemCategory ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  bomComponents BomComponent[]
  purchases     PurchaseRecord[]

  @@index([isActive])
  @@index([category, isActive])
  @@index([categoryId])
}

/// Unified inventory phase 3 — stock locations (20261115090000_stock_locations). WHERE stock is: a roasting plant, a
/// warehouse, a café, a branch. Owner-managed (inventory › adjust): added, renamed, reordered, made the default receiving
/// site, deactivated when a site closes (refused while it holds stock, and for the default — trigger
/// stock_location_guard) and reactivated. Exactly one default and one production site (partial unique indexes + a deferred check). Never deleted
/// once anything refers to it (every reference is RESTRICT). Seeded with «مصنع التحميص» (default), «المستودع», «المقهى».
model StockLocation {
  id                 String    @id @default(cuid())
  /// Short upper-case code (RST, WH, CAFE …), unique. CHECK ^[A-Z0-9][A-Z0-9-]{0,15}$.
  code               String    @unique
  nameAr             String
  nameEn             String?
  /// ROASTERY | WAREHOUSE | CAFE | BRANCH | OTHER (CHECK).
  type               String
  address            String?
  notes              String?
  isActive           Boolean   @default(true)
  isDefault          Boolean   @default(false)
  /// The production site (exactly one; seeded on the plant): roasting draws green there, packing draws materials and makes
  /// finished lots there, and a writer that names no site books there (stock_location_current()). Not deactivated.
  isProduction       Boolean   @default(false)
  sortOrder          Int       @default(0)
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  balances         StockBalance[]
  movements        InventoryMovement[]     @relation("MovementLocation")
  counterpartMoves InventoryMovement[]     @relation("MovementCounterpart")
  finishedLots     FinishedGoodsLot[]
  purchases        PurchaseRecord[]
  countSessions    InventoryCountSession[]
  deliveries       Delivery[]
  supplierInvoices SupplierInvoice[]
  transfersOut     StockTransfer[]         @relation("TransferFrom")
  transfersIn      StockTransfer[]         @relation("TransferTo")

  @@index([isActive, sortOrder])
}

/// The quantity of one green lot (GREEN_BEAN) or one material (MATERIAL) at one location. Σ over the locations = the
/// company-wide total ("GreenBean"."quantityKg" / "MaterialItem"."quantityOnHand"), kept so by ONE place in the
/// database: trigger stock_balance_sync routes every change of a total to the transaction's location (refusing what
/// that location cannot cover), and the deferred stock_balance_total_check refuses a commit where they differ.
model StockBalance {
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])
  /// GREEN_BEAN | MATERIAL (CHECK).
  itemKind   String
  /// GreenBean.id or MaterialItem.id (untyped, like InventoryMovement.referenceEntityId).
  entityId   String
  qty        Float         @default(0)
  updatedAt  DateTime      @default(now()) @updatedAt

  @@id([locationId, itemKind, entityId])
  @@index([itemKind, entityId])
}

/// «تحويل مخزون» — stock moved from one location to another. One step («تحويل فوري»): both balances move in one
/// transaction, an OUT and an IN movement per line sharing this id, and TRANSFER_OUT / TRANSFER_IN cost moves on the
/// item's one holder (same quantity and value, glState NONE: no journal entry — same company, same inventory account).
/// CANCELLED reverses them, only while the goods are still at the destination. Never deleted.
model StockTransfer {
  id              String        @id @default(cuid())
  /// «تحويل #12»
  number          Int           @unique @default(autoincrement())
  fromLocationId  String
  fromLocation    StockLocation @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId    String
  toLocation      StockLocation @relation("TransferTo", fields: [toLocationId], references: [id])
  transferDate    DateTime      @db.Date
  /// POSTED | CANCELLED (CHECK).
  status          String        @default("POSTED")
  notes           String?
  /// Client idempotency key: the same request twice returns the first transfer.
  requestKey      String?       @unique
  createdBy       String
  createdByName   String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelledByName String?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  lines     StockTransferLine[]
  movements InventoryMovement[]

  @@index([transferDate])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  lineNo     Int
  /// GREEN_BEAN | MATERIAL (CHECK).
  itemKind   String
  entityId   String
  qty        Float
  notes      String?

  @@unique([transferId, lineNo])
  @@index([itemKind, entityId])
}

/// Unified inventory — user-defined item categories (phase 1, 20261112090000_item_categories). At most two
/// levels: a root («المحمصة», «المقهى», «المنتجات الجاهزة») and its children (a DB trigger refuses a third).
/// A category says WHAT the stock is, never where it is (locations are a later phase).
///   template       — which form and which backing table an item uses: GREEN_COFFEE (GreenBean lots),
///                    ROASTED_COFFEE / FINISHED (view only: they come from roasting / packaging),
///                    PACKAGING / GENERAL (MaterialItem). A child created in the app inherits its root's.
///   inventoryRole  — the accounting posting role of its items (derived from the template; never picked by
///                    the user, never changed after creation). The cost ledger costs a material by it.
///   legacyMaterialCategory — the MaterialCategory enum its MaterialItems carry (kept for every existing
///                    consumer); a CHECK keeps it consistent with inventoryRole.
///   defaultUnit    — TEXT (UnitOfMeasure names) so the migration can seed LITER while adding that value.
model ItemCategory {
  id                     String            @id @default(cuid())
  nameAr                 String
  nameEn                 String?
  parentId               String?
  parent                 ItemCategory?     @relation("ItemCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children               ItemCategory[]    @relation("ItemCategoryTree")
  template               String
  defaultUnit            String            @default("PIECE")
  inventoryRole          String
  legacyMaterialCategory MaterialCategory?
  isSystem               Boolean           @default(false)
  isActive               Boolean           @default(true)
  archivedAt             DateTime?
  sortOrder              Int               @default(0)
  updatedByName          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  materials MaterialItem[]

  @@index([parentId, sortOrder])
}

enum BomComponentType {
  ROASTED_COFFEE // consumes kg from roasted/intermediate stock, identified by CoffeeProduct
  MATERIAL // consumes pieces from MaterialItem
}

// One line of a finished SKU's bill of materials, expressed PER SELLABLE UNIT.
//
// A ROASTED_COFFEE line points at a CoffeeProduct and is measured in kilograms — it
// draws on roasted/intermediate stock, never on GreenBean directly. Green coffee is
// consumed only by roasting; the chain is
//   GreenBean -> Roasting -> roasted stock -> Packaging (this BOM) -> FinishedGoodsLot.
// A MATERIAL line points at a MaterialItem and is measured in pieces.
//
// Exactly one of coffeeProductId / materialItemId is set; a CHECK constraint in the
// migration enforces that rather than leaving it to route code.
model BomComponent {
  id           String     @id @default(cuid())
  productSkuId String
  productSku   ProductSKU @relation(fields: [productSkuId], references: [id], onDelete: Cascade)

  type BomComponentType

  coffeeProductId String?
  coffeeProduct   CoffeeProduct? @relation(fields: [coffeeProductId], references: [id])
  materialItemId  String?
  materialItem    MaterialItem?  @relation(fields: [materialItemId], references: [id])

  quantityPerUnit Float // kg for ROASTED_COFFEE, pieces for MATERIAL
  unitOfMeasure   UnitOfMeasure
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([productSkuId])
  @@index([materialItemId])
  @@index([coffeeProductId])
}

// A ProductSKU is the sellable Finished Product: exactly one SKU per row
// ("Brazil Coffee – 1 KG" and "Brazil Coffee – 250g" are two rows). The coffee/origin
// it is made from is `product` (CoffeeProduct); the pack size is `weightGrams`.
// Sales orders reference ONLY this model — never a green bean, never a CoffeeProduct.
model ProductSKU {
  id                  String               @id @default(cuid())
  productId           String
  product             CoffeeProduct        @relation(fields: [productId], references: [id])
  skuCode             String               @unique
  weightGrams         Float // net weight of one sellable unit; master data for BOM/production maths
  isBulk              Boolean              @default(false)
  price               Float                @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orderItems          OrderItem[]
  finishedGoodsLots   FinishedGoodsLot[]
  productionOrders    ProductionOrder[]
  packagingOperations PackagingOperation[]

  // ─── Finished Products catalog (additive) ────────────────────────────────
  // Explicit display name. Nullable because the six pre-existing SKUs were created
  // before this field; the API falls back to "<product name> – <pack size>" when unset.
  name          String?
  nameAr        String?
  category      ProductCategory @default(ROASTED_COFFEE)
  unitOfMeasure UnitOfMeasure   @default(UNIT)
  isActive      Boolean         @default(true)
  // GTIN / EAN-13 or an internal code; optional, unique when set (D4). 20261020090000_product_catalog.
  barcode       String?         @unique

  // Bill of materials — what one unit of this SKU consumes.
  bomComponents BomComponent[]

  // Sales CRM (additive, relation fields only).
  quoteLines      QuoteLine[]
  sampleShipments SampleShipment[]

  @@index([isActive])
  @@index([category, isActive])
}

model ProductionOrder {
  id                  String                @id @default(cuid())
  productionNumber    String                @unique
  productSkuId        String
  productSku          ProductSKU            @relation(fields: [productSkuId], references: [id])
  targetUnits         Int
  targetWeightKg      Float
  expectedGreenBeanKg Float
  status              ProductionOrderStatus @default(PENDING)
  surplusHandled      Boolean               @default(false)
  sourceOrderItemId   String?
  sourceOrderItem     OrderItem?            @relation(fields: [sourceOrderItemId], references: [id])
  greenBeanId         String?
  greenBean           GreenBean?            @relation(fields: [greenBeanId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  roastingBatches     RoastingBatch[]
}

// ─── QC Correction History ────────────────────────────────────────────────────

model QcCorrectionHistory {
  id               String                    @id @default(cuid())
  qcRecordId       String
  qcRecord         QcRecord                  @relation(fields: [qcRecordId], references: [id], onDelete: Cascade)
  batchId          String
  correctionReason String
  changedById      String
  changedByName    String
  changedAt        DateTime                  @default(now())
  fieldChanges     QcCorrectionFieldChange[]

  @@index([qcRecordId])
  @@index([batchId])
  @@index([changedAt])
}

model QcCorrectionFieldChange {
  id           String              @id @default(cuid())
  correctionId String
  correction   QcCorrectionHistory @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  fieldName    String
  oldValue     String?
  newValue     String?

  @@index([correctionId])
}

// ─── Batch Serial History ─────────────────────────────────────────────────────

model BatchSerialHistory {
  id             String        @id @default(cuid())
  batchId        String
  batch          RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  greenBeanId    String?
  oldBatchNumber String
  newBatchNumber String
  reason         String
  changedById    String
  changedByName  String
  changedAt      DateTime      @default(now())

  @@index([batchId])
  @@index([oldBatchNumber])
}

// ─── Order Operations S0 — Activity Timeline ──────────────────────────────────
// Unified append-only timeline for both system-generated lifecycle events and
// manual operational notes on an Order. Deliberately one table, not one history
// table per event kind: every row shares the same shape and the UI renders them
// as a single chronological feed — `type` already covers query-time filtering.
//
// onDelete: Cascade on the Order relation matches the existing domain-history
// convention (QcCorrectionHistory -> QcRecord, BatchSerialHistory -> RoastingBatch,
// both Cascade above): activity history has no independent existence once its
// parent Order is gone. The existing Order.notes free-text field is untouched
// and continues to serve whatever it already serves; OrderActivity is additive.
//
// Future tenancy: tenant-owned transitively through Order (see docs/saas-readiness.md).
// No tenantId added now, per the standing SaaS-readiness constraint.
model OrderActivity {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type    String // ORDER_CREATED | ORDER_APPROVED | ORDER_REJECTED | PREPARATION_REVIEWED |
  // STATUS_CHANGED | MANUAL_NOTE | ORDER_HELD | ORDER_RESUMED | ORDER_CANCELLED | ORDER_COMPLETED
  message String @db.Text

  department String? // Sales, Online, Preparation, Production, Operations, Shipping — set only on MANUAL_NOTE
  authorId   String? // Employee.id, denormalized — no FK relation (matches WorkItemClaim/QcCorrectionHistory convention)
  authorName String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model LoginAttempt {
  id             String   @id @default(cuid())
  ipHash         String
  identifierHash String
  createdAt      DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([ipHash, identifierHash, createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
  @@index([createdAt])
}

// ─── Migration-history recovery ────────────────────────────────────────────
// The models below are owned by sibling repos (ERP-login, ERP-workstations) and were
// already applied directly to the shared demo database by those branches before this
// branch's migration history existed. Imported byte-identical to their source schemas
// (see ERP-login/prisma/schema.prisma and ERP-workstations/prisma/schema.prisma) purely
// so this branch's schema.prisma matches the live demo DB and `prisma migrate dev` does
// not propose dropping them. Not part of Accounting S0 — do not extend or modify here;
// changes belong in the owning repo.
//
// Exception (owner decision D10, Workstations W1, 22 Oct 2026): WorkItemClaim and
// WorkstationActionLog are ADOPTED by this repository as they are and are now written by the
// roasting station (/api/station/*). Their shape is unchanged; the June seed rows are left alone.

model AuthAuditLog {
  id               String   @id @default(cuid())
  userId           String?
  identifierHash   String?
  action           String
  result           String
  reasonCode       String?
  sourceInterface  String   @default("WEB")
  workspaceRouting String?
  ipHash           String
  userAgent        String?
  metadata         Json?
  occurredAt       DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([identifierHash, occurredAt])
  @@index([action, occurredAt])
  @@index([result, occurredAt])
}

// ─── Workstations W2: station devices, station PIN, station-scoped sessions ─────────────────────
// Migration 20261027090000_station_w2 (additive: new tables, nullable or defaulted columns).
// Figma UR-13 / UR-14 / UR-14b (page 596:2), WS-S1…S7 (page 630:2); PHASE7-DEVICES-BACKEND §3;
// CORE-INTERFACES-INVENTORY §H. Owner decisions D7, D11, D12 (22 Oct 2026).

/// A station: one place where a shared device works («محطة التحميص 1» · «صالة التحميص»). A device
/// grants nothing by itself; the employees assigned to its station sign in there with their own
/// station PIN. A roasting station names its roaster (Roaster id, no FK: the audit convention of
/// Roaster.defaultOperatorId; roasters are retired, never deleted). Retired, never deleted.
model Station {
  id            String                 @id @default(cuid())
  name          String
  /// ROASTING | QUALITY | PACKAGING
  type          String
  place         String?
  roasterId     String?
  /// ACTIVE | RETIRED
  status        String                 @default("ACTIVE")
  createdById   String?
  createdByName String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  devices       StationDevice[]
  assignments   StationAssignment[]
  deviceLinks   StationDeviceStation[]

  @@index([status])
}

/// A shared device registered to one station (UR-14). Registered by the administrator with the code
/// the device shows on S1 (deviceCode, «رمز هذا الجهاز»); activated on the device with a one-time
/// activation code (UR-14b: random, stored as a keyed hash, single use, ≤ 15 min, attempts counted).
/// Activation sets the httpOnly hq_station cookie, an opaque 32-byte random token stored only as
/// tokenHash. Revocation (REVOKED) ends every session on the device at its next request.
model StationDevice {
  id                  String                 @id @default(cuid())
  stationId           String
  station             Station                @relation(fields: [stationId], references: [id], onDelete: Restrict)
  displayName         String
  /// WS-XXXX, shown by the device on S1 before it is activated.
  deviceCode          String
  /// SHA-256 of the hq_station cookie token (never the token). NULL until activated.
  tokenHash           String?                @unique
  /// PENDING | ACTIVE | REVOKED
  status              String                 @default("PENDING")
  /// Keyed hash of the one-time activation code; cleared when used, cancelled or exhausted.
  activationCodeHash  String?
  activationExpiresAt DateTime?
  /// Wrong activation codes against this device's current code (the code is dropped at the limit).
  activationAttempts  Int                    @default(0)
  activatedAt         DateTime?
  lastSeenAt          DateTime?
  userAgent           String?
  registeredById      String?
  registeredByName    String?
  registeredAt        DateTime               @default(now())
  revokedAt           DateTime?
  revokedById         String?
  revokedByName       String?
  revokeReason        String?
  pinAttempts         StationPinAttempt[]
  extraStations       StationDeviceStation[]

  @@index([stationId, status])
  @@index([status])
}

/// UR-13: an employee may sign in at a station (the name appears on its S2 tiles). It decides WHERE
/// only; what the employee may do there comes from the module privileges (UR-S17). The supervisor
/// flag is a label only (owner decision O-5).
model StationAssignment {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  supervisor  Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([stationId, employeeId])
  @@index([employeeId])
}

/// The employee's own station PIN (J-6: set by the person, never seen or issued by the
/// administrator; UR-04 clears it). verifier = bcrypt(stationPinVerifierInput(pin)), a keyed HMAC in
/// its own domain. It is checked against the SELECTED employee only (J-2): not unique, no lookup.
model StationPin {
  employeeId String              @id
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  verifier   String
  setAt      DateTime            @default(now())
  attempts   StationPinAttempt[]
}

/// Failed station-PIN attempts per employee per device (D7). At the policy limit the PIN is locked
/// on that device (lockedAt) until the administrator re-enables it (UR-04); a success resets it.
model StationPinAttempt {
  employeeId      String
  stationPin      StationPin    @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  stationDeviceId String
  device          StationDevice @relation(fields: [stationDeviceId], references: [id], onDelete: Cascade)
  failedCount     Int           @default(0)
  lastFailedAt    DateTime?
  lockedAt        DateTime?

  @@id([employeeId, stationDeviceId])
  @@index([stationDeviceId])
}

/// The station policy (owner decision D7), one row. NULL = not set by the owner: the approved
/// defaults apply (idle 5 min, 5 PIN attempts, activation code 15 min).
model StationPolicy {
  id                String   @id @default("singleton")
  idleMinutes       Int?
  pinMaxAttempts    Int?
  activationMinutes Int?
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

/// Workstations W3: a device may serve more than its own station (the same iPad at the roaster and
/// in QC). The station is chosen on the device before the employee (S2), the session is bound to it,
/// and the bar always says which station and who. Registered by the administrator (step-up).
model StationDeviceStation {
  id              String        @id @default(cuid())
  stationDeviceId String
  device          StationDevice @relation(fields: [stationDeviceId], references: [id], onDelete: Cascade)
  stationId       String
  station         Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdById     String?
  createdByName   String?
  createdAt       DateTime      @default(now())

  @@unique([stationDeviceId, stationId])
  @@index([stationId])
}

model WorkItemClaim {
  id             String    @id @default(cuid())
  stationType    String // ROASTING | QUALITY | WAREHOUSE | PACKAGING | BAR
  itemType       String // e.g. "RoastingBatch" | "QcRecord" — polymorphic, like InventoryMovement.referenceEntityId
  itemId         String
  itemRef        String // `${itemType}:${itemId}`
  activeItemRef  String?   @unique // == itemRef while status="ACTIVE", null otherwise (enforces at most one active claim per item)
  claimedById    String // Employee.id, denormalized — no FK relation (audit-table convention)
  claimedByName  String
  status         String    @default("ACTIVE") // ACTIVE | RELEASED | EXPIRED | OVERRIDDEN
  claimedAt      DateTime  @default(now())
  expiresAt      DateTime?
  releasedAt     DateTime?
  releasedById   String?
  releasedByName String?

  @@index([stationType, status])
  @@index([itemType, itemId])
  @@index([itemRef])
  @@index([claimedById])
  @@index([claimedAt])
  @@index([status, expiresAt])
}

// ─── Workstations W4 · packaging & order preparation (additive) ─────────────────────────────────
// The preparation tab of the packaging station («تجهيز الطلبات», Figma P1–P7). Two records, neither
// of which moves stock: the stock leaves only when dispatch confirms the delivery in the ERP
// (POST /api/deliveries), exactly as before (owner decision D16).

/// One verified pick: units of one finished-goods lot, reserved for this exact order line, counted
/// at the station after the lot number was checked (W1: the last four characters only when they
/// match ONE lot reserved for the line, otherwise the full number). PICKED → HANDED_OFF (in a
/// DispatchHandoff) → DELIVERED (settled by POST /api/deliveries for that line, oldest first).
/// VOIDED: the line no longer needs it (cancelled order, released reservation). The lot is named
/// by id and number, without a foreign key (the audit-table convention: the record outlives it).
model PreparationPick {
  id                 String           @id @default(cuid())
  orderId            String
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  finishedGoodsLotId String
  batchNumber        String
  units              Int
  /// PICKED | HANDED_OFF | DELIVERED | VOIDED
  status             String           @default("PICKED")
  handoffId          String?
  handoff            DispatchHandoff? @relation(fields: [handoffId], references: [id], onDelete: SetNull)
  /// The station request that recorded it (Idempotency-Key); one request may draw from several
  /// lots that carry the same lot number.
  requestKey         String
  pickedById         String
  pickedByName       String
  stationId          String?
  createdAt          DateTime         @default(now())
  settledAt          DateTime?

  @@unique([requestKey, finishedGoodsLotId])
  @@index([orderItemId, status])
  @@index([orderId, status])
  @@index([handoffId])
}

/// «تسليم للشحن» (J-18): the order — or some of its lines — prepared, staged and handed to the
/// dispatch team. Per line, partial, idempotent (requestKey). It does NOT deliver: the ERP dispatch
/// page shows the order as handed off, with the staging place, and records the delivery.
model DispatchHandoff {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestKey     String                @unique
  /// Free text until a location model exists (J-16): «رف التسليم ب».
  stagingNote    String?
  /// Cartons / parcels staged.
  packages       Int?
  units          Int
  /// Some of the order's open units are not in this handoff.
  partial        Boolean               @default(false)
  preparedById   String
  preparedByName String
  stationId      String?
  createdAt      DateTime              @default(now())
  lines          DispatchHandoffLine[]
  picks          PreparationPick[]

  @@index([orderId, createdAt])
  @@index([createdAt])
}

/// One order line's share of a handoff: its units and the lots they were picked from.
model DispatchHandoffLine {
  id          String          @id @default(cuid())
  handoffId   String
  handoff     DispatchHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  units       Int
  /// [{ batchNumber, units, lotIds }] — per lot number printed on the box, the lot rows behind it
  lots        Json

  @@unique([handoffId, orderItemId])
  @@index([orderItemId])
}

model WorkstationActionLog {
  id              String   @id @default(cuid())
  stationType     String
  itemType        String
  itemId          String
  action          String // CLAIM | RELEASE | ADVANCE:<action> | FLAG
  fromState       String?
  toState         String?
  employeeId      String // Employee.id, denormalized — no FK relation
  employeeName    String
  idempotencyKey  String   @unique
  status          String // SUCCESS | REJECTED | ERROR
  reason          String?
  sourceInterface String   @default("STATION")
  createdAt       DateTime @default(now())

  @@index([stationType, createdAt])
  @@index([itemType, itemId])
  @@index([employeeId])
  @@index([status])
}

// ─── Accounting S0 Foundation ──────────────────────────────────────────────
// Single-tenant deployment. Accounting core A1 (20261102090000) adds tenantId (default "hiqbah", NOT NULL) to every
// accounting table; RLS is NOT enabled (docs/accounting/POSTING-CONTRACT.md §8 explains why).
// Money fields use Decimal (not Float) — debit=credit integrity cannot tolerate
// floating-point rounding error. This is a deliberate deviation from the Float
// convention used elsewhere in this schema, scoped only to these tables.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TaxCategoryType {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

enum FiscalPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum JournalEntryType {
  MANUAL
  AUTO
  REVERSAL
  ADJUSTMENT
  OPENING
  CLOSING
}

enum JournalEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REVERSED
}

enum AccountingEventStatus {
  PENDING
  TRANSLATED
  FAILED
}

enum QoyodExportStatus {
  NOT_EXPORTED
  READY_FOR_EXPORT
  EXPORTED
  EXPORT_FAILED
}

model AccountingSettings {
  // Singleton row, same pattern as SystemConfig — no Tenant model exists yet.
  id String @id @default("singleton")

  baseCurrency String @default("SAR")

  // Phase 2+ placeholders — stored now per spec, not enforced by any service logic in S0.
  costingMethod        String @default("WeightedAverage")
  cogsPolicy           String @default("OnShipping")
  branchAccountingMode String @default("CostCenterOnly")

  exportToQoyod Boolean @default(false)

  // Posting is blocked everywhere except setup routes while this is false. Must not
  // default to true — there is no setup wizard in S0, so setup is never complete by default.
  setupComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  // ── Accounting core A1 (20261102090000_accounting_core) ──
  /// Single tenant today; every accounting row carries the tenant so a later RLS switch-on is a policy, not a rewrite.
  tenantId         String    @default("hiqbah")
  /// The owner's activation. While false — and for any date before goLiveDate — the posting engine is a
  /// no-op that records nothing, so live operations are unaffected (src/lib/accounting/posting-engine.ts).
  accountingActive Boolean   @default(false)
  /// The first business day (Asia/Riyadh) the ledger is kept in the ERP; the opening entry is dated on it.
  goLiveDate       DateTime? @db.Date
  activatedAt      DateTime?
  activatedBy      String?
  /// «تهيئة دليل الحسابات»: when, by whom and from which template the chart was seeded (opt-in).
  coaSeededAt      DateTime?
  coaSeededBy      String?
  coaTemplate      String?
  /// The posted opening-balance entry (the wizard), once posted.
  openingEntryId   String?   @unique

  // ── Accounting A5 (20261106090000_accounting_reports): segregation of duties as a setting ──
  /// A manual journal may be approved by its own preparer (A2 credit / debit notes: issued by their preparer; A3
  /// supplier invoices: posted by their preparer / submitter). Each use is recorded (sodBypass) and listed in the
  /// SoD exceptions report. SIMPLE MODE (one owner) allows it whatever this says.
  sodAllowSelfApproval Boolean @default(true)
  /// The approver of a manual journal may also post it (else a third person posts). Listed in the report.
  sodApproverMayPost   Boolean @default(true)
}

model Account {
  id             String      @id @default(cuid())
  code           String      @unique
  nameAr         String?
  nameEn         String
  parentId       String?
  parent         Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]   @relation("AccountHierarchy")
  type           AccountType
  allowPosting   Boolean     @default(true)
  isActive       Boolean     @default(true)
  qoyodAccountId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?

  journalEntryLines JournalEntryLine[]
  hrAccountMaps     HrAccountMap[]

  // ── Accounting core A1 ──
  tenantId           String               @default("hiqbah")
  /// DEBIT | CREDIT. Inserted as 'AUTO' (the default) and resolved from the type by the database
  /// (ledger_account_guard): ASSET / EXPENSE → DEBIT, the others → CREDIT. Contra accounts set it explicitly.
  normalBalance      String               @default("AUTO")
  /// Sub-ledger control kind (AR, AP, INVENTORY, VAT_INPUT, VAT_OUTPUT, CASH, BANK, FIXED_ASSET, PAYROLL,
  /// COMMISSION, CLEARING) or null. AR / AP lines must name their party.
  controlType        String?
  /// Control accounts refuse MANUAL journals (they are fed by their sub-ledgers through the engine).
  allowManualJournal Boolean              @default(true)
  description        String?
  roles              AccountRole[]
  openingLines       OpeningBalanceLine[]
  /// Accounting A3: the expense categories of supplier bills that post here.
  expenseCategories  ExpenseCategory[]
  /// Accounting A5: the statement line (CURRENT_ASSET … ZAKAT, CHECK); NULL = inferred from the chart
  /// (src/lib/accounting/statements.ts → reportGroupOf).
  reportGroup        String?

  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@index([controlType])
}

model TaxCategory {
  id                   String          @id @default(cuid())
  code                 String          @unique
  nameAr               String?
  nameEn               String
  rate                 Decimal         @db.Decimal(5, 2)
  categoryType         TaxCategoryType @default(STANDARD)
  isDefault            Boolean         @default(false)
  isActive             Boolean         @default(true)
  requiresReason       Boolean         @default(false)
  requiresApproval     Boolean         @default(false)
  zatcaTaxCategoryCode String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdBy            String?
  updatedBy            String?

  // ── Unified inventory phase 2 (20261113090000_purchase_invoice_phase2): purchase VAT categories ──
  /// SALES | PURCHASES | BOTH (CHECK). The seeded purchase codes P-S15 … P-RC15 are PURCHASES.
  appliesTo            String                @default("BOTH")
  /// RECOVERABLE | NON_RECOVERABLE | NONE | IMPORT | REVERSE_CHARGE (CHECK); null for a sales-only category.
  inputVatTreatment    String?
  /// The purchases box of the VAT return: '7' | '8' | '9' | '10' | '11' (CHECK); null = not on the return.
  vatReturnBox         String?
  supplierInvoiceLines SupplierInvoiceLine[]

  @@index([isActive])
  @@index([categoryType])
}

model FiscalPeriod {
  id        String             @id @default(cuid())
  year      Int
  periodNo  Int
  startDate DateTime
  endDate   DateTime
  status    FiscalPeriodStatus @default(OPEN)
  lockedAt  DateTime?
  lockedBy  String?
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // ── Accounting core A1 ── LOCKED is the soft close («مقفلة مؤقتًا»); CLOSED is final until a
  // permissioned, reasoned reopen (ledger_period_guard: leaving CLOSED needs reopenReason/By/At).
  tenantId     String      @default("hiqbah")
  fiscalYearId String?
  fiscalYear   FiscalYear? @relation(fields: [fiscalYearId], references: [id])
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?
  reopenCount  Int         @default(0)

  journalEntries JournalEntry[]
  closeReviews   PeriodCloseReview[]

  @@unique([year, periodNo])
  @@index([fiscalYearId])
  @@index([status])
  @@index([startDate, endDate])
}

model JournalEntry {
  id               String             @id @default(cuid())
  entryNo          Int                @unique @default(autoincrement())
  entryDate        DateTime
  fiscalPeriodId   String
  fiscalPeriod     FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  type             JournalEntryType   @default(MANUAL)
  status           JournalEntryStatus @default(DRAFT)
  sourceModule     String             @default("manual")
  sourceDocumentId String?
  description      String?

  // Reversal link lives on the REVERSAL entry, pointing at the ORIGINAL it reverses.
  // @unique on reversesEntryId means Postgres allows many NULLs (non-reversal entries)
  // but at most one row may point at a given original — i.e. an entry can only ever
  // be reversed once. This is enforced at the DB level, not just in service code.
  reversesEntryId String?       @unique
  reversesEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversesEntryId], references: [id])
  reversedByEntry JournalEntry? @relation("JournalEntryReversal")

  totalDebit  Decimal @default(0) @db.Decimal(18, 2)
  totalCredit Decimal @default(0) @db.Decimal(18, 2)
  currency    String  @default("SAR")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  submittedAt DateTime?
  submittedBy String?
  approvedAt  DateTime?
  approvedBy  String?
  postedAt    DateTime?
  postedBy    String?

  // Set only on the reversal entry itself (explanation for why the original was reversed).
  reversalReason String?

  lines              JournalEntryLine[]
  accountingEvents   AccountingEvent[]
  qoyodExportRecords QoyodExportRecord[]
  hrLinks            HrJournalLink[]

  // ── Accounting core A1 (posting engine, src/lib/accounting/posting-engine.ts) ──
  tenantId       String    @default("hiqbah")
  /// The source document: e.g. SALES_INVOICE / <invoice id> / ISSUED. Every engine entry names it.
  sourceType     String?
  sourceId       String?
  sourceEvent    String?
  /// One entry per source event: unique per tenant (retries return the same entry).
  idempotencyKey String?
  /// sha256 of the normalised lines — a retry with different lines is refused (IDEMPOTENCY_CONFLICT).
  payloadHash    String?
  /// Gapless per tenant and year, assigned by the database when the entry becomes POSTED (JE-2026-000123).
  postingYear    Int?
  postingSeq     Int?
  reversedAt     DateTime?
  reversedBy     String?
  rejectedAt     DateTime?
  rejectedBy     String?
  rejectReason   String?
  /// SIMPLE MODE: the approver was also the preparer (logged; the four-eyes rule is bypassed, not removed).
  sodBypass      Boolean   @default(false)
  /// The rounding residue the engine posted to the ROUNDING role (null when none).
  roundingAmount Decimal?  @db.Decimal(18, 2)
  /// Optional supporting documents: [{ name, url }].
  attachments    Json?

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, postingYear, postingSeq])
  @@index([status])
  @@index([fiscalPeriodId])
  @@index([entryDate])
  @@index([sourceModule, sourceDocumentId])
  @@index([sourceType, sourceId])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])

  // DB-level CHECK constraint (added by hand to the migration SQL, same precedent as the
  // existing non-negative-quantity constraints) enforces: debit >= 0, credit >= 0, and
  // exactly one of the two is > 0 while the other is exactly 0. See migration SQL comment.
  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)

  description         String?
  taxCategorySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Accounting core A1: dimensions (all optional; no foreign keys — the ledger outlives a reset of
  // the operational records and is never rewritten; the engine validates them when it posts) ──
  tenantId     String  @default("hiqbah")
  lineNo       Int?
  branchId     String?
  costCenterId String?
  /// CUSTOMER | SUPPLIER | EMPLOYEE (with partyId) — the AR / AP / employee sub-ledger key.
  partyType    String?
  partyId      String?
  /// COFFEE_PRODUCT | PRODUCT_SKU | GREEN_BEAN | MATERIAL (with itemId).
  itemType     String?
  itemId       String?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([accountId, journalEntryId])
  @@index([partyType, partyId])
}

/// A Gregorian fiscal year and its twelve monthly periods (src/lib/accounting/fiscal-years.ts).
model FiscalYear {
  id             String         @id @default(cuid())
  tenantId       String         @default("hiqbah")
  year           Int
  startDate      DateTime
  endDate        DateTime
  /// OPEN | CLOSED (year-end close is A5).
  status         String         @default("OPEN")
  /// Accounting A5: the year-end close (P&L closed to retained earnings by the CLOSING entry).
  closedAt       DateTime?
  closedBy       String?
  closingEntryId String?
  createdAt      DateTime       @default(now())
  createdBy      String?
  updatedAt      DateTime       @updatedAt
  periods        FiscalPeriod[]

  @@unique([tenantId, year])
}

/// System posting roles → accounts. Later phases post ONLY by role (src/lib/accounting/roles.ts), never by
/// an account number. Changing a mapping is audited and never changes a posted entry.
model AccountRole {
  id        String   @id @default(cuid())
  tenantId  String   @default("hiqbah")
  role      String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([tenantId, role])
  @@index([accountId])
}

/// The accounting audit trail: who, when, what, before / after, IP and device. Written by the database
/// (ledger_audit_row) for every change of the chart, roles, years, periods, settings, journal entries and
/// the opening grid, with the actor and request context the application sets per transaction
/// (src/lib/accounting/audit.ts). Append-only.
model AccountingAuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @default("hiqbah")
  at         DateTime @default(now())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?

  @@index([entityType, entityId, at])
  @@index([at])
}

/// Gapless counters (UPDATE … RETURNING inside the posting transaction; never a sequence).
model AccountingCounter {
  tenantId String @default("hiqbah")
  scope    String
  year     Int
  value    Int    @default(0)

  @@id([tenantId, scope, year])
}

/// The opening-balance wizard's grid (a CSV import or manual entry), posted once as the OPENING entry at the
/// go-live date against the OPENING_BALANCE_EQUITY role. Frozen by the database once that entry exists.
model OpeningBalanceLine {
  id           String   @id @default(cuid())
  tenantId     String   @default("hiqbah")
  lineNo       Int
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit        Decimal  @default(0) @db.Decimal(18, 2)
  credit       Decimal  @default(0) @db.Decimal(18, 2)
  partyType    String?
  partyId      String?
  branchId     String?
  costCenterId String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@index([accountId])
}

model AccountingEvent {
  id               String @id @default(cuid())
  eventType        String
  sourceModule     String
  sourceDocumentId String
  sourceEventId    String

  // Dedicated idempotency key, built from sourceModule + sourceDocumentId + eventType +
  // sourceEventId (the source's own event/version id). A single source document can emit
  // many distinct events (e.g. multiple deliveries against one order) — keying only on
  // (sourceModule, sourceDocumentId, eventType) would incorrectly block valid repeats.
  idempotencyKey String @unique

  occurredAt     DateTime              @default(now())
  payload        Json
  status         AccountingEventStatus @default(PENDING)
  journalEntryId String?
  journalEntry   JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceModule, sourceDocumentId])
  @@index([status])
  @@index([eventType])
}

model QoyodExportRecord {
  id                String            @id @default(cuid())
  journalEntryId    String
  journalEntry      JournalEntry      @relation(fields: [journalEntryId], references: [id])
  externalExportKey String            @unique
  status            QoyodExportStatus @default(NOT_EXPORTED)
  payloadSnapshot   Json?
  responseSnapshot  Json?
  qoyodReferenceId  String?
  retryCount        Int               @default(0)
  errorMessage      String?
  exportedAt        DateTime?
  exportedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([journalEntryId])
}

// ═══════════════════════════════════════════════════════════════════════════════
//  SALES CRM & COMMISSIONS
//
//  Added whole, alongside the existing domain. Nothing above this line is altered:
//  every table here is new, so the build currently in production keeps working
//  against this schema unchanged.
//
//  Two conventions inherited deliberately from the existing schema:
//    • money is Decimal(18,2), never Float — the same rule the accounting models
//      state explicitly, and for the same reason;
//    • state is a stable CODE, never a translated label, so an Arabic UI cannot
//      change what a row means.
// ═══════════════════════════════════════════════════════════════════════════════

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

/// How a lead reached us. Extended by configuration, not by code.
enum LeadSource {
  WALK_IN
  REFERRAL
  PHONE
  SOCIAL
  EXHIBITION
  WEBSITE
  OTHER
}

model Lead {
  id            String     @id @default(cuid())
  /// Business name. The person is a contact ON this lead, because a café has many
  /// people and none of them is the customer.
  companyName   String
  companyNameAr String?
  contactName   String
  phone         String?
  email         String?
  city          String?
  address       String?
  source        LeadSource @default(OTHER)
  sourceNote    String?
  status        LeadStatus @default(NEW)

  /// Who is responsible. Ownership is the scoping key for every read and write.
  ownerId String
  owner   Employee @relation("LeadOwner", fields: [ownerId], references: [id])

  /// The next commitment. A lead with no next step is the thing this screen exists
  /// to make visible, so it is a first-class column rather than a derived guess.
  nextFollowUpAt DateTime?

  notes String?

  /// Normalised duplicate-detection keys. Written by the service, never by a client.
  /// Deliberately NOT unique: two genuine contacts can share a company, and merging
  /// on name similarity alone is how real customers get destroyed.
  normalizedCompany String?
  normalizedPhone   String?

  conversion LeadConversion?
  activities Activity[]

  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// «مساحة عملي» (additive, 20261108090000_my_workspace): relation fields only.
  workTasks        WorkTask[]        @relation("WorkTaskLead")
  workAppointments WorkAppointment[] @relation("WorkAppointmentLead")

  @@index([ownerId, status])
  @@index([status, nextFollowUpAt])
  @@index([normalizedCompany])
  @@index([normalizedPhone])
}

/// The proof that a lead became a customer and an opportunity.
///
/// Unique on leadId: converting twice is impossible, which is what makes a
/// double-clicked button harmless. Every conversion metric is computed from these
/// rows — never from counting leads and opportunities in a period and dividing,
/// which measures nothing when the two sets are unrelated.
model LeadConversion {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  /// True when this conversion created the customer rather than linking an existing one.
  customerCreated Boolean @default(false)

  convertedById String?
  convertedAt   DateTime @default(now())

  @@index([customerId])
  @@index([convertedAt])
}

/// A configurable pipeline column. Terminal outcomes are NOT stages — see Opportunity.
/// What a stage MEANS to the automation, as distinct from what it is called.
///
/// The lifecycle has to know which column a newly-qualified lead lands in and which one an
/// issued quotation moves a deal to. Matching on the label is the obvious way and the wrong
/// one: the labels are translated, editable and, in this deployment, actually read
/// "Qualifying" and "Proposal". Matching on position is no better — inserting a stage
/// silently redirects the automation.
///
/// So the meaning is configured, once, by whoever configures the stages. A stage with no
/// purpose is an ordinary stage; NEW deliberately has no entry here because nothing
/// automatic puts a deal there.
enum PipelineStagePurpose {
  QUALIFICATION
  QUOTATION
}

model PipelineStage {
  id          String                @id @default(cuid())
  /// Stable identity. The label may be translated; this may not change.
  code        String                @unique
  nameEn      String
  nameAr      String
  position    Int
  /// Default probability offered when a deal enters this stage. Advisory only.
  probability Int                   @default(0)
  /// At most one stage may hold each purpose — the unique index is what stops two columns
  /// both claiming to be where quotations land.
  purpose     PipelineStagePurpose? @unique
  isActive    Boolean               @default(true)

  opportunities Opportunity[]
  stageEvents   OpportunityStageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// Terminal result. Separate from stage on purpose: a deal is either still moving
/// through the pipeline, or it is finished. Collapsing the two into one enum is how
/// "Won" ends up being draggable back into "Negotiation".
enum OpportunityOutcome {
  OPEN
  WON
  LOST
}

model Opportunity {
  id         String    @id @default(cuid())
  title      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])

  outcome    OpportunityOutcome @default(OPEN)
  /// Required by the service whenever outcome becomes LOST.
  lostReason String?
  closedAt   DateTime?

  /// Expected value. Currency is explicit so a future multi-currency policy has
  /// somewhere to land; the commission engine refuses anything but SAR today.
  amount          Decimal   @default(0) @db.Decimal(18, 2)
  currency        String    @default("SAR")
  probability     Int       @default(0)
  expectedCloseAt DateTime?
  nextFollowUpAt  DateTime?

  ownerId String
  owner   Employee @relation("OpportunityOwner", fields: [ownerId], references: [id])

  conversion  LeadConversion?
  owners      OpportunityOwner[]
  stageEvents OpportunityStageEvent[]
  quotes      Quote[]
  samples     SampleShipment[]
  activities  Activity[]
  orderLinks  OpportunityOrder[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salesCollections SalesCollection[]
  /// «مساحة عملي» (additive, 20261108090000_my_workspace): relation fields only.
  workTasks        WorkTask[]        @relation("WorkTaskOpportunity")
  workAppointments WorkAppointment[] @relation("WorkAppointmentOpportunity")

  @@index([ownerId, outcome])
  @@index([stageId, outcome])
  @@index([outcome, closedAt])
  @@index([nextFollowUpAt])
}

/// Split attribution. Percentages are stored, not inferred, and the service requires
/// them to total 100 when any split exists.
///
/// Historical accruals are never re-pointed when ownership changes: a new split takes
/// effect from its own effectiveFrom, and what was already earned stays earned.
model OpportunityOwner {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation("OpportunitySplitOwner", fields: [employeeId], references: [id])
  /// 0–100, two decimals. 60.00 means sixty percent.
  sharePercent  Decimal     @db.Decimal(5, 2)
  effectiveFrom DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, employeeId])
  @@index([employeeId])
}

/// Every stage move, owner change and value change, kept for the pipeline-duration
/// report and for answering "who moved this and when".
model OpportunityStageEvent {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fromStageId String?
  toStageId   String?
  toStage     PipelineStage? @relation(fields: [toStageId], references: [id])

  fromOutcome OpportunityOutcome?
  toOutcome   OpportunityOutcome?

  reason    String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([opportunityId, createdAt])
}

enum SampleStatus {
  PREPARING
  SENT
  FEEDBACK_RECEIVED
  CANCELLED
}

/// Sample tracking. Records what was promised and what came back.
///
/// Deliberately does NOT move stock: the roastery has a packaging and inventory
/// path with its own guards, and a CRM screen must not become a second way to
/// decrement a shelf.
model SampleShipment {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  productSkuId String?
  productSku   ProductSKU? @relation(fields: [productSkuId], references: [id])
  description  String?
  quantity     Decimal     @default(0) @db.Decimal(12, 3)
  unit         String      @default("KG")

  status        SampleStatus @default(PREPARING)
  sentAt        DateTime?
  feedbackAt    DateTime?
  feedbackScore Int?
  feedbackNotes String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([opportunityId, status])
}

enum ActivityType {
  CALL
  VISIT
  MEETING
  NOTE
  TASK
  SAMPLE_FOLLOW_UP
}

/// WHAT HAPPENED in a recorded interaction, as distinct from what KIND it was.
///
/// The type says a call was made; only this says whether anybody answered. That
/// difference decides whether a prospect has become active selling work, so it is a
/// stored value the server reads — not a phrase somebody typed into a note.
///
/// The five outcomes that qualify a lead are the ones that cannot happen without the
/// customer having engaged: interest confirmed, an appointment agreed, or an appointment
/// held. NOTE_ONLY and FOLLOW_UP_REQUIRED deliberately do not, and neither does a TASK —
/// an internal reminder to call someone next Tuesday is not the customer agreeing to
/// anything, and treating it as one fills the pipeline with deals nobody is working.
enum ActivityOutcome {
  NO_ANSWER
  LEFT_MESSAGE
  INTERESTED
  MEETING_SCHEDULED
  VISIT_SCHEDULED
  MEETING_COMPLETED
  VISIT_COMPLETED
  FOLLOW_UP_REQUIRED
  NOT_INTERESTED
  NOTE_ONLY
}

/// A call, visit, note or task. Attaches to a lead or an opportunity, and survives
/// conversion: the lead's history stays readable after it becomes a customer.
///
/// Recording that contact happened is NOT sending a message. Nothing here dispatches
/// email, SMS or WhatsApp, and no screen implies it does.
model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String
  body    String?

  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])

  /// Nullable: every activity written before this existed has no recorded outcome, and
  /// inventing one for them would be a claim about conversations nobody witnessed.
  outcome ActivityOutcome?

  dueAt       DateTime?
  completedAt DateTime?

  ownerId String
  owner   Employee @relation("ActivityOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, completedAt, dueAt])
  @@index([leadId])
  @@index([opportunityId])
  /// Customer account timeline (additive, migration 20261019120000_customer_account).
  @@index([customerId])
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model Quote {
  id           String  @id @default(cuid())
  /// Human reference, unique per revision chain.
  quoteNumber  String  @unique
  revision     Int     @default(1)
  /// Points at the quote this one revises, so a chain is walkable in both directions.
  supersedesId String? @unique
  supersedes   Quote?  @relation("QuoteRevision", fields: [supersedesId], references: [id])
  supersededBy Quote?  @relation("QuoteRevision")

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  status     QuoteStatus @default(DRAFT)
  currency   String      @default("SAR")
  validUntil DateTime?

  /// Totals computed on the server from the lines. Stored so an issued quote is a
  /// fixed document: recomputing it later from live prices would change history.
  subtotal      Decimal @default(0) @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal @default(0) @db.Decimal(18, 2)

  /// Frozen copy of the lines and prices at the moment of issue.
  issuedSnapshot Json?
  issuedAt       DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?

  /// Set when a discount above the configured threshold was authorised.
  discountApprovedById String?
  discountApprovedAt   DateTime?

  // ─── Quotations batch (additive, migration 20261021090000_sales_quotes) ───────────────
  /// The effective discount (percent) the approval above covered. An approval given on a draft
  /// is cleared whenever the lines are saved with different figures, so it never covers a
  /// discount nobody approved.
  discountApprovedPercent Decimal?  @db.Decimal(9, 6)
  /// A refused discount request on a draft: who, when and why. Cleared when the lines change.
  discountRejectedById    String?
  discountRejectedAt      DateTime?
  discountRejectionNote   String?
  /// Notes to the customer, printed on the quotation document (Figma 1230:121651). They change
  /// no amount or tax. Editable on a draft only; frozen into the snapshot at issue.
  customerNotes           String?

  lines      QuoteLine[]
  orderLinks OpportunityOrder[]

  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salesCollections SalesCollection[]

  @@index([opportunityId, status])
  @@index([customerId])
  @@index([status, createdAt])
}

/// Append-only record of the quotation decisions and settings that matter for control:
/// DISCOUNT_APPROVED / DISCOUNT_REJECTED on a quotation, and QUOTE_SETTINGS_UPDATED (the
/// discount threshold and the seller block). No foreign keys on purpose (audit convention): a
/// discarded draft keeps its trail. Written by the application only; never updated or deleted.
model SalesQuoteAudit {
  id          String   @id @default(cuid())
  action      String
  quoteId     String?
  quoteNumber String?
  actorId     String?
  actorName   String?
  /// The figures the decision was taken on (effective discount, threshold, totals, note) or the
  /// settings before / after.
  details     Json?
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([action, createdAt])
}

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productSkuId String?
  productSku   ProductSKU? @relation(fields: [productSkuId], references: [id])
  /// Free-text description for a line with no catalogue SKU (a bespoke blend, a service).
  description  String?

  /// Decimal(12,3) carries kilogram fractions honestly. Whether fractions are ALLOWED
  /// is a product question the service asks the SKU, not something the column decides:
  /// 1.5 kg of beans is ordinary, 1.5 retail bags is not.
  quantity Decimal @db.Decimal(12, 3)
  unit     String  @default("KG")

  unitPrice       Decimal @db.Decimal(18, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @db.Decimal(5, 2)

  lineSubtotal Decimal @default(0) @db.Decimal(18, 2)
  lineTax      Decimal @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal @default(0) @db.Decimal(18, 2)

  position Int @default(0)

  @@index([quoteId, position])
}

/// The bridge from a won deal to the order system.
///
/// Unique on (quoteId, orderId) plus a unique requestKey: converting the same accepted
/// quote twice returns the first order instead of creating a second. One deal may
/// legitimately produce several orders over time — repeat business is not a defect —
/// so this is a many-to-many link rather than a column on Opportunity.
model OpportunityOrder {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  quoteId       String?
  quote         Quote?      @relation(fields: [quoteId], references: [id])
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Distinguishes the first order won from the repeat orders that follow it, which
  /// the attribution policy may treat differently.
  isFirstOrder Boolean @default(false)
  requestKey   String  @unique

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([quoteId, orderId])
  @@index([opportunityId])
  @@index([orderId])
}

// ─── Commissions ───────────────────────────────────────────────────────────────

enum CommissionBasis {
  /// Net collected cash, excluding tax, refunds and non-qualifying lines.
  NET_COLLECTION
}

enum CommissionTierMode {
  /// Each tier's rate applies only to the portion of base inside that tier's band.
  INCREMENTAL
  /// The highest reached tier's rate applies to the whole base.
  /// Declared so the concept is nameable; REFUSED at validation in this version
  /// rather than half-implemented. See COMMISSION_RULES.md.
  RETROACTIVE
}

model CommissionPlan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  nameAr      String?
  description String?
  isActive    Boolean @default(true)
  /// The ready-made template («قالب جاهز») the plan was created from, e.g. HIQBAH_CURRENT.
  /// Informational only; the plan's rules are its versions. Null for hand-built plans.
  templateKey String?

  versions    CommissionPlanVersion[]
  assignments CommissionAssignment[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A plan is versioned, and a version is immutable once anything has accrued against
/// it. Editing a live rule in place would silently restate commissions people have
/// already been told they earned.
model CommissionPlanVersion {
  id      String         @id @default(cuid())
  planId  String
  plan    CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version Int

  basis           CommissionBasis    @default(NET_COLLECTION)
  tierMode        CommissionTierMode @default(INCREMENTAL)
  /// The flat rate applied when no tier matches, as a percentage: 1.500000 = 1.5%.
  baseRatePercent Decimal            @db.Decimal(9, 6)
  currency        String             @default("SAR")

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// Commission plan builder (additive, 20261101090000_commission_builder). NULL = a TIERED
  /// version (baseRatePercent + tiers), exactly as before. An object = a COMPONENTS version:
  /// order-sequence commission on new clients, target-achievement bonus brackets and the
  /// marginal over-target incentive (lib/services/commissions/builder.ts parses and validates
  /// it; baseRatePercent is 0 and there are no tiers). Immutable like the rest of the version.
  components Json?

  tiers          CommissionTier[]
  assignments    CommissionAssignment[]
  accruals       CommissionAccrual[]
  periodResults  CommissionPeriodResult[]
  bonusDecisions CommissionBonusDecision[]

  ledgerEntries CommissionLedgerEntry[]
  createdById   String?
  createdAt     DateTime                @default(now())

  @@unique([planId, version])
  @@index([effectiveFrom])
}

/// One band. `fromAmount` inclusive, `toAmount` exclusive; a null `toAmount` is "and above".
model CommissionTier {
  id            String                @id @default(cuid())
  planVersionId String
  planVersion   CommissionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  fromAmount    Decimal               @db.Decimal(18, 2)
  toAmount      Decimal?              @db.Decimal(18, 2)
  /// Added to the base rate for the portion inside this band, in percentage points:
  /// 0.500000 means "half a point more on this slice".
  ratePercent   Decimal               @db.Decimal(9, 6)
  position      Int                   @default(0)

  @@index([planVersionId, position])
}

model CommissionAssignment {
  id            String                @id @default(cuid())
  employeeId    String
  employee      Employee              @relation("CommissionAssignee", fields: [employeeId], references: [id])
  planId        String
  plan          CommissionPlan        @relation(fields: [planId], references: [id])
  planVersionId String
  planVersion   CommissionPlanVersion @relation(fields: [planVersionId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([employeeId, effectiveFrom])
}

enum CollectionEventStatus {
  RECORDED
  REVERSED
}

/// SANDBOX COLLECTION SOURCE.
///
/// This system has no invoice, payment or receivables model — checked, not assumed.
/// Commission is owed on money actually collected, so rather than invent a receivables
/// ledger inside a CRM task, collection is an ADAPTER and this table is its one
/// implementation: events entered through a clearly-labelled testing surface.
///
/// `sourceSystem` is stored on every row so a real integration can be added later and
/// told apart from sandbox data without guessing. The UI states that the source is a
/// sandbox; nothing here is described as a working financial integration.
model CollectionEvent {
  id           String                @id @default(cuid())
  sourceSystem String                @default("SANDBOX")
  /// The source's own identifier, so a re-delivered webhook is recognised, not re-accrued.
  externalRef  String
  status       CollectionEventStatus @default(RECORDED)

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  opportunityId String?
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])

  /// Gross cash received, and the split that makes the qualifying base computable.
  amountGross         Decimal @db.Decimal(18, 2)
  amountTax           Decimal @default(0) @db.Decimal(18, 2)
  /// Portion of the net that does not qualify (excluded products, freight, …).
  amountNonQualifying Decimal @default(0) @db.Decimal(18, 2)
  currency            String  @default("SAR")

  collectedAt  DateTime
  reversedAt   DateTime?
  reversalOfId String?
  note         String?

  accruals CommissionAccrual[]

  ledgerEntries   CommissionLedgerEntry[]
  /// The finance-verified receipt that produced this event, when one did. Sandbox events
  /// have none, which is how the two sources stay tellable apart.
  salesCollection SalesCollection?        @relation("CollectionCommissionEvent")

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([sourceSystem, externalRef])
  @@index([customerId, collectedAt])
  @@index([collectedAt])
}

enum AccrualStatus {
  PREVIEW
  ACCRUED
  APPROVED
  PAID
  REVERSED
}

/// What one employee earned from one collection event under one plan version.
///
/// Unique on (collectionEventId, employeeId, planVersionId): a re-delivered collection
/// event cannot accrue a second time for the same person on the same rules. Corrections
/// are new rows, never edits to an approved one.
model CommissionAccrual {
  id                String          @id @default(cuid())
  collectionEventId String
  collectionEvent   CollectionEvent @relation(fields: [collectionEventId], references: [id], onDelete: Restrict)

  employeeId    String
  employee      Employee              @relation("CommissionEarner", fields: [employeeId], references: [id])
  planVersionId String
  planVersion   CommissionPlanVersion @relation(fields: [planVersionId], references: [id])

  /// Period the accrual belongs to, as an Asia/Riyadh month, stored as the UTC instant
  /// of that month's first moment in Riyadh.
  periodStart DateTime
  periodEnd   DateTime

  /// The qualifying base this row was computed from, and the share applied to it.
  qualifyingBase       Decimal @db.Decimal(18, 2)
  sharePercent         Decimal @default(100) @db.Decimal(5, 2)
  /// Effective rate actually applied, after tiers — recorded so the figure can be
  /// explained to the person who earned it without recomputing anything.
  effectiveRatePercent Decimal @db.Decimal(9, 6)
  amount               Decimal @db.Decimal(18, 2)
  currency             String  @default("SAR")

  status       AccrualStatus @default(ACCRUED)
  approvedById String?
  approvedAt   DateTime?

  ledgerEntries CommissionLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collectionEventId, employeeId, planVersionId])
  @@index([employeeId, periodStart])
  @@index([status, periodStart])
}

enum LedgerEntryType {
  ACCRUAL
  ADJUSTMENT
  REVERSAL
  PAYOUT
}

/// Append-only commission ledger. An approved figure is never rewritten; a correction
/// is a new entry that references what it corrects and says who made it and why.
model CommissionLedgerEntry {
  id         String          @id @default(cuid())
  type       LedgerEntryType
  employeeId String
  employee   Employee        @relation("CommissionLedgerOwner", fields: [employeeId], references: [id])

  accrualId  String?
  accrual    CommissionAccrual? @relation(fields: [accrualId], references: [id], onDelete: Restrict)
  /// A single entry this one corrects. Kept for the manual `adjust` path, which targets at
  /// most one. Engine reversals use `corrects` below, because one negative movement can
  /// compensate several earlier ones once tiers or splits are involved.
  correctsId String?

  periodStart DateTime
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("SAR")
  reason      String?

  /// ── Durable provenance ───────────────────────────────────────────────────────────
  /// These three are `Restrict`, matching `CommissionAccrual.collectionEvent`: a record a
  /// movement was computed from cannot be deleted while the movement refers to it. The
  /// Prisma default for an optional relation is SET NULL, which would quietly erase the
  /// provenance instead of refusing — demonstrated by a test cleanup that deleted events
  /// and left movements carrying a base and a plan version but no source.
  ///
  /// Written once, at the moment of the movement, and never updated. The accrual row is a
  /// mutable projection of what an event currently contributes; these fields are the
  /// immutable record of what was actually awarded when the money moved, so a later
  /// recomputation cannot restate history. Null on entries written before this existed and
  /// on manual adjustments, which have no engine computation behind them.
  collectionEventId    String?
  collectionEvent      CollectionEvent?       @relation(fields: [collectionEventId], references: [id], onDelete: Restrict)
  planVersionId        String?
  planVersion          CommissionPlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  /// The share of this event's qualifying base that this movement was computed on.
  qualifyingBase       Decimal?               @db.Decimal(18, 2)
  sharePercent         Decimal?               @db.Decimal(5, 2)
  /// The period's effective rate at the time — which is why a tiered month's marginal
  /// amount is not simply base x headline rate.
  effectiveRatePercent Decimal?               @db.Decimal(9, 6)

  /// What this movement compensates, and by how much of itself. A partial reversal, a
  /// split across two earners, or a tier change that reaches back over several earlier
  /// movements all produce more than one row here.
  corrects    CommissionLedgerCorrection[] @relation("CorrectingEntry")
  correctedBy CommissionLedgerCorrection[] @relation("CorrectedEntry")

  actorId   String?
  createdAt DateTime @default(now())

  @@index([employeeId, periodStart])
  @@index([type, createdAt])
  @@index([collectionEventId])
  @@index([accrualId])
}

/// Which earlier movement a negative movement compensates, and by how much.
///
/// A join table rather than a second nullable column because the relationship is genuinely
/// many-to-many in amount: reversing one collection in a tiered month lowers the period's
/// effective rate, so the single negative delta pays back part of its own event's movement
/// AND part of movements belonging to other events. Recording one `correctsId` would have
/// to pick one of them and silently drop the rest.
///
/// Allocation is decided at write time from the append-only log, never reconstructed later
/// by matching amounts or timestamps.
model CommissionLedgerCorrection {
  id String @id @default(cuid())

  /// The negative movement doing the compensating.
  entryId String
  entry   CommissionLedgerEntry @relation("CorrectingEntry", fields: [entryId], references: [id], onDelete: Cascade)

  /// The earlier movement being compensated.
  correctsEntryId String
  corrects        CommissionLedgerEntry @relation("CorrectedEntry", fields: [correctsEntryId], references: [id], onDelete: Restrict)

  /// A positive figure: how much of `entry` is applied against `corrects`. The rows for one
  /// entry sum to at most the absolute value of that entry's amount.
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([entryId, correctsEntryId])
  @@index([correctsEntryId])
}

/// The monthly result of a COMPONENTS plan for one employee: A (order-sequence commission on new
/// clients), B (target-achievement bonus), C (marginal over-target incentive), the achievement and
/// the differences from target. A PROJECTION, rewritten by every recomputation of the period (a
/// collection approved or reversed, the monthly run, a management decision); the append-only
/// ledger stays the authority on what is owed, and each recomputation posts its difference there.
/// Additive, 20261101090000_commission_builder.
model CommissionPeriodResult {
  id            String                @id @default(cuid())
  employeeId    String
  employee      Employee              @relation("CommissionPeriodResultOwner", fields: [employeeId], references: [id], onDelete: Restrict)
  periodStart   DateTime
  periodEnd     DateTime
  planVersionId String
  planVersion   CommissionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  currency      String                @default("SAR")

  /// The month's target (SalesTarget), null when none is set.
  targetAmount       Decimal? @db.Decimal(18, 2)
  /// Collected base counted toward the target (the plan's achievement base).
  qualifiedBase      Decimal  @db.Decimal(18, 2)
  /// Every collected base of the month with this employee's share, new clients or not.
  collectedBase      Decimal  @db.Decimal(18, 2)
  achievementPercent Decimal? @db.Decimal(12, 6)
  diffAmount         Decimal? @db.Decimal(18, 2)
  diffPercent        Decimal? @db.Decimal(12, 6)

  clientCommission    Decimal @db.Decimal(18, 2)
  targetBonus         Decimal @db.Decimal(18, 2)
  overTargetIncentive Decimal @db.Decimal(18, 2)
  totalVariable       Decimal @db.Decimal(18, 2)

  /// The bonus bracket reached (index into the version's brackets), its kind, and whether a
  /// management decision is required (DISCRETIONARY) / recorded.
  bracketIndex   Int?
  bracketKind    String?
  decisionStatus String  @default("NONE")
  /// Per-row and per-collection detail, for the screens (rates, sequence, client status).
  breakdown      Json

  computedAt   DateTime @default(now())
  computedById String?

  @@unique([employeeId, periodStart])
  @@index([periodStart])
  @@index([planVersionId])
}

/// A management decision on the target bonus of one employee-month: the discretionary amount of a
/// DISCRETIONARY bracket (80–99% in the owner's model), or an OVERRIDE of an overridable bracket's
/// fixed amount (≥150%). Taken in the commission review with the approve privilege, never by the
/// person it pays. Append-only: a new decision supersedes the live one (supersededAt), so the
/// history reads as what was decided. It applies only while the month still reaches the same
/// bracket of the same plan version. Additive, 20261101090000_commission_builder.
model CommissionBonusDecision {
  id            String                @id @default(cuid())
  employeeId    String
  employee      Employee              @relation("CommissionBonusDecisionOwner", fields: [employeeId], references: [id], onDelete: Restrict)
  periodStart   DateTime
  planVersionId String
  planVersion   CommissionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  bracketIndex  Int
  /// DISCRETIONARY | OVERRIDE (CHECK).
  kind          String
  amount        Decimal               @db.Decimal(18, 2)
  reason        String
  decidedById   String
  decidedAt     DateTime              @default(now())
  supersededAt  DateTime?

  @@index([employeeId, periodStart])
}

/// «إعدادات العمولات» — one row (id 'singleton'). The new-client window, the lapse period, the
/// eligibility duration (all inherited by a COMPONENTS plan unless the plan overrides them) and the
/// commission activation date: no COMPONENTS commission is computed on a collection before it, and
/// the monthly run refuses until it is set. Additive, 20261101090000_commission_builder.
model CommissionSettings {
  id                   String    @id @default("singleton")
  /// A client is new when it bought nothing within this window before its acquisition (default 12 months).
  newClientWindowValue Int       @default(12)
  newClientWindowUnit  String    @default("MONTHS")
  /// A client lapses after this long with no collected order (default 12 months); its sequence
  /// commission stops, and a later purchase is a re-acquisition under the new-client window rule.
  lapseValue           Int       @default(12)
  lapseUnit            String    @default("MONTHS")
  /// Eligibility after acquisition; NULL = forever (until the client lapses).
  eligibilityValue     Int?
  eligibilityUnit      String?
  /// Commission activation date. NULL = not activated yet.
  activationDate       DateTime?
  updatedById          String?
  updatedAt            DateTime  @default(now()) @updatedAt
}

/// Every change to the commission settings, the opening setup of a customer, or a customer's
/// new-client exclusion — before and after, by whom, why. Append-only by the application.
/// Additive, 20261101090000_commission_builder.
model CommissionAuditLog {
  id         String   @id @default(cuid())
  /// SETTINGS | OPENING | EXCLUSION (CHECK).
  kind       String
  customerId String?
  /// INLINE | CSV | SETTINGS | CUSTOMER_FILE (CHECK).
  source     String
  before     Json?
  after      Json?
  reason     String?
  actorId    String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([kind, createdAt])
}

/// A monthly sales target for a person. Deliberately separate from commission: hitting
/// a target may pay a bonus, but a target is not a commission rate and the two are not
/// summed by accident.
model SalesTarget {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation("SalesTargetOwner", fields: [employeeId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  targetAmount Decimal  @db.Decimal(18, 2)
  currency     String   @default("SAR")
  bonusAmount  Decimal  @default(0) @db.Decimal(18, 2)
  note         String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, periodStart])
  @@index([periodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales collections — manual, finance-verified receipts (additive).
//
// This ERP still has no invoice or accounts-receivable subsystem; that was checked
// against the schema, not assumed. What follows is NOT one. It is a durable internal
// record of "a salesperson says money arrived, and Finance either agrees or does not",
// and it is the only thing allowed to create commission entitlement.
//
// It deliberately does NOT replace `CollectionEvent`. That table is the commission
// engine's input adapter and is unchanged: on approval this workflow writes one row into
// it stamped `MANUAL_FINANCE_VERIFICATION`, so the engine's tiers, splits, period
// boundaries and reversal arithmetic are reused rather than reimplemented beside them.
//
// Nothing here is a bank integration and no screen says it is.
// ─────────────────────────────────────────────────────────────────────────────

/// How the money arrived. Recorded for reconciliation; used in no calculation.
enum SalesCollectionMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  POS_CARD
  OTHER
}

/// The lifecycle of a claimed receipt.
///
/// `APPROVED` is the only state that has ever created commission, and `REVERSED` is the
/// only way out of it — there is no delete and no edit-in-place, because by then the
/// figure has been used to tell somebody what they earned.
enum SalesCollectionStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  REVERSED
}

model SalesCollection {
  id String @id @default(cuid())

  /// What the money is against. The opportunity is required — commission is owed on a
  /// deal — and the accepted quotation is what the amounts are checked against.
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  quoteId       String?
  quote         Quote?      @relation(fields: [quoteId], references: [id])
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  /// Client-generated, unique per submitter: a double-clicked form, a retried request and
  /// a replayed queue message all carry the same key and land once.
  idempotencyKey  String
  /// The payer's own reference — a transfer id, a cheque number. Deliberately NOT unique:
  /// two genuine receipts can quote the same bank batch.
  referenceNumber String?

  /// Gross is what the salesperson claims arrived. Tax and net are DERIVED by the server
  /// from the linked document and then stored, so the figures a decision was made against
  /// survive a later revision of that document.
  amountGross Decimal @db.Decimal(18, 2)
  amountTax   Decimal @db.Decimal(18, 2)
  amountNet   Decimal @db.Decimal(18, 2)
  currency    String  @default("SAR")

  paymentMethod SalesCollectionMethod @default(BANK_TRANSFER)
  collectedAt   DateTime
  note          String?

  status SalesCollectionStatus @default(PENDING_VERIFICATION)

  submittedById String
  submittedBy   Employee @relation("CollectionSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  /// The verify-or-reject decision. Kept apart from the reversal fields below, because a
  /// reversal happens AFTER an approval and must not overwrite who approved it.
  decidedById    String?
  decidedBy      Employee? @relation("CollectionDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionReason String?

  reversedById   String?
  reversedBy     Employee? @relation("CollectionReverser", fields: [reversedById], references: [id])
  reversedAt     DateTime?
  reversalReason String?

  /// The commission-adapter row this became when Finance approved it. One-to-one, and the
  /// unique constraint is what makes a replayed approval a no-op rather than a second
  /// accrual.
  collectionEventId String?          @unique
  collectionEvent   CollectionEvent? @relation("CollectionCommissionEvent", fields: [collectionEventId], references: [id])

  evidence CollectionEvidence[]

  /// Sales invoicing A2 (additive, relation field only): how this receipt was applied to invoices.
  arApplications ArApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submittedById, idempotencyKey])
  @@index([opportunityId, status])
  @@index([status, submittedAt])
  @@index([submittedById, submittedAt])
}

/// Proof that the money arrived: a transfer screenshot, a deposit slip, a receipt.
///
/// The bytes live in `content` rather than on disk, because the deployment target has an
/// ephemeral filesystem and a file written there is gone at the next cold start. A
/// deliberate first implementation for a small, low-volume, private artefact:
/// `lib/services/sales/evidence.ts` is the only reader and writer, so moving to object
/// storage later changes that file and this column and nothing else.
model CollectionEvidence {
  id           String          @id @default(cuid())
  collectionId String
  collection   SalesCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  filename String
  /// The type proven by the file's own signature, never the one the browser claimed.
  mimeType String
  byteSize Int
  /// SHA-256 of the bytes, so a re-upload of the same proof is recognisable and a stored
  /// file can be shown not to have changed.
  checksum String
  content  Bytes

  uploadedById String
  uploadedBy   Employee @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([collectionId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Finance — Cash Management, Receipt Allocation, Monthly Cash Budget (additive)
// ═══════════════════════════════════════════════════════════════════════════════
//
// Six concepts are kept in separate records on purpose (docs/finance/CASH_BUDGET.md):
//   BankTransaction    money that actually entered or left a company account
//   AllocationEntry    an INTERNAL earmark of existing cash to a purpose - never an expense,
//                      never a bank transfer, never a journal entry
//   PaymentReservation part of a category's balance held for one approved payment request
//   (payment)          an outgoing BankTransaction, linked to a reservation / obligation
//   accounting revenue/expense - lives in the Accounting module (JournalEntry), untouched here
//   FinForecastItem    an expected future receipt or payment; never counted as cash
//
// Money is Decimal(18,2) SAR in the database and integer halalas in every calculation.
// Employee / Order / Supplier references are plain id strings (the Accounting S0 precedent)
// so this block adds no relation fields to existing models.
// Scoping key everywhere: branchKey = "COMPANY" or a FinBranch id.

enum CashAccountType {
  BANK
  CASH
  GATEWAY_CLEARING
}

enum BankTxnStatus {
  PENDING
  CONFIRMED
  VOID
}

enum BankTxnSource {
  MANUAL
  CSV_IMPORT
  CONNECTOR
}

enum BankTxnReview {
  NEEDS_REVIEW
  REVIEWED
}

/// What a bank line IS at company level. Drives eligibility for allocation and whether it
/// can ever count as an operating receipt/payment. Transfers, loans and owner money are
/// never operating receipts; loan principal is never an operating payment.
enum BankTxnClass {
  UNCLASSIFIED
  CUSTOMER_RECEIPT
  POS_SETTLEMENT
  GATEWAY_SETTLEMENT
  OTHER_OPERATING_RECEIPT
  INTERNAL_TRANSFER
  LOAN_PROCEEDS
  OWNER_CONTRIBUTION
  REFUND_RECEIVED
  SUPPLIER_PAYMENT
  PAYROLL
  RENT
  UTILITIES_OPERATING
  TAX_PAYMENT
  LOAN_PRINCIPAL_REPAYMENT
  LOAN_INTEREST
  BANK_FEE
  CUSTOMER_REFUND
  OWNER_DRAWING
  OTHER_OPERATING_PAYMENT
}

enum FinCategoryKind {
  RECEIPT
  PAYMENT
}

enum FinMatchTarget {
  ORDER
  OBLIGATION
  PURCHASE_RECORD
  /// Reserved for feature/sales-crm-commissions (SalesCollection). Refused by the service
  /// until that model exists on this branch.
  SALES_COLLECTION
}

enum FinReconStatus {
  DRAFT
  COMPLETED
}

enum AllocFundingType {
  /// Fund up to targetAmount per calendar month. Spending does NOT reopen the gap.
  MONTHLY_TARGET
  /// Keep the balance at targetAmount; replenished after spending only if `replenish`.
  RESERVE_TARGET
  /// Funded by obligations due, percentage, or remainder only.
  OPEN
}

enum AllocRollover {
  CARRY_FORWARD
  SWEEP_TO_UNALLOCATED
}

enum AllocRuleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum AllocMethod {
  PERCENT_OF_BASE
  FILL_TARGET
  FUND_OBLIGATIONS
  RECEIPT_TAX_COMPONENT
  WEIGHTED_REMAINDER
  LEAVE_UNALLOCATED
}

enum AllocEntryType {
  ALLOCATION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  PAYMENT
}

enum AllocSourceType {
  RECEIPT
  OPENING_BALANCE
  CATEGORY_TRANSFER
  RECEIPT_REVERSAL
  PAYMENT
  MANUAL_ADJUSTMENT
  PERIOD_SWEEP
}

enum ReservationStatus {
  PENDING_APPROVAL
  ACTIVE
  EXECUTED
  RELEASED
  REJECTED
}

enum ObligationType {
  SUPPLIER_BILL
  PURCHASE_ORDER
  PAYROLL
  RENT
  TAX
  LOAN_REPAYMENT
  UTILITIES
  OTHER
}

enum ObligationStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
  SUPERSEDED
}

enum ForecastItemKind {
  RECEIPT
  PAYMENT
}

enum ForecastItemStatus {
  OPEN
  REALIZED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CLOSED
}

enum BudgetRevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum BudgetBasis {
  CASH
  ACCRUAL
}

enum BudgetLineKind {
  RECEIPT
  PAYMENT
  /// Expected SALES - informational, never part of cash totals (collections are RECEIPT lines).
  SALES_MEMO
}

enum PhasingMethod {
  DUE_DATE
  CUSTOM_WEIGHTS
  STRAIGHT_LINE
}

enum FinApprovalType {
  BUDGET_APPROVAL
  ALLOCATION_RULES
  CATEGORY_TRANSFER
  SPEND_OVERRIDE
  PERIOD_REOPEN
}

enum FinApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum VarianceNoteStatus {
  OPEN
  RESOLVED
}

model FinSettings {
  id                     String   @id @default("singleton")
  baseCurrency           String   @default("SAR")
  timezone               String   @default("Asia/Riyadh")
  reconciliationDueDays  Int      @default(7)
  alertAmountThreshold   Decimal  @default(1000) @db.Decimal(18, 2)
  alertPercentThreshold  Decimal  @default(10) @db.Decimal(7, 2)
  /// EITHER: alert when the amount OR the percent threshold is crossed. BOTH: only when both are.
  alertThresholdMode     String   @default("EITHER")
  obligationAlertDays    Int      @default(7)
  conservativeDelayWeeks Int      @default(2)
  conservativeCollectPct Int      @default(80)
  updatedAt              DateTime @updatedAt
  updatedBy              String?
}

model FinBranch {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  access FinBranchAccess[]

  // Native HR (additive): people and job openings located at this branch.
  hrEmployees   HrEmployee[]   @relation("HrEmployeeBranch")
  hrJobOpenings HrJobOpening[] @relation("HrJobOpeningBranch")
}

/// Which branches a finance user without `all_branches` may read and write.
model FinBranchAccess {
  id         String    @id @default(cuid())
  employeeId String
  branchId   String
  branch     FinBranch @relation(fields: [branchId], references: [id])
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@unique([employeeId, branchId])
  @@index([employeeId])
}

model FinCostCenter {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String?
  branchKey String   @default("COMPANY")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
}

/// Receipt / payment categories of the CASH budget, also used to classify bank lines.
model FinCategory {
  id          String          @id @default(cuid())
  code        String          @unique
  nameEn      String
  nameAr      String?
  kind        FinCategoryKind
  /// Financing and transfer categories are excluded from operating totals.
  isOperating Boolean         @default(true)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  createdBy   String?
}

model CashAccount {
  id                 String          @id @default(cuid())
  code               String          @unique
  nameEn             String
  nameAr             String?
  type               CashAccountType @default(BANK)
  branchKey          String          @default("COMPANY")
  currency           String          @default("SAR")
  bankName           String?
  /// Last four digits only. No full account numbers and no online-banking credentials.
  accountLast4       String?
  /// Restricted cash (deposits, guarantees) is reported but never allocatable.
  isRestricted       Boolean         @default(false)
  openingBalance     Decimal         @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime        @db.Date
  /// Optional link to the Accounting S0 chart of accounts (reference only; no postings).
  glAccountId        String?
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  createdBy          String?

  transactions    BankTransaction[]
  importBatches   BankImportBatch[]
  reconciliations BankReconciliation[]

  @@index([branchKey])
}

model BankTransaction {
  id                    String              @id @default(cuid())
  cashAccountId         String
  cashAccount           CashAccount         @relation(fields: [cashAccountId], references: [id])
  branchKey             String
  txnDate               DateTime            @db.Date
  /// Signed net cash movement: positive = into the account, negative = out.
  amount                Decimal             @db.Decimal(18, 2)
  currency              String              @default("SAR")
  /// Settlements received net of fees: grossAmount - feeAmount = amount.
  grossAmount           Decimal?            @db.Decimal(18, 2)
  feeAmount             Decimal?            @db.Decimal(18, 2)
  bankReference         String?
  description           String?
  counterparty          String?
  status                BankTxnStatus       @default(CONFIRMED)
  source                BankTxnSource       @default(MANUAL)
  classification        BankTxnClass        @default(UNCLASSIFIED)
  reviewStatus          BankTxnReview       @default(NEEDS_REVIEW)
  reviewNote            String?
  reviewedBy            String?
  reviewedAt            DateTime?
  /// Import dedup identity: sha256(account, date, amount, reference, description, occurrence).
  sourceFingerprint     String?
  /// Client-generated key for manual entry; a double-submitted form lands once.
  idempotencyKey        String?
  /// Set on import when a line with the same date and amount exists but the fingerprint
  /// differs. Flagged for a human, never auto-rejected.
  possibleDuplicateOfId String?
  /// The other leg of a transfer between two company accounts.
  transferPeerId        String?             @unique
  importBatchId         String?
  importBatch           BankImportBatch?    @relation(fields: [importBatchId], references: [id])
  reconciliationId      String?
  reconciliation        BankReconciliation? @relation(fields: [reconciliationId], references: [id])
  /// Set when a bank statement row confirmed this already-recorded line (no new line created).
  statementBatchId      String?
  statementConfirmedAt  DateTime?
  voidedAt              DateTime?
  voidedBy              String?
  voidReason            String?
  createdAt             DateTime            @default(now())
  createdBy             String?
  updatedAt             DateTime            @updatedAt

  splits  BankTransactionSplit[]
  matches BankTransactionMatch[]

  @@unique([cashAccountId, sourceFingerprint])
  @@unique([createdBy, idempotencyKey])
  @@index([branchKey, txnDate])
  @@index([cashAccountId, txnDate])
  @@index([reviewStatus])
  @@index([classification])
}

/// Budget classification of a bank line. Splits must sum exactly to the parent amount.
model BankTransactionSplit {
  id            String          @id @default(cuid())
  transactionId String
  transaction   BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  finCategoryId String
  costCenterId  String?
  /// Signed like the parent.
  amount        Decimal         @db.Decimal(18, 2)
  note          String?
  createdAt     DateTime        @default(now())

  @@index([transactionId])
  @@index([finCategoryId])
}

/// A link from a bank line to an existing ERP document. Linking never creates a receipt.
model BankTransactionMatch {
  id            String          @id @default(cuid())
  transactionId String
  transaction   BankTransaction @relation(fields: [transactionId], references: [id])
  targetType    FinMatchTarget
  targetId      String
  /// Portion of the bank line applied to this document (always positive).
  amount        Decimal         @db.Decimal(18, 2)
  /// VAT portion of `amount`, taken from the document by the reviewer. Drives the tax reserve.
  taxAmount     Decimal         @default(0) @db.Decimal(18, 2)
  active        Boolean         @default(true)
  removedAt     DateTime?
  removedBy     String?
  createdAt     DateTime        @default(now())
  createdBy     String?

  @@index([transactionId])
  @@index([targetType, targetId])
}

model BankImportBatch {
  id             String      @id @default(cuid())
  cashAccountId  String
  cashAccount    CashAccount @relation(fields: [cashAccountId], references: [id])
  fileName       String
  fileHash       String
  mapping        Json
  rowCount       Int
  importedCount  Int
  /// Statement rows that confirmed an already-recorded line instead of creating one.
  attachedCount  Int         @default(0)
  duplicateCount Int
  flaggedCount   Int
  errorCount     Int
  errors         Json
  createdAt      DateTime    @default(now())
  createdBy      String?

  transactions BankTransaction[]

  @@index([cashAccountId, createdAt])
}

model BankReconciliation {
  id               String         @id @default(cuid())
  cashAccountId    String
  cashAccount      CashAccount    @relation(fields: [cashAccountId], references: [id])
  statementDate    DateTime       @db.Date
  statementBalance Decimal        @db.Decimal(18, 2)
  ledgerBalance    Decimal        @db.Decimal(18, 2)
  pendingTotal     Decimal        @default(0) @db.Decimal(18, 2)
  difference       Decimal        @db.Decimal(18, 2)
  status           FinReconStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime       @default(now())
  createdBy        String?
  completedAt      DateTime?
  completedBy      String?

  transactions BankTransaction[]

  @@index([cashAccountId, statementDate])
}

model FinAttachment {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  fileName    String
  contentType String
  sizeBytes   Int
  content     Bytes
  createdAt   DateTime @default(now())
  createdBy   String?

  @@index([entityType, entityId])
}

model AllocationCategory {
  id                 String           @id @default(cuid())
  code               String           @unique
  nameEn             String
  nameAr             String?
  branchKey          String           @default("COMPANY")
  priority           Int              @default(100)
  fundingType        AllocFundingType @default(OPEN)
  targetAmount       Decimal?         @db.Decimal(18, 2)
  /// RESERVE_TARGET only: refill after spending. Without it the reserve is a one-time fill.
  replenish          Boolean          @default(false)
  targetStartMonth   String?
  targetEndMonth     String?
  dueDay             Int?
  rollover           AllocRollover    @default(CARRY_FORWARD)
  /// A single payment above this needs a SPEND_OVERRIDE approval.
  spendingLimit      Decimal?         @db.Decimal(18, 2)
  approverEmployeeId String?
  finCategoryId      String?
  costCenterId       String?
  /// Tax categories may only be funded from document tax or tax obligations - never from a
  /// flat percentage of deposits.
  isTaxReserve       Boolean          @default(false)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  createdBy          String?

  entries      AllocationEntry[]
  reservations PaymentReservation[]

  @@index([branchKey])
}

model AllocationRuleVersion {
  id          String          @id @default(cuid())
  branchKey   String          @default("COMPANY")
  versionNo   Int
  status      AllocRuleStatus @default(DRAFT)
  /// Receipt classifications forming the base of PERCENT_OF_BASE. Stored per version so a
  /// percentage can never be silently applied to a different base.
  baseClasses BankTxnClass[]
  /// Run automatically on newly confirmed eligible receipts. Only honoured while ACTIVE.
  autoExecute Boolean         @default(false)
  notes       String?
  createdAt   DateTime        @default(now())
  createdBy   String?
  approvedAt  DateTime?
  approvedBy  String?
  activatedAt DateTime?

  steps AllocationRuleStep[]
  runs  AllocationRun[]

  @@unique([branchKey, versionNo])
}

model AllocationRuleStep {
  id         String                @id @default(cuid())
  versionId  String
  version    AllocationRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  seq        Int
  method     AllocMethod
  categoryId String?
  /// Percent with up to four decimals (65.0000). PERCENT_OF_BASE only.
  percent    Decimal?              @db.Decimal(7, 4)
  weight     Int?
  capAmount  Decimal?              @db.Decimal(18, 2)

  @@unique([versionId, seq])
}

/// One execution of a rule version against one source receipt. The unique source is what
/// makes a retried or concurrent run a no-op instead of a second allocation.
model AllocationRun {
  id              String                @id @default(cuid())
  versionId       String
  version         AllocationRuleVersion @relation(fields: [versionId], references: [id])
  sourceTxnId     String                @unique
  baseAmount      Decimal               @db.Decimal(18, 2)
  allocatedTotal  Decimal               @db.Decimal(18, 2)
  leftUnallocated Decimal               @db.Decimal(18, 2)
  trigger         String                @default("MANUAL")
  createdAt       DateTime              @default(now())
  createdBy       String?

  entries AllocationEntry[]
}

/// Append-only envelope ledger. Balances are sums of these rows; nothing is rewritten.
model AllocationEntry {
  id                  String             @id @default(cuid())
  categoryId          String
  category            AllocationCategory @relation(fields: [categoryId], references: [id])
  branchKey           String
  entryType           AllocEntryType
  sourceType          AllocSourceType
  /// Always positive; direction comes from entryType.
  amount              Decimal            @db.Decimal(18, 2)
  /// Calendar month (Asia/Riyadh) the entry counts toward, YYYY-MM.
  periodMonth         String
  sourceTxnId         String?
  sourceCashAccountId String?
  runId               String?
  run                 AllocationRun?     @relation(fields: [runId], references: [id])
  ruleVersionId       String?
  stepSeq             Int?
  reservationId       String?
  approvalId          String?
  reversesEntryId     String?            @unique
  reason              String?
  createdAt           DateTime           @default(now())
  createdBy           String?

  @@index([categoryId, periodMonth])
  @@index([sourceTxnId])
  @@index([branchKey])
}

model PaymentReservation {
  id               String             @id @default(cuid())
  categoryId       String
  category         AllocationCategory @relation(fields: [categoryId], references: [id])
  branchKey        String
  obligationId     String?
  amount           Decimal            @db.Decimal(18, 2)
  payee            String
  purpose          String
  dueDate          DateTime?          @db.Date
  status           ReservationStatus  @default(ACTIVE)
  requiresOverride Boolean            @default(false)
  approvalId       String?
  executedTxnId    String?
  executedAt       DateTime?
  executedBy       String?
  releasedAt       DateTime?
  releasedBy       String?
  releaseReason    String?
  idempotencyKey   String?
  createdAt        DateTime           @default(now())
  createdBy        String?

  @@unique([createdBy, idempotencyKey])
  @@index([categoryId, status])
  @@index([obligationId])
}

model FinObligation {
  id                   String           @id @default(cuid())
  branchKey            String           @default("COMPANY")
  type                 ObligationType
  description          String
  counterparty         String?
  amount               Decimal          @db.Decimal(18, 2)
  currency             String           @default("SAR")
  dueDate              DateTime         @db.Date
  status               ObligationStatus @default(OPEN)
  /// MANUAL, PURCHASE_RECORD, ... plus that record's id. Unique, so one source document can
  /// only ever become one obligation.
  sourceType           String           @default("MANUAL")
  sourceId             String?
  /// PO -> supplier bill: the bill supersedes the PO; a SUPERSEDED obligation is never
  /// counted again anywhere.
  supersedesId         String?          @unique
  allocationCategoryId String?
  finCategoryId        String?
  costCenterId         String?
  cancelledAt          DateTime?
  cancelledBy          String?
  cancelReason         String?
  createdAt            DateTime         @default(now())
  createdBy            String?
  updatedAt            DateTime         @updatedAt

  @@unique([sourceType, sourceId])
  @@index([branchKey, dueDate])
  @@index([status])
}

/// Expected receipts / payments that are NOT represented by an obligation.
model FinForecastItem {
  id            String             @id @default(cuid())
  branchKey     String             @default("COMPANY")
  kind          ForecastItemKind
  description   String
  counterparty  String?
  amount        Decimal            @db.Decimal(18, 2)
  expectedDate  DateTime           @db.Date
  finCategoryId String?
  status        ForecastItemStatus @default(OPEN)
  realizedTxnId String?
  createdAt     DateTime           @default(now())
  createdBy     String?
  updatedAt     DateTime           @updatedAt

  @@index([branchKey, expectedDate])
}

model FinBudget {
  id           String       @id @default(cuid())
  month        String
  branchKey    String       @default("COMPANY")
  costCenterId String?
  basis        BudgetBasis  @default(CASH)
  status       BudgetStatus @default(DRAFT)
  title        String?
  createdAt    DateTime     @default(now())
  createdBy    String?
  closedAt     DateTime?
  closedBy     String?

  revisions BudgetRevision[]

  @@unique([month, branchKey])
}

model BudgetRevision {
  id           String               @id @default(cuid())
  budgetId     String
  budget       FinBudget            @relation(fields: [budgetId], references: [id])
  revisionNo   Int
  status       BudgetRevisionStatus @default(DRAFT)
  reason       String?
  createdAt    DateTime             @default(now())
  createdBy    String?
  submittedAt  DateTime?
  submittedBy  String?
  decidedAt    DateTime?
  decidedBy    String?
  decisionNote String?

  lines BudgetLine[]

  @@unique([budgetId, revisionNo])
}

model BudgetLine {
  id              String         @id @default(cuid())
  revisionId      String
  revision        BudgetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// Stable identity across revisions (kind + category + cost centre).
  lineKey         String
  finCategoryId   String
  costCenterId    String?
  kind            BudgetLineKind
  plannedAmount   Decimal        @db.Decimal(18, 2)
  ownerEmployeeId String?
  assumptions     String?
  dueDate         DateTime?      @db.Date
  phasing         PhasingMethod  @default(DUE_DATE)
  /// CUSTOM_WEIGHTS: { "1": w, "15": w } day-of-month -> weight.
  phasingWeights  Json?

  @@unique([revisionId, lineKey])
}

model FinVarianceNote {
  id                    String             @id @default(cuid())
  budgetId              String
  lineKey               String
  explanation           String
  correctiveAction      String?
  responsibleEmployeeId String?
  followUpDate          DateTime?          @db.Date
  status                VarianceNoteStatus @default(OPEN)
  createdAt             DateTime           @default(now())
  createdBy             String?
  resolvedAt            DateTime?
  resolvedBy            String?

  @@index([budgetId, lineKey])
}

/// Dated forecast snapshot. Never modifies a budget revision.
model FinForecastSnapshot {
  id         String   @id @default(cuid())
  kind       String
  branchKey  String   @default("COMPANY")
  budgetId   String?
  month      String?
  cutoffDate DateTime @db.Date
  data       Json
  createdAt  DateTime @default(now())
  createdBy  String?

  @@index([kind, branchKey, cutoffDate])
}

model FinApprovalRequest {
  id           String            @id @default(cuid())
  type         FinApprovalType
  branchKey    String            @default("COMPANY")
  entityType   String
  entityId     String
  summary      String
  payload      Json
  /// The finance sub-privilege allowed to decide this request.
  requiredSub  String
  /// A named approver when the category names one; otherwise any holder of requiredSub.
  assignedToId String?
  status       FinApprovalStatus @default(PENDING)
  requestedBy  String
  requestedAt  DateTime          @default(now())
  reason       String?
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([status, requiredSub])
  @@index([assignedToId, status])
  @@index([entityType, entityId])
}

/// Append-only audit trail for every finance write.
model FinAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  branchKey  String?
  before     Json?
  after      Json?
  reason     String?
  refs       Json?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
//  WhatsApp automation (additive)
//
//  Rules of the form "when <event> happens, if <conditions>, do <steps>", where a step is
//  a WhatsApp message rendered from a template, or a wait. Outbound only: nothing here
//  reads incoming messages. See docs/automation/WHATSAPP_AUTOMATION.md.
//
//  Single-tenant, like every other table today: no tenantId until the Tenant model exists
//  (docs/saas-readiness.md). Every model below is tenant-owned when that day comes.
// ═══════════════════════════════════════════════════════════════════════════════

enum AutomationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

/// OFF records what would have been sent without sending it; TEST sends every message to
/// the single test number; LIVE sends to the real recipients, and only on a deployment
/// that explicitly allows it (WHATSAPP_LIVE_ENABLED).
enum WhatsAppSendMode {
  OFF
  TEST
  LIVE
}

/// A user-built automation. `conditions` and `steps` are validated JSON
/// (src/lib/automation/rules.ts) rather than child tables: a rule is edited and saved as
/// one unit, and nothing queries inside a step.
model AutomationRule {
  id          String          @id @default(cuid())
  name        String
  description String?
  /// A key from the event catalogue (src/lib/automation/catalog.ts).
  eventType   String
  isActive    Boolean         @default(false)
  /// Language used when an enumerated value (an order status, a QC outcome) is written
  /// into a message. "ar" or "en".
  locale      String          @default("ar")
  conditions  Json            @default("[]")
  steps       Json            @default("[]")
  createdById String?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AutomationRun[]

  @@index([eventType, isActive])
}

/// The outbox. Written in the SAME transaction as the business change it describes, so an
/// event exists if and only if the change committed. Processed after the response by the
/// dispatcher, never inline — a slow or absent WhatsApp server can never fail or delay an
/// order, a delivery or a QC decision.
///
/// `payload` carries only the facts of the moment (the status moved from/to, the units
/// delivered). Names, numbers and phones are read when the event is processed.
model AutomationEvent {
  id          String                @id @default(cuid())
  eventType   String
  subjectType String
  subjectId   String
  payload     Json
  actorId     String?
  /// Set for events the dispatcher derives on a schedule (a task falling due), so the same
  /// moment is never raised twice.
  dedupeKey   String?               @unique
  status      AutomationEventStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  occurredAt  DateTime              @default(now())
  processedAt DateTime?
  runs        AutomationRun[]

  @@index([status, occurredAt])
  @@index([subjectType, subjectId])
}

/// One rule considered against one event — matched or not, and why not. The unique pair is
/// what makes reprocessing an event safe: a rule can never act twice on the same event.
model AutomationRun {
  id        String          @id @default(cuid())
  ruleId    String
  rule      AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventId   String
  event     AutomationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matched   Boolean
  note      String?
  createdAt DateTime        @default(now())

  @@unique([ruleId, eventId])
  @@index([createdAt])
}

/// One outbound WhatsApp message: the job and its log in one row. The rule's name and the
/// event are copied rather than related, so the record of what was sent survives the rule
/// being edited or deleted.
model WhatsAppMessage {
  id                String                @id @default(cuid())
  /// `${runId}:${stepIndex}:${recipient}` for automated messages; unique so a retried
  /// dispatch can never queue the same message twice.
  dedupeKey         String                @unique
  ruleId            String?
  ruleName          String?
  eventId           String?
  eventType         String?
  subjectType       String?
  subjectId         String?
  stepIndex         Int?
  recipientKind     String
  recipientName     String?
  /// Normalised international digits (9665XXXXXXXX). Null when there was no usable number.
  phone             String?
  /// The real recipient's number when TEST mode redirected the message.
  intendedPhone     String?
  body              String
  status            WhatsAppMessageStatus @default(QUEUED)
  /// Why a message was skipped, failed or cancelled. Never contains a credential.
  statusNote        String?
  scheduledAt       DateTime              @default(now())
  nextAttemptAt     DateTime?
  attempts          Int                   @default(0)
  lockedAt          DateTime?
  providerMessageId String?
  sentAt            DateTime?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sendAttempts      WhatsAppSendAttempt[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@index([subjectType, subjectId])
}

/// Append-only: one row per call to the WhatsApp server.
model WhatsAppSendAttempt {
  id         String          @id @default(cuid())
  messageId  String
  message    WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  attemptNo  Int
  ok         Boolean
  httpStatus Int?
  error      String?
  durationMs Int?
  createdAt  DateTime        @default(now())

  @@index([messageId])
}

/// Singleton (id "singleton"), like SystemConfig.
model AutomationSettings {
  id                  String           @id @default("singleton")
  sendMode            WhatsAppSendMode @default(OFF)
  /// Where every message goes in TEST mode.
  testPhone           String?
  /// Last time the dispatcher looked for tasks falling due. Doubles as the guard that
  /// stops two dispatchers sweeping at once.
  lastSweepAt         DateTime?
  updatedById         String?
  updatedAt           DateTime         @updatedAt
  /// The language of automation messages to EMPLOYEES who have not chosen one ("ar" | "en", CHECK).
  /// NULL = Arabic. Migration 20261110090000_i18n_preferences (additive).
  employeeMessageLang String?
}

/// «إشعارات الحالات» — one row per status that exists somewhere in the system (an order status,
/// a pipeline stage, a quotation status…), and what WhatsApp should do when a record enters it.
/// The catalogue is filled and kept current by the status sync (src/lib/automation/status-rules/
/// sync.ts); a status first seen arrives switched OFF. A status that disappears or is hidden in its
/// source keeps its row with active = false — rules are never deleted silently.
/// Migration 20261022100000_whatsapp_status_rules (additive).
model WhatsAppStatusRule {
  id            String    @id @default(cuid())
  /// Where the status lives: order, deal_stage, quote… (STATUS_SOURCES in status-rules/sources.ts).
  source        String
  /// The status's stable identity in its source: an order status value, a stage code, an enum value.
  statusKey     String
  labelAr       String
  labelEn       String
  position      Int       @default(0)
  /// The owner's switch. New rows are false.
  enabled       Boolean   @default(false)
  /// ["customer", "deal_owner", "admins", …] — kinds the source can resolve.
  recipients    Json      @default("[]")
  template      String    @default("")
  /// The English text, sent to EMPLOYEES who receive English (Employee.whatsappLanguage /
  /// AutomationSettings.employeeMessageLang). NULL or empty = `template`. Customers always get
  /// `template`. Migration 20261110090000_i18n_preferences (additive).
  templateEn    String?
  /// «إعادة الإرسال عند العودة لنفس الحالة»: false = one message per record, status and person,
  /// ever; true = one per ENTRY (per automation event), so a record re-entering the status is
  /// announced again — still never twice for the same entry.
  renotify      Boolean   @default(false)
  /// False when the status no longer exists or is hidden in its source.
  active        Boolean   @default(true)
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  inactiveSince DateTime?
  /// Null while a status found by a later sync has not been looked at — the «جديدة» chip.
  reviewedAt    DateTime?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([source, statusKey])
  @@index([enabled, active])
}

// ═════════════════════════════════════════════════════════════════════════════════════
//  NATIVE HR (additive). See docs/hr/PLAN.md and docs/hr/DATA_MODEL.md.
//
//  Rules that hold across every model below:
//  • An HR person (HrEmployee) is NOT a login. `accountId` optionally links one login.
//  • Identity, bank and emergency data live only in HrEmployeePrivate.
//  • Money is Decimal(18,2); dates that are calendar days are @db.Date (no time zone).
//  • Ledgers and decided records are append-only; the migration adds the DB triggers.
// ═════════════════════════════════════════════════════════════════════════════════════

enum HrEmploymentStatus {
  PROBATION
  ACTIVE
  NOTICE
  SUSPENDED
  SEPARATED
}

enum HrEmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
}

model HrDepartment {
  id        String         @id @default(cuid())
  code      String         @unique
  nameAr    String
  nameEn    String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  createdBy String?
  employees HrEmployee[]
  openings  HrJobOpening[]
}

model HrEmployee {
  id               String             @id @default(cuid())
  employeeNo       String             @unique
  fullNameAr       String
  fullNameEn       String?
  jobTitle         String
  departmentId     String?
  department       HrDepartment?      @relation(fields: [departmentId], references: [id])
  branchId         String?
  branch           FinBranch?         @relation("HrEmployeeBranch", fields: [branchId], references: [id])
  managerId        String?
  manager          HrEmployee?        @relation("HrManager", fields: [managerId], references: [id])
  reports          HrEmployee[]       @relation("HrManager")
  status           HrEmploymentStatus @default(PROBATION)
  employmentType   HrEmploymentType   @default(FULL_TIME)
  hireDate         DateTime           @db.Date
  probationEndDate DateTime?          @db.Date
  separationDate   DateTime?          @db.Date
  workPhone        String?
  workEmail        String?
  /// The login this person uses, if any. Unique: one login cannot be two people.
  accountId        String?            @unique
  account          Employee?          @relation("HrPersonAccount", fields: [accountId], references: [id], onDelete: SetNull)
  /// Optimistic concurrency: every profile edit must send the version it read.
  version          Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        String?

  private            HrEmployeePrivate?
  documents          HrDocument[]
  contracts          HrContract[]
  compensations      HrCompensation[]
  shiftAssignments   HrShiftAssignment[]
  attendance         HrAttendance[]
  corrections        HrAttendanceCorrection[]
  overtime           HrOvertime[]
  leaveRequests      HrLeaveRequest[]
  leaveLedger        HrLeaveLedger[]
  payrollLines       HrPayrollLine[]
  payrollAdjustments HrPayrollAdjustment[]
  paymentAllocations HrPayrollPaymentAllocation[]
  paymentReturns     HrPayrollPaymentReturn[]
  provisionLedger    HrProvisionLedger[]
  advances           HrAdvance[]
  assetAssignments   HrAssetAssignment[]
  trainings          HrTraining[]
  reviews            HrReview[]                   @relation("HrReviewSubject")
  incidents          HrIncident[]
  separations        HrSeparation[]
  finalSettlements   HrFinalSettlement[]
  gosiInvoiceLines   HrGosiInvoiceLine[]
  gosiSettlements    HrGosiSettlement[]
  gosiAdjustments    HrGosiAdjustment[]
  hiredFrom          HrApplicant?                 @relation("HrApplicantHire")

  @@index([status])
  @@index([branchId])
  @@index([managerId])
  @@index([departmentId])
}

/// Sensitive personal data, 1:1 with HrEmployee. Read only with hr.private_view (or by
/// the person themself through self-service), and every read is audited.
model HrEmployeePrivate {
  employeeId        String     @id
  employee          HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  idType            String? // NATIONAL_ID | IQAMA | PASSPORT
  idNumber          String?
  /// hr_norm_id(idNumber), written by the database guard only (unique; never an external person's).
  idNumberNorm      String?
  idExpiry          DateTime?  @db.Date
  nationality       String?
  /// Matches HrContributionRule.appliesToGroup. A business attribute, not a statutory claim.
  contributionGroup String?
  dateOfBirth       DateTime?  @db.Date
  gender            String?
  personalPhone     String?
  personalEmail     String?
  address           String?
  bankName          String?
  iban              String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  updatedAt         DateTime   @updatedAt
  updatedBy         String?
}

model HrDocument {
  id                 String              @id @default(cuid())
  employeeId         String
  employee           HrEmployee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  category           String // CONTRACT | IDENTITY | CERTIFICATE | MEDICAL | OTHER
  title              String
  fileName           String
  mimeType           String
  sizeBytes          Int
  sha256             String
  content            Bytes
  confidential       Boolean             @default(true)
  expiresOn          DateTime?           @db.Date
  uploadedBy         String
  createdAt          DateTime            @default(now())
  /// Soft delete: the bytes stay for audit; the document disappears from lists.
  deletedAt          DateTime?
  deletedBy          String?
  settlementCalcs    HrFinalSettlement[] @relation("HrSettlementCalcDoc")
  settlementPayments HrFinalSettlement[] @relation("HrSettlementProofDoc")

  @@index([employeeId])
  @@index([expiresOn])
}

enum HrContractType {
  FIXED_TERM
  OPEN_ENDED
}

enum HrContractStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ENDED
}

/// A versioned employment contract. Renewal creates the next version and, in the same
/// transaction, marks the current one SUPERSEDED (`supersedesId` is unique: a contract
/// is superseded once).
model HrContract {
  id            String           @id @default(cuid())
  employeeId    String
  employee      HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractNo    String           @unique
  version       Int
  type          HrContractType
  startDate     DateTime         @db.Date
  endDate       DateTime?        @db.Date
  probationDays Int?
  noticeDays    Int
  status        HrContractStatus @default(DRAFT)
  supersedesId  String?          @unique
  supersedes    HrContract?      @relation("HrContractSupersession", fields: [supersedesId], references: [id])
  supersededBy  HrContract?      @relation("HrContractSupersession")
  notes         String?
  createdBy     String
  createdAt     DateTime         @default(now())
  activatedBy   String?
  activatedAt   DateTime?
  endedAt       DateTime?
  endReason     String?

  @@unique([employeeId, version])
  @@index([status, endDate])
}

/// Effective-dated pay. Versions of one person never overlap (DB trigger). A new version
/// closes the open one the day before it starts. Rows are never edited otherwise.
model HrCompensation {
  id             String     @id @default(cuid())
  employeeId     String
  employee       HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime   @db.Date
  effectiveTo    DateTime?  @db.Date
  basic          Decimal    @db.Decimal(18, 2)
  housing        Decimal    @default(0) @db.Decimal(18, 2)
  transport      Decimal    @default(0) @db.Decimal(18, 2)
  otherAllowance Decimal    @default(0) @db.Decimal(18, 2)
  reason         String
  contractId     String?
  createdBy      String
  createdAt      DateTime   @default(now())

  @@index([employeeId, effectiveFrom])
}

// ── Time & attendance ───────────────────────────────────────────────────────────────

model HrShift {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  /// Local wall-clock "HH:MM" in the HR policy time zone.
  startTime    String
  endTime      String
  breakMinutes Int                 @default(0)
  graceMinutes Int                 @default(0)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  assignments  HrShiftAssignment[]
}

model HrShiftAssignment {
  id            String     @id @default(cuid())
  employeeId    String
  employee      HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId       String
  shift         HrShift    @relation(fields: [shiftId], references: [id])
  effectiveFrom DateTime   @db.Date
  effectiveTo   DateTime?  @db.Date
  /// 0 = Sunday … 6 = Saturday, working days for this assignment.
  weekdays      Int[]
  createdBy     String
  createdAt     DateTime   @default(now())

  @@index([employeeId, effectiveFrom])
}

enum HrAttendanceStatus {
  OPEN
  CLOSED
  ABSENT
}

model HrAttendance {
  id              String                   @id @default(cuid())
  employeeId      String
  employee        HrEmployee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// The local calendar day (policy time zone) the shift belongs to.
  workDate        DateTime                 @db.Date
  shiftId         String?
  /// UTC instants.
  checkInAt       DateTime?
  checkOutAt      DateTime?
  source          String // DEVICE | SELF | MANUAL | CORRECTION
  workedMinutes   Int?
  lateMinutes     Int?
  overtimeMinutes Int?
  status          HrAttendanceStatus       @default(OPEN)
  notes           String?
  createdBy       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  corrections     HrAttendanceCorrection[]
  overtime        HrOvertime?

  @@unique([employeeId, workDate])
  @@index([workDate])
}

enum HrDecisionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A request to change a day's record. The original values are kept in `before`.
model HrAttendanceCorrection {
  id                String           @id @default(cuid())
  employeeId        String
  employee          HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceId      String?
  attendance        HrAttendance?    @relation(fields: [attendanceId], references: [id])
  workDate          DateTime         @db.Date
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            HrDecisionStatus @default(PENDING)
  requestedBy       String
  createdAt         DateTime         @default(now())
  decidedBy         String?
  decidedAt         DateTime?
  decisionNote      String?
  before            Json?

  @@index([status])
  @@index([employeeId, workDate])
}

/// Overtime counts for payroll only when APPROVED. `payrollRunId` is set while a
/// non-cancelled run uses it, so the same minutes are never paid twice.
model HrOvertime {
  id           String           @id @default(cuid())
  employeeId   String
  employee     HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workDate     DateTime         @db.Date
  minutes      Int
  attendanceId String?          @unique
  attendance   HrAttendance?    @relation(fields: [attendanceId], references: [id])
  source       String // ATTENDANCE | MANUAL
  /// Why it was recorded (manual entries); the decision note is separate.
  reason       String?
  status       HrDecisionStatus @default(PENDING)
  requestedBy  String
  createdAt    DateTime         @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  payrollRunId String?

  @@index([status, workDate])
  @@index([employeeId, workDate])
}

// ── Leave ───────────────────────────────────────────────────────────────────────────

model HrLeaveType {
  id                 String           @id @default(cuid())
  code               String           @unique
  nameAr             String
  paid               Boolean          @default(true)
  /// Whether taking it consumes a ledger balance.
  tracksBalance      Boolean          @default(true)
  /// Days accrued per year, credited monthly by the accrual job. Null = no accrual.
  accrualDaysPerYear Decimal?         @db.Decimal(6, 2)
  allowNegative      Boolean          @default(false)
  active             Boolean          @default(true)
  /// True while the entitlement is a proposal the owner has not confirmed.
  isProposal         Boolean          @default(true)
  createdAt          DateTime         @default(now())
  requests           HrLeaveRequest[]
  ledger             HrLeaveLedger[]
}

enum HrLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
}

model HrLeaveRequest {
  id             String          @id @default(cuid())
  employeeId     String
  employee       HrEmployee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId    String
  leaveType      HrLeaveType     @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  days           Decimal         @db.Decimal(6, 2)
  status         HrLeaveStatus   @default(PENDING)
  reason         String?
  requestedBy    String
  idempotencyKey String?
  createdAt      DateTime        @default(now())
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?
  cancelledBy    String?
  cancelledAt    DateTime?
  cancelReason   String?
  ledger         HrLeaveLedger[]

  @@unique([requestedBy, idempotencyKey])
  @@index([employeeId, startDate])
  @@index([status])
}

enum HrLeaveEntryType {
  OPENING
  ACCRUAL
  GRANT
  TAKE
  REVERSAL
  ADJUSTMENT
}

/// Append-only. Balance = SUM(days) over all rows, future-dated TAKEs included, which is
/// what makes overbooking impossible. Corrections are new rows.
model HrLeaveLedger {
  id            String           @id @default(cuid())
  employeeId    String
  employee      HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId   String
  leaveType     HrLeaveType      @relation(fields: [leaveTypeId], references: [id])
  entryType     HrLeaveEntryType
  days          Decimal          @db.Decimal(8, 2)
  effectiveDate DateTime         @db.Date
  requestId     String?
  request       HrLeaveRequest?  @relation(fields: [requestId], references: [id])
  /// Idempotency for the accrual job ("2026-09"); null for every other entry.
  accrualKey    String?
  reason        String?
  actorId       String?
  createdAt     DateTime         @default(now())

  @@unique([employeeId, leaveTypeId, accrualKey])
  @@index([employeeId, leaveTypeId])
}

// ── Payroll policy, settings and account map ────────────────────────────────────────

enum HrDayBasis {
  CALENDAR_DAYS
  FIXED_30
}

enum HrPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Effective-dated payroll policy. Activation needs a second person (four-eyes). A run
/// records the policy it used, so later edits never restate a paid month.
model HrPayrollPolicy {
  id                           String               @id @default(cuid())
  version                      Int                  @unique
  effectiveFrom                DateTime             @db.Date
  status                       HrPolicyStatus       @default(DRAFT)
  dayBasis                     HrDayBasis
  standardDailyHours           Decimal              @db.Decimal(5, 2)
  overtimeMultiplier           Decimal              @db.Decimal(5, 2)
  /// Cap on deductions as a percentage of gross for one payslip.
  maxDeductionPercent          Decimal              @db.Decimal(5, 2)
  /// Components (BASIC, HOUSING, TRANSPORT, OTHER) used for unpaid-leave deduction and
  /// for the overtime hourly rate.
  unpaidLeaveComponents        String[]
  overtimeComponents           String[]
  timezone                     String               @default("Asia/Riyadh")
  /// 0 = Sunday … 6 = Saturday.
  weekendDays                  Int[]
  /// Values are an unconfirmed proposal until the owner/accountant says otherwise.
  isProposal                   Boolean              @default(true)
  notes                        String?
  createdBy                    String
  createdAt                    DateTime             @default(now())
  activatedBy                  String?
  activatedAt                  DateTime?
  // ── P-2 findings 2/3 (migration 20261017100000_hr_p2_settlements). Accountant decisions:
  // every value below is NULL / empty until the accountant decides it, and payroll refuses to
  // build a run under a version where any is unset. `maxDeductionPercent` above is the OVERALL
  // cap; these add the per-category caps, which categories the overall cap covers, the order
  // deductions apply in, what happens when a cap is exceeded, and the deferral escalation count.
  /// false (default): the cap base is guaranteed pay only — commission, overtime and one-off
  /// earning adjustments are excluded. true only when the policy explicitly says so.
  capBaseIncludesVariable      Boolean              @default(false)
  /// Per-category caps, % of the cap base. NULL = not decided (payroll refuses to run).
  deductionCapUnearnedPercent  Decimal?             @db.Decimal(5, 2)
  deductionCapLoanPercent      Decimal?             @db.Decimal(5, 2)
  deductionCapStatutoryPercent Decimal?             @db.Decimal(5, 2)
  deductionCapOtherPercent     Decimal?             @db.Decimal(5, 2)
  /// Categories the overall cap (maxDeductionPercent) covers. Empty = not decided.
  deductionOverallCovers       String[]             @default([])
  /// All four categories in the order they apply. Empty = not decided.
  deductionPriority            String[]             @default([])
  /// WARN | BLOCK when a non-deferrable category exceeds its cap. NULL = not decided.
  deductionCapAction           String?
  /// CONSECUTIVE deferrals of one advance (approved runs) after which a review item is raised. NULL = not decided.
  advanceDeferralEscalateAfter Int?
  /// P-2 review P2-B7 (migration 20261017130000): the cap base is the wage due AFTER unearned pay
  /// (true) or before it (false). NULL = not decided (payroll refuses to run).
  capBaseAfterUnearned         Boolean?
  contributionRules            HrContributionRule[]
  runs                         HrPayrollRun[]

  @@index([status, effectiveFrom])
}

/// A configurable contribution (e.g. social insurance). NOTHING is seeded: rates must come
/// from an official source and be reviewed by the accountant before activation.
model HrContributionRule {
  id                  String          @id @default(cuid())
  policyId            String
  policy              HrPayrollPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  code                String
  nameAr              String
  employeeRatePercent Decimal         @db.Decimal(6, 3)
  employerRatePercent Decimal         @db.Decimal(6, 3)
  baseComponents      String[]
  /// Applies to people whose private contributionGroup equals this value.
  appliesToGroup      String
  monthlyBaseCap      Decimal?        @db.Decimal(18, 2)
  sourceNote          String
  createdAt           DateTime        @default(now())

  @@unique([policyId, code])
}

model HrSettings {
  id                    String   @id @default("singleton")
  /// When false, HR money events are recorded without journals and say so on every record.
  accountingEnabled     Boolean  @default(true)
  /// Phase 1 payroll lock (decision C GAP-9): live payroll. Off by default and in every seed /
  /// fixture end state; while off the payroll money actions are refused (application and DB). Turned
  /// on only by an applied two-person PAYROLL_LIVE_SET change while the readiness check is clean.
  payrollLive           Boolean  @default(false)
  payrollLiveChangeId   String?
  /// Phase 1 (owner decision D1, Option B): manual journals disabled — off by default, fail-closed;
  /// while off only the automatic HR posting workflow writes the ledger. Not writable by the runtime
  /// role (grant-hr-runtime.sql); enabled only by an owner-run Phase 2 migration.
  manualJournalsEnabled Boolean  @default(false)
  /// Document-expiry notifications (additive, 20261030090000_hr_expiry_email): the days before an
  /// expiry date at which the daily check notifies the employee and the HR holders (HR settings
  /// «تنبيهات انتهاء الوثائق»). CHECK: 1–10 entries, each 1–365. Expired items are reminded weekly.
  expiryAlertDays       Int[]    @default([60, 30, 14, 7, 1])
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

enum HrConfigChangeKind {
  ACCOUNT_MAP_SET
  ACCOUNTING_TOGGLE
  LEAVE_TYPE_CREATE
  /// Owner decision 1b: a grant of payroll-sensitive duties (or the admin role) to an account.
  PERMISSION_CHANGE
  /// An immediate revocation, acknowledged afterwards by another person (never blocks it).
  PERMISSION_REVIEW
  /// Owner decision 1 (Option A): a second person verifies a person's identity.
  PERSON_VERIFY
  /// Create / edit / link / unlink / deactivate an external person.
  EXTERNAL_PERSON_CHANGE
  /// An identifying change (name, identity document) of a verified or duty-holding employee.
  EMPLOYEE_IDENTITY_CHANGE
  /// A second-person, attested MFA reset (recovery codes lost).
  MFA_RESET
  /// P-2 / E-1: a second policy manager confirms a leave type that is still a proposal.
  LEAVE_TYPE_CONFIRM
  /// P-2: a second-person, attested payroll control decision (a correction under a proposal
  /// policy; accepting a full-period unpaid-leave remainder). Nothing is computed from it.
  PAYROLL_CONTROL_ATTEST
  /// P-2 rev3 item 3: enable / disable one case of the D-4h GOSI difference matrix (keys + decision).
  GOSI_TREATMENT_SET
  /// Phase 1 payroll lock: turn live payroll on / off (on only while the readiness check is clean).
  PAYROLL_LIVE_SET
}

enum HrConfigChangeStatus {
  PENDING
  APPLIED
  REJECTED
  WITHDRAWN
}

/// A requested change to HR accounting / leave configuration (owner decision F2) or a grant of
/// payroll-sensitive permissions to an account (owner decision 1b). Nothing is
/// applied when requested: a SECOND policy manager approves the exact fingerprint and the change
/// is applied in the same transaction. DB: decidedBy <> requestedBy; one PENDING per target
/// (partial unique index); a decided row never changes and no row is deleted (trigger).
model HrConfigChange {
  id              String               @id @default(cuid())
  kind            HrConfigChangeKind
  /// What it changes, e.g. "ACCOUNT_MAP:SALARY_EXPENSE", "SETTINGS:accountingEnabled", "LEAVE_TYPE:ANNUAL", "ACCOUNT:<employee id>".
  targetKey       String
  payload         Json
  /// The value in force when requested; approval is refused if it changed since (stale).
  before          Json?
  fingerprint     String
  reason          String
  status          HrConfigChangeStatus @default(PENDING)
  requestedBy     String
  requestedAt     DateTime             @default(now())
  /// Approver or rejecter: never the requester. Null while PENDING and for WITHDRAWN.
  decidedBy       String?
  decidedAt       DateTime?
  decisionNote    String?
  credentialStage HrCredentialStage?

  @@index([status, requestedAt])
  @@index([targetKey])
}

/// Owner decision 1 (Option A): a verified non-employee identity, e.g. an external accountant.
/// Never on payroll, never a payee, never a dummy employee record. Never deleted (trigger).
model HrExternalPerson {
  id           String    @id @default(cuid())
  fullName     String
  /// National ID / iqama / passport. Optional; unique in normal form when present.
  idNumber     String?
  /// hr_norm_id(idNumber), written by the database guard only.
  idNumberNorm String?
  organization String?
  roleNote     String?
  accountId    String?   @unique
  account      Employee? @relation("HrExternalPersonAccount", fields: [accountId], references: [id], onDelete: SetNull)
  active       Boolean   @default(true)
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
}

/// A second person's verification of a person's identity (EMPLOYEE = HrEmployee id, EXTERNAL =
/// HrExternalPerson id). One live row per person; revoked, never edited or deleted (trigger).
model HrIdentityVerification {
  id             String                @id @default(cuid())
  subjectType    String
  subjectId      String
  requestedBy    String
  /// Never the requester (CHECK).
  verifiedBy     String
  verifiedAt     DateTime              @default(now())
  configChangeId String?
  /// The login this verification attests; a login linked later is not verified until attested.
  accountId      String?
  note           String?
  revokedAt      DateTime?
  revokedBy      String?
  revokeReason   String?
  bootstraps     HrIdentityBootstrap[]

  @@index([subjectType, subjectId])
}

/// The one-time bootstrap of the verification register (never repeated, never changed).
model HrIdentityBootstrap {
  id             String                 @id @default("singleton")
  verificationId String
  verification   HrIdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy    String
  approvedBy     String
  completedAt    DateTime               @default(now())
}

/// Review item 4: the hashes of a pending credential change (never in the immutable request
/// payload). Deleted when the request is applied, rejected or withdrawn.
model HrCredentialStage {
  configChangeId String         @id
  configChange   HrConfigChange @relation(fields: [configChangeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  username       String?
  pin            String?
  pinLookup      String?
  password       String?
  createdAt      DateTime       @default(now())
}

/// Which chart-of-accounts account each HR posting key uses. No defaults: every key a
/// journal needs must be mapped explicitly or the posting is refused.
model HrAccountMap {
  key       String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  updatedBy String
  updatedAt DateTime @updatedAt
}

/// Phase 1 payroll lock (re-review R1): every (account, key) the HR posting map has EVER held —
/// written by the database (trigger on HrAccountMap), append-only. An account once mapped under a
/// payroll key stays a payroll account for the ledger lock (hr_is_payroll_account / payrollAccountIds).
model HrPayrollAccount {
  accountId   String
  key         String
  firstSeenAt DateTime @default(now())

  @@id([accountId, key])
}

/// Idempotency for every journal HR posts: one journal per (source, purpose).
model HrJournalLink {
  id             String                 @id @default(cuid())
  sourceType     String // PAYROLL_RUN | ADVANCE | ADVANCE_REPAYMENT
  sourceId       String
  purpose        String // ACCRUAL | PAYMENT | REVERSAL | DISBURSEMENT | REPAYMENT
  journalEntryId String                 @unique
  journalEntry   JournalEntry           @relation(fields: [journalEntryId], references: [id])
  /// P-2 / E-3: what the journal posted, per posting key and account, frozen with the link
  /// (null on links written before 20261017090000). Verified before the journal is relied on.
  postedLines    Json?
  createdAt      DateTime               @default(now())
  /// P-2 review P2-A4: the migration-time baseline of a link written before posted lines existed.
  baseline       HrJournalLinkBaseline?

  @@unique([sourceType, sourceId, purpose])
}

/// P-2 review P2-A4 (migration 20261017120000): for each HR journal link written BEFORE posted
/// lines were frozen, a one-time, append-only baseline captured at migration — the journal's lines
/// per account and side as they stood (with the posting key the account map resolved them to) and
/// the account map as it stood. Such links are verified against it. A snapshot, not an approval:
/// the accountant reviews it before production.
model HrJournalLinkBaseline {
  id             String        @id @default(cuid())
  linkId         String        @unique
  link           HrJournalLink @relation(fields: [linkId], references: [id], onDelete: Restrict)
  journalEntryId String
  /// [{ key, accountId, side: "D" | "C", amount }] — key "AMBIGUOUS:K1|K2" / "UNMAPPED" when the map did not name one key.
  lines          Json
  /// { key: accountId } as it stood when captured.
  accountMap     Json
  source         String
  capturedAt     DateTime      @default(now())
}

// ── Payroll runs ────────────────────────────────────────────────────────────────────

enum HrPayrollRunStatus {
  DRAFT
  REVIEW
  APPROVED
  PAID
  CANCELLED
}

model HrPayrollRun {
  id                     String                       @id @default(cuid())
  runNo                  Int                          @unique @default(autoincrement())
  /// "YYYY-MM"
  periodMonth            String
  periodStart            DateTime                     @db.Date
  periodEnd              DateTime                     @db.Date
  kind                   String                       @default("REGULAR") // REGULAR | CORRECTION
  correctsRunId          String?
  /// Branch scope of the run; "COMPANY" = every person regardless of branch.
  branchKey              String                       @default("COMPANY")
  status                 HrPayrollRunStatus           @default(DRAFT)
  policyId               String
  policy                 HrPayrollPolicy              @relation(fields: [policyId], references: [id])
  preparedBy             String
  preparedAt             DateTime                     @default(now())
  submittedBy            String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  paidAt                 DateTime?
  cancelledBy            String?
  cancelledAt            DateTime?
  cancelReason           String?
  totalGross             Decimal                      @default(0) @db.Decimal(18, 2)
  totalDeductions        Decimal                      @default(0) @db.Decimal(18, 2)
  totalNet               Decimal                      @default(0) @db.Decimal(18, 2)
  totalEmployer          Decimal                      @default(0) @db.Decimal(18, 2)
  accountingSkipped      Boolean                      @default(false)
  /// P-2 review P1-A1: the PAYROLL_CONTROL_ATTEST (proposal correction) this run relies on. Unique:
  /// an attestation serves one run and expires with it (a cancelled run spends it).
  controlAttestationId   String?                      @unique
  version                Int                          @default(1)
  lines                  HrPayrollLine[]
  payments               HrPayrollPayment[]
  paymentAllocations     HrPayrollPaymentAllocation[]
  paymentReturns         HrPayrollPaymentReturn[]
  bankImports            HrPayrollBankImport[]
  adjustments            HrPayrollAdjustment[]
  commissionReservations HrCommissionReservation[]
  reconNotes             HrPayrollReconNote[]

  @@index([periodMonth, status])
}

model HrPayrollLine {
  id          String                       @id @default(cuid())
  runId       String
  run         HrPayrollRun                 @relation(fields: [runId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    HrEmployee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Every input the calculation used (compensation versions, days, policy, rates), so a
  /// payslip can be explained years later without recomputing anything.
  snapshot    Json
  payableDays Decimal                      @db.Decimal(6, 2)
  gross       Decimal                      @db.Decimal(18, 2)
  deductions  Decimal                      @db.Decimal(18, 2)
  net         Decimal                      @db.Decimal(18, 2)
  employer    Decimal                      @default(0) @db.Decimal(18, 2)
  exceptions  Json
  blocking    Boolean                      @default(false)
  approvedBy  String?
  approvedAt  DateTime?
  items       HrPayrollItem[]
  payments    HrPayrollPayment[]
  allocations HrPayrollPaymentAllocation[]
  returns     HrPayrollPaymentReturn[]

  @@unique([runId, employeeId])
}

model HrPayrollItem {
  id          String        @id @default(cuid())
  lineId      String
  line        HrPayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  code        String
  kind        String // EARNING | DEDUCTION | EMPLOYER
  amount      Decimal       @db.Decimal(18, 2)
  quantity    Decimal?      @db.Decimal(12, 4)
  rate        Decimal?      @db.Decimal(18, 6)
  sourceType  String?
  sourceId    String?
  description String
  /// P-2 finding 3: the deduction category (UNEARNED_PAY | LOAN_RECOVERY | STATUTORY | OTHER) of a
  /// DEDUCTION item, and its position in the order deductions were applied. NULL on older items.
  category    String?
  applyOrder  Int?

  @@index([lineId])
}

/// One-off earning or deduction for a person in a DRAFT run (bonus, penalty, correction).
model HrPayrollAdjustment {
  id                String       @id @default(cuid())
  runId             String
  run               HrPayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  employeeId        String
  employee          HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind              String // EARNING | DEDUCTION
  amount            Decimal      @db.Decimal(18, 2)
  reason            String
  /// P-2 review P1-B2: a category from a CLOSED list (DB CHECK, src/lib/hr/adjustment-categories.ts).
  /// Never end of service / leave encashment / final settlement. Rows from before: OTHER_WITH_MEMO.
  category          String
  /// P-2 rev3 item 5 (migration 20261017190000): PRIOR_PERIOD_ARREARS / COMMISSION_TRUE_UP only — the
  /// document the amount rests on and the earlier period (YYYY-MM) it is owed for (DB CHECK).
  documentReference String?
  relatedPeriod     String?
  createdBy         String
  createdAt         DateTime     @default(now())

  @@index([runId])
}

/// Recorded payment of a run. The system never moves money.
model HrPayrollPayment {
  id             String                       @id @default(cuid())
  runId          String
  run            HrPayrollRun                 @relation(fields: [runId], references: [id], onDelete: Restrict)
  amount         Decimal                      @db.Decimal(18, 2)
  paidOn         DateTime                     @db.Date
  method         String // BANK_TRANSFER | CASH | CHEQUE
  reference      String
  recordedBy     String
  /// P-2: a retried request with the same key returns the payment already recorded.
  idempotencyKey String?
  /// P-2: the payslip line this payment settles (per-employee settlement), or null for a whole-run
  /// payment. A run is paid one way or the other, never both (DB trigger).
  lineId         String?
  line           HrPayrollLine?               @relation(fields: [lineId], references: [id], onDelete: Restrict)
  createdAt      DateTime                     @default(now())
  allocations    HrPayrollPaymentAllocation[]
  returns        HrPayrollPaymentReturn[]
  bankImports    HrPayrollBankImport[]

  @@unique([runId, idempotencyKey])
  @@index([lineId])
}

/// P-2 rev3 item 4 (migration 20261017180000, D-7g): the per-employee subledger of the EOS and leave
/// provisions. RECOGNITION (part of a POSTED journal's credit to the mapped provision account,
/// attributed to one employee) and ADJUSTMENT are requested by one person and APPROVED by another;
/// USAGE is written when a final settlement posts (one per settlement and provision). The employee's
/// balance (Σ APPROVED) never goes below zero (DB, under a per-employee lock). Append-only.
model HrProvisionLedger {
  id             String     @id @default(cuid())
  employeeId     String
  employee       HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// EOS_PROVISION | LEAVE_PROVISION
  provisionKey   String
  /// RECOGNITION | ADJUSTMENT | USAGE
  kind           String
  /// Signed: + adds to the employee's provision, − uses it.
  amount         Decimal    @db.Decimal(18, 2)
  /// PENDING | APPROVED | REJECTED
  status         String
  /// JOURNAL | MANUAL | FINAL_SETTLEMENT
  sourceType     String
  sourceId       String?
  journalEntryId String?
  reference      String
  reason         String?
  requestedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([employeeId, provisionKey], map: "HrProvisionLedger_employee_key_idx")
}

/// P-2 rev3 item 4 (D-7g): a settlement due more than the provision it uses is NOT expensed
/// automatically. Its shortfall blocks posting until a second person records the accountant's
/// decision for exactly that amount. Decided once; never deleted.
model HrProvisionShortfall {
  id                String            @id @default(cuid())
  settlementId      String
  settlement        HrFinalSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  employeeId        String
  provisionKey      String
  amount            Decimal           @db.Decimal(18, 2)
  /// The employee's approved provision balance when the shortfall was requested.
  employeeBalance   Decimal           @db.Decimal(18, 2)
  decisionReference String
  reason            String
  /// PENDING | APPROVED | REJECTED
  status            String            @default("PENDING")
  requestedBy       String
  decidedBy         String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime          @default(now())
}

/// P-2 rev3 item 2 (migration 20261017160000): proof that ONE employee line was credited from a
/// recorded payment — the line, the run, the payee and the bank reference of that credit. Entered
/// by hand, implied by a per-line payment, or read from an imported bank result file. Append-only;
/// Σ per payment ≤ the payment, Σ per line (net of returns) ≤ the line's net (DB). The bank reference
/// is unique (case-insensitive, DB expression index) so a retry or a re-import never records a second credit.
model HrPayrollPaymentAllocation {
  id                String                   @id @default(cuid())
  paymentId         String
  payment           HrPayrollPayment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  runId             String
  run               HrPayrollRun             @relation(fields: [runId], references: [id], onDelete: Restrict)
  lineId            String
  line              HrPayrollLine            @relation(fields: [lineId], references: [id], onDelete: Restrict)
  employeeId        String
  employee          HrEmployee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  amount            Decimal                  @db.Decimal(18, 2)
  bankReference     String
  /// The last four characters of the payee's account at the time of the credit (never the full IBAN).
  payeeAccountLast4 String?
  source            String // LINE_PAYMENT | MANUAL | BANK_IMPORT
  importId          String?
  bankImport        HrPayrollBankImport?     @relation(fields: [importId], references: [id], onDelete: Restrict)
  idempotencyKey    String?
  confirmedOn       DateTime                 @db.Date
  confirmedBy       String
  createdAt         DateTime                 @default(now())
  returns           HrPayrollPaymentReturn[]

  @@unique([runId, idempotencyKey])
  @@index([lineId])
  @@index([paymentId])
}

/// P-2 rev3 item 2: a credit the bank RETURNED (names the allocation; reopens the line) or a part of a
/// bulk payment the bank REJECTED before crediting the employee. Its journal is RETURN:<id>
/// (Dr PAYROLL_CASH / Cr SALARIES_PAYABLE). Append-only.
model HrPayrollPaymentReturn {
  id             String                      @id @default(cuid())
  runId          String
  run            HrPayrollRun                @relation(fields: [runId], references: [id], onDelete: Restrict)
  paymentId      String
  payment        HrPayrollPayment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocationId   String?                     @unique
  allocation     HrPayrollPaymentAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  lineId         String
  line           HrPayrollLine               @relation(fields: [lineId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       HrEmployee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind           String // RETURNED | REJECTED
  amount         Decimal                     @db.Decimal(18, 2)
  bankReference  String
  reason         String
  returnedOn     DateTime                    @db.Date
  importId       String?
  bankImport     HrPayrollBankImport?        @relation(fields: [importId], references: [id], onDelete: Restrict)
  idempotencyKey String?
  recordedBy     String
  createdAt      DateTime                    @default(now())

  @@unique([runId, idempotencyKey])
  @@index([lineId])
}

/// P-2 rev3 item 2: a bank RESULT file imported against one payment (never the file the system
/// exported). The same file (SHA-256) is imported once per run; a retry returns the first import.
model HrPayrollBankImport {
  id           String                       @id @default(cuid())
  runId        String
  run          HrPayrollRun                 @relation(fields: [runId], references: [id], onDelete: Restrict)
  paymentId    String
  payment      HrPayrollPayment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  fileName     String
  sha256       String
  content      String
  rowCount     Int
  paidRows     Int
  returnedRows Int
  recordedBy   String
  createdAt    DateTime                     @default(now())
  allocations  HrPayrollPaymentAllocation[]
  returns      HrPayrollPaymentReturn[]

  @@unique([runId, sha256])
}

/// P-2 / E-4: why a reconciliation difference exists. Append-only; never changes an amount.
model HrPayrollReconNote {
  id                String       @id @default(cuid())
  runId             String
  run               HrPayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  lineId            String?
  check             String
  differenceHalalas Int
  explanation       String
  recordedBy        String
  createdAt         DateTime     @default(now())

  @@index([runId])
}

/// A commission period (login account + Riyadh month) reserved for payment by a run.
/// At most one RESERVED row per (accountEmployeeId, periodStart) — partial unique index.
model HrCommissionReservation {
  id                String       @id @default(cuid())
  runId             String
  run               HrPayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  lineId            String?
  accountEmployeeId String
  periodStart       DateTime
  amount            Decimal      @db.Decimal(18, 2)
  status            String       @default("RESERVED") // RESERVED | SETTLED | RELEASED
  ledgerEntryId     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([accountEmployeeId, periodStart])
}

// ── Advances ────────────────────────────────────────────────────────────────────────

enum HrAdvanceStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
  CANCELLED
}

model HrAdvance {
  id                    String                     @id @default(cuid())
  advanceNo             String                     @unique
  employeeId            String
  employee              HrEmployee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  amount                Decimal                    @db.Decimal(18, 2)
  installmentCount      Int
  firstInstallmentMonth String
  reason                String
  status                HrAdvanceStatus            @default(REQUESTED)
  requestedBy           String
  createdAt             DateTime                   @default(now())
  decidedBy             String?
  decidedAt             DateTime?
  decisionNote          String?
  disbursedBy           String?
  disbursedAt           DateTime?
  disbursedOn           DateTime?                  @db.Date
  disbursementRef       String?
  closedBy              String?
  closedAt              DateTime?
  cancelReason          String?
  installments          HrAdvanceInstallment[]
  repayments            HrAdvanceRepayment[]
  recoveryRequests      HrAdvanceRecoveryRequest[]
  reviewItems           HrAdvanceReviewItem[]

  @@index([employeeId, status])
}

/// SCHEDULED → RESERVED (by exactly one run) → SETTLED (when that run is paid).
/// A cancelled run returns it to SCHEDULED. COVERED = paid off by a manual repayment.
/// P-2: RESCHEDULED = replaced by an approved reschedule (history, never changes);
/// HELD = taken out of payroll by an approved collection procedure (still owed; a repayment covers it).
model HrAdvanceInstallment {
  id                String    @id @default(cuid())
  advanceId         String
  advance           HrAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  seq               Int
  dueMonth          String
  amount            Decimal   @db.Decimal(18, 2)
  status            String    @default("SCHEDULED") // SCHEDULED | RESERVED | SETTLED | COVERED | RESCHEDULED | HELD
  /// The approved recovery request that created, replaced or held this installment.
  recoveryRequestId String?
  payrollRunId      String?
  payrollLineId     String?
  settledAt         DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([advanceId, seq])
  @@index([status, dueMonth])
}

model HrAdvanceRepayment {
  id         String    @id @default(cuid())
  advanceId  String
  advance    HrAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  amount     Decimal   @db.Decimal(18, 2)
  paidOn     DateTime  @db.Date
  method     String
  reference  String
  recordedBy String
  createdAt  DateTime  @default(now())
}

// ── P-2 settlements (migration 20261017100000_hr_p2_settlements) ───────────────────────────
// Controls only: no compensation formula, cap value or statutory rate is defined here.

/// A second-person procedure for an advance that payroll keeps deferring (P-2 finding 2):
/// RESCHEDULE the remaining installments, or COLLECTION (take them out of payroll and collect
/// them by an agreed method). Never a write-off. PENDING → APPLIED | REJECTED (another person)
/// | WITHDRAWN (requester). DB: four eyes; one PENDING per advance; content immutable; no delete.
model HrAdvanceRecoveryRequest {
  id           String    @id @default(cuid())
  advanceId    String
  advance      HrAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  /// RESCHEDULE | COLLECTION
  kind         String
  payload      Json
  /// Outstanding balance and remaining schedule when requested; approval is refused if they changed.
  before       Json
  fingerprint  String
  reason       String
  status       String    @default("PENDING") // PENDING | APPLIED | REJECTED | WITHDRAWN
  requestedBy  String
  requestedAt  DateTime  @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([advanceId, status])
}

/// Raised when an advance's installments have been deferred by payroll N times (N =
/// policy advanceDeferralEscalateAfter). OPEN until a recovery request is applied or a
/// reviewer records why none is needed. One OPEN item per advance; never deleted.
model HrAdvanceReviewItem {
  id                String    @id @default(cuid())
  advanceId         String
  advance           HrAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  reason            String // DEFERRAL_ESCALATION
  deferralCount     Int
  threshold         Int
  outstanding       Decimal   @db.Decimal(18, 2)
  status            String    @default("OPEN") // OPEN | RESOLVED
  createdBy         String
  createdAt         DateTime  @default(now())
  resolvedBy        String?
  resolvedAt        DateTime?
  resolutionNote    String?
  recoveryRequestId String?

  @@index([advanceId, status])
}

/// A GOSI invoice as received, per period (P-2 finding 4). Entered by hand or imported from
/// CSV; never edited — a wrong one is VOIDed (with a reason) and entered again.
model HrGosiInvoice {
  id                    String                 @id @default(cuid())
  periodMonth           String
  /// GOSI invoice number. Unique among live invoices; never reused for another month (DB).
  reference             String
  source                String // MANUAL | CSV
  status                String                 @default("ACTIVE") // ACTIVE | VOID
  totalEmployee         Decimal                @db.Decimal(18, 2)
  totalEmployer         Decimal                @db.Decimal(18, 2)
  notes                 String?
  enteredBy             String
  enteredAt             DateTime               @default(now())
  voidedBy              String?
  voidedAt              DateTime?
  voidReason            String?
  // ── P-2 review P2-B4 (migration 20261017130000): lifecycle and source file ──
  /// ENTERED → RECONCILED (every difference explained) → APPROVED (second person) → PAID (bank
  /// reference + payment journal) → CLOSED (every decision resolved). VOID only before APPROVED.
  stage                 String                 @default("ENTERED")
  reconciledBy          String?
  reconciledAt          DateTime?
  reconcileDigest       String?
  approvedBy            String?
  approvedAt            DateTime?
  approvalNote          String?
  paidBy                String?
  paidAt                DateTime?
  paidOn                DateTime?              @db.Date
  paidAmount            Decimal?               @db.Decimal(18, 2)
  paymentReference      String?
  paymentJournalEntryId String?                @unique
  closedBy              String?
  closedAt              DateTime?
  /// A void is requested by one person and decided by another.
  voidRequestedBy       String?
  voidRequestedAt       DateTime?
  voidRequestReason     String?
  /// The source as received: file name, SHA-256 and (CSV text) content.
  sourceFileName        String?
  sourceFileSha256      String?
  sourceContent         String?
  lines                 HrGosiInvoiceLine[]
  settlements           HrGosiSettlement[]
  /// P-2 rev3 item 3: what was actually paid to GOSI (bank reality), one row per transfer.
  payments              HrGosiInvoicePayment[]

  @@index([periodMonth, status])
}

/// P-2 rev3 item 3 (migration 20261017170000): an amount actually paid to GOSI for an invoice, with
/// its bank reference (unique) and its journal PAYMENT:<id>. Σ never above the invoice total; the
/// invoice is PAID when Σ = total — whatever the state of its differences. Append-only.
model HrGosiInvoicePayment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        HrGosiInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(18, 2)
  paidOn         DateTime      @db.Date
  bankReference  String
  idempotencyKey String
  recordedBy     String
  createdAt      DateTime      @default(now())

  @@unique([invoiceId, idempotencyKey])
}

/// P-2 rev3 item 3: the D-4h matrix — one row per case (nine, seeded DISABLED with no keys). A case is
/// enabled only by an applied two-person GOSI_TREATMENT_SET change naming both keys and the
/// accountant's decision reference (DB CHECK + guard). Rows are never added or removed.
model HrGosiTreatment {
  caseCode          String    @id
  /// Whether the case ever books an entry (5 and 6 never do).
  posting           Boolean
  enabled           Boolean   @default(false)
  debitKey          String?
  creditKey         String?
  decisionReference String?
  requestedBy       String?
  approvedBy        String?
  approvedAt        DateTime?
  configChangeId    String?
  updatedAt         DateTime  @default(now())
}

/// One person's share on the invoice. Append-only.
model HrGosiInvoiceLine {
  id               String        @id @default(cuid())
  invoiceId        String
  invoice          HrGosiInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  employeeId       String
  employee         HrEmployee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// EMPLOYEE | EMPLOYER
  share            String
  /// P-2 review P2-B4: subscriber scheme / category (matched to the person's contribution group)
  /// and branch (matched to the contribution rule code). "UNSPECIFIED" on lines from before.
  scheme           String
  branch           String
  amount           Decimal       @db.Decimal(18, 2)
  contributoryWage Decimal?      @db.Decimal(18, 2)
  days             Int?
  sourceRow        Int?

  @@unique([invoiceId, employeeId, scheme, branch, share])
}

/// A difference between the invoice and payroll for one person and share, with its
/// explanation and settlement action. Proposed by one person, decided by another. Approval
/// creates an HrGosiAdjustment; approved payroll is never edited.
model HrGosiSettlement {
  id               String            @id @default(cuid())
  invoiceId        String
  invoice          HrGosiInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  periodMonth      String
  employeeId       String
  employee         HrEmployee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  share            String
  /// P-2 review P2-B4: part of the matching key.
  scheme           String
  branch           String
  /// MISSING_IN_PAYROLL | MISSING_IN_INVOICE | WAGE_MISMATCH | DAYS_MISMATCH | RATE_MISMATCH | CATEGORY_MISMATCH | ROUNDING | AMOUNT_MISMATCH
  differenceType   String?
  invoiceAmount    Decimal           @db.Decimal(18, 2)
  payrollAmount    Decimal           @db.Decimal(18, 2)
  priorAdjustments Decimal           @db.Decimal(18, 2)
  difference       Decimal           @db.Decimal(18, 2)
  explanation      String
  /// EMPLOYER_EXPENSE | PAYROLL_CORRECTION | INVOICE_DISPUTE | NO_ADJUSTMENT | EMPLOYEE_RECEIVABLE | EMPLOYEE_REFUND
  action           String
  /// P-2 rev3 item 3: the D-4h case (src/lib/hr/gosi-treatments.ts). Null on decisions from before.
  treatmentCase    String?
  fingerprint      String
  status           String            @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN
  proposedBy       String
  proposedAt       DateTime          @default(now())
  decidedBy        String?
  decidedAt        DateTime?
  decisionNote     String?
  adjustment       HrGosiAdjustment?
  resolution       HrGosiResolution?

  @@index([periodMonth, employeeId, share])
}

/// P-2 review P2-B4: how an APPROVED settlement that is not borne by the employer was resolved.
/// PAYROLL_CORRECTION → the correction run; INVOICE_DISPUTE / NO_ADJUSTMENT → the outcome and its
/// reference. Until then the decision stays OPEN and the difference is NOT zeroed. Append-only.
model HrGosiResolution {
  id              String           @id @default(cuid())
  settlementId    String           @unique
  settlement      HrGosiSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  outcome         String
  correctionRunId String?
  reference       String
  note            String?
  resolvedBy      String
  createdAt       DateTime         @default(now())
}

/// The explicit record an approved GOSI settlement creates. Append-only.
model HrGosiAdjustment {
  id             String           @id @default(cuid())
  settlementId   String           @unique
  settlement     HrGosiSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  periodMonth    String
  employeeId     String
  employee       HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  share          String
  scheme         String
  branch         String
  amount         Decimal          @db.Decimal(18, 2)
  action         String
  journalEntryId String?
  /// P-2 rev3 item 3: the enabled case it was booked under and the keys it posted with (null before).
  treatmentCase  String?
  debitKey       String?
  creditKey      String?
  createdBy      String
  createdAt      DateTime         @default(now())

  @@index([periodMonth, employeeId])
}

// ── Assets, training, performance, incidents ────────────────────────────────────────

model HrAsset {
  id          String              @id @default(cuid())
  tag         String              @unique
  name        String
  category    String
  serialNo    String?
  status      String              @default("AVAILABLE") // AVAILABLE | ASSIGNED | RETIRED
  notes       String?
  createdAt   DateTime            @default(now())
  createdBy   String?
  assignments HrAssetAssignment[]
}

/// At most one open assignment per asset (partial unique index on returnedOn IS NULL).
model HrAssetAssignment {
  id           String     @id @default(cuid())
  assetId      String
  asset        HrAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employeeId   String
  employee     HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedOn   DateTime   @db.Date
  conditionOut String?
  assignedBy   String
  returnedOn   DateTime?  @db.Date
  conditionIn  String?
  returnedBy   String?
  createdAt    DateTime   @default(now())

  @@index([employeeId])
}

model HrTraining {
  id         String     @id @default(cuid())
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  title      String
  provider   String?
  startDate  DateTime   @db.Date
  endDate    DateTime?  @db.Date
  status     String     @default("PLANNED") // PLANNED | COMPLETED | CANCELLED
  notes      String?
  createdBy  String
  createdAt  DateTime   @default(now())
}

model HrReview {
  id                String     @id @default(cuid())
  employeeId        String
  employee          HrEmployee @relation("HrReviewSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  periodLabel       String
  /// Login account of the reviewer; never the subject's own login.

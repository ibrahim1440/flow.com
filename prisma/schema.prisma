  description  String
  actionTaken  String?
  confidential Boolean    @default(true)
  recordedBy   String
  createdAt    DateTime   @default(now())
}

// ── Recruitment ─────────────────────────────────────────────────────────────────────

model HrJobOpening {
  id           String        @id @default(cuid())
  code         String        @unique
  title        String
  departmentId String?
  department   HrDepartment? @relation(fields: [departmentId], references: [id])
  branchId     String?
  branch       FinBranch?    @relation("HrJobOpeningBranch", fields: [branchId], references: [id])
  openings     Int           @default(1)
  status       String        @default("OPEN") // OPEN | ON_HOLD | CLOSED
  createdBy    String
  createdAt    DateTime      @default(now())
  applicants   HrApplicant[]
}

enum HrApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model HrApplicant {
  id              String           @id @default(cuid())
  applicantNo     String           @unique
  openingId       String?
  opening         HrJobOpening?    @relation(fields: [openingId], references: [id])
  fullName        String
  email           String?
  phone           String?
  source          String?
  stage           HrApplicantStage @default(APPLIED)
  notes           String?
  /// Set once by conversion. Unique: an applicant becomes at most one person.
  hiredEmployeeId String?          @unique
  hiredEmployee   HrEmployee?      @relation("HrApplicantHire", fields: [hiredEmployeeId], references: [id])
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  interviews      HrInterview[]
  offers          HrOffer[]
}

model HrInterview {
  id                   String      @id @default(cuid())
  applicantId          String
  applicant            HrApplicant @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  scheduledAt          DateTime
  kind                 String
  interviewerAccountId String?
  outcome              String      @default("PENDING") // PENDING | PASS | FAIL | NO_SHOW
  notes                String?
  createdBy            String
  createdAt            DateTime    @default(now())
}

model HrOffer {
  id             String         @id @default(cuid())
  applicantId    String
  applicant      HrApplicant    @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  jobTitle       String
  basic          Decimal        @db.Decimal(18, 2)
  housing        Decimal        @default(0) @db.Decimal(18, 2)
  transport      Decimal        @default(0) @db.Decimal(18, 2)
  otherAllowance Decimal        @default(0) @db.Decimal(18, 2)
  startDate      DateTime       @db.Date
  contractType   HrContractType
  contractMonths Int?
  probationDays  Int?
  noticeDays     Int            @default(30)
  status         String         @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | WITHDRAWN
  createdBy      String
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?
}

// ── Offboarding ─────────────────────────────────────────────────────────────────────

model HrSeparation {
  id                  String              @id @default(cuid())
  employeeId          String
  employee            HrEmployee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type                String // RESIGNATION | TERMINATION | END_OF_CONTRACT | OTHER
  noticeDate          DateTime            @db.Date
  lastWorkingDay      DateTime            @db.Date
  reason              String
  status              String              @default("INITIATED") // INITIATED | COMPLETED | CANCELLED
  /// Entered, never computed: no end-of-service formula ships until it is approved.
  eosAmount           Decimal?            @db.Decimal(18, 2)
  eosBasisNote        String?
  leaveEncashmentDays Decimal?            @db.Decimal(6, 2)
  otherSettlement     Decimal?            @db.Decimal(18, 2)
  settlementNotes     String?
  finalSettlements    HrFinalSettlement[]
  deactivateAccount   Boolean             @default(true)
  initiatedBy         String
  createdAt           DateTime            @default(now())
  completedBy         String?
  completedAt         DateTime?
  cancelledBy         String?
  cancelledAt         DateTime?

  @@index([employeeId, status])
}

/// End-of-service and leave-encashment FINANCIAL settlement (P-2 finding 8, E-7). Interim
/// manual procedure: the amounts are calculated by hand outside the system and evidenced here;
/// no formula is automated. Separate from ending the employment (HrSeparation).
///   DRAFT → CALCULATED (inputs, method, worksheet document) → REVIEWED (independent person,
///   attested) → APPROVED → POSTED (journal entry) → PAID (proof document) → CLOSED;
///   DRAFT…APPROVED → CANCELLED. CALCULATED → DRAFT when the reviewer returns it.
/// DB: evidence per status (CHECKs), forward-only transitions, evidence frozen once reviewed, no delete.
model HrFinalSettlement {
  id                     String                 @id @default(cuid())
  settlementNo           String                 @unique
  separationId           String
  separation             HrSeparation           @relation(fields: [separationId], references: [id], onDelete: Restrict)
  employeeId             String
  employee               HrEmployee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  status                 String                 @default("DRAFT")
  preparedBy             String
  createdAt              DateTime               @default(now())
  // CALCULATED (manual)
  eosAmount              Decimal?               @db.Decimal(18, 2)
  leaveEncashmentDays    Decimal?               @db.Decimal(6, 2)
  leaveEncashmentAmount  Decimal?               @db.Decimal(18, 2)
  totalAmount            Decimal?               @db.Decimal(18, 2)
  /// Service dates, wage used, separation type, days… exactly as the preparer used them.
  calcInputs             Json?
  calcMethodNote         String?
  calcReference          String?
  calcDocumentId         String?
  calcDocument           HrDocument?            @relation("HrSettlementCalcDoc", fields: [calcDocumentId], references: [id], onDelete: Restrict)
  /// A recognised liability (provision) the settlement is booked against, if one exists.
  eosProvisionAmount     Decimal?               @db.Decimal(18, 2)
  leaveProvisionAmount   Decimal?               @db.Decimal(18, 2)
  provisionReference     String?
  calculatedBy           String?
  calculatedAt           DateTime?
  // REVIEWED
  reviewedBy             String?
  reviewedAt             DateTime?
  reviewAttestation      String?
  // APPROVED
  approvedBy             String?
  approvedAt             DateTime?
  approvalNote           String?
  // POSTED
  postingMode            String? // SYSTEM | MANUAL
  journalEntryId         String?                @unique
  postedBy               String?
  postedAt               DateTime?
  // PAID
  paidAmount             Decimal?               @db.Decimal(18, 2)
  paidOn                 DateTime?              @db.Date
  paymentReference       String?
  paymentProofDocumentId String?
  paymentProofDocument   HrDocument?            @relation("HrSettlementProofDoc", fields: [paymentProofDocumentId], references: [id], onDelete: Restrict)
  paymentJournalEntryId  String?                @unique
  paidBy                 String?
  paidAt                 DateTime?
  // CLOSED / CANCELLED
  closedBy               String?
  closedAt               DateTime?
  closingNote            String?
  cancelledBy            String?
  cancelledAt            DateTime?
  cancelReason           String?
  /// P-2 rev3 item 4 (D-7g): decisions on a shortfall of the employee's own provision.
  provisionShortfalls    HrProvisionShortfall[]

  @@index([employeeId, status])
  @@index([separationId])
}

// ── Audit ───────────────────────────────────────────────────────────────────────────

/// Append-only (trigger). Every HR write and every read of private data or documents.
model HrAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  employeeId String?
  before     Json?
  after      Json?
  reason     String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([employeeId, createdAt])
  @@index([createdAt])
}

// ── Printing (G-20 / G-21 Universal Printing System, owner decisions A-1…A-8, B-1…B-10) ─────
// Additive. Geometry in millimetres; ranges enforced by CHECK constraints in the migration
// (20261016150000_print_system) and by src/lib/print/profiles.ts. See erp/docs/print/PRINT-SYSTEM.md.

/// A paper / label stock profile. Presets (isPreset, presetKey) are read-only starting points.
model PrintProfile {
  id               String                @id @default(cuid())
  name             String
  /// A4_PLAIN | A4_SHEET | THERMAL_ROLL | CUSTOM
  kind             String
  paperWidthMm     Float
  paperHeightMm    Float
  labelWidthMm     Float
  labelHeightMm    Float
  marginTopMm      Float                 @default(0)
  marginLeftMm     Float                 @default(0)
  marginRightMm    Float                 @default(0)
  marginBottomMm   Float                 @default(0)
  gapXMm           Float                 @default(0)
  gapYMm           Float                 @default(0)
  columns          Int                   @default(1)
  rows             Int                   @default(1)
  /// PORTRAIT | LANDSCAPE
  orientation      String                @default("PORTRAIT")
  scalePct         Int                   @default(100)
  dpi              Int                   @default(203)
  offsetXMm        Float                 @default(0)
  offsetYMm        Float                 @default(0)
  defaultStartSlot Int                   @default(1)
  defaultCopies    Int                   @default(1)
  isPreset         Boolean               @default(false)
  presetKey        String?               @unique
  /// Employee.id, denormalized — no FK, so the profile survives the employee row.
  ownerId          String?
  ownerName        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  templatePresets  PrintTemplatePreset[]

  @@index([isPreset])
}

/// A saved label-content configuration for one template (fields shown and their order, language).
model PrintTemplatePreset {
  id                        String        @id @default(cuid())
  name                      String
  /// COFFEE_ORIGIN | CUPPING_RESULTS | GREEN_LOT | MATERIAL_SHELF
  templateKey               String
  /// AR | EN | BI
  language                  String
  /// [{ key, show }] in print order
  fields                    Json
  /// null = by label size (3 per language bilingual, 2 single-language, 2 on 50 × 30, 6 on A4 plain)
  notesMaxLines             Int?
  showLogo                  Boolean       @default(true)
  /// Owner decision 2.1: named scorer attribution needs the labels.cupping_named_scorers
  /// permission AND this privacy confirmation on the preset (who confirmed, when). Null = anonymous.
  namedScorersConfirmedAt   DateTime?
  namedScorersConfirmedById String?
  profileId                 String?
  profile                   PrintProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  ownerId                   String?
  ownerName                 String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([templateKey])
}

/// Singleton. Administrator-configurable print job cap (orchestrator decision: default 200 labels
/// per job; enforced by the server; CHECK 1–2000, the hard engine ceiling).
model PrintSettings {
  id              String   @id @default("singleton")
  maxLabelsPerJob Int      @default(200)
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

/// Append-only (DB trigger). Authorized print jobs and profile / preset changes. References and
/// counts only — never scores, notes or label text.
model PrintAuditLog {
  id          String   @id @default(cuid())
  /// PRINT_JOB | PROFILE_CREATED | PROFILE_UPDATED | PROFILE_DELETED | PRESET_CREATED | PRESET_UPDATED | PRESET_DELETED | SETTINGS_UPDATED
  action      String
  actorId     String?
  actorName   String?
  templateKey String?
  language    String?
  profileId   String?
  profileName String?
  /// Geometry snapshot of the profile used.
  profile     Json?
  /// [{ kind, id, copies }]
  items       Json?
  itemCount   Int      @default(0)
  copiesTotal Int      @default(0)
  totalLabels Int      @default(0)
  totalPages  Int      @default(0)
  startSlot   Int?
  warnings    Json?
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ─── Roasting schedule (RM6–RM8; ROASTERS.md §4–§6; migration 20261026090000_roast_schedule) ───

/// «اعتماد الخطة» (RM7): the slots approved together for one coffee on one roaster. A plan only
/// reserves slots — it creates no batch, moves no stock and changes no order (§5.9). Append-only:
/// the quantities the planner showed are kept as they were at approval.
model RoastPlan {
  id              String          @id @default(cuid())
  productId       String
  product         CoffeeProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  roasterId       String
  roaster         Roaster         @relation(fields: [roasterId], references: [id], onDelete: Restrict)
  /// Employee id (no FK, audit convention): the operator the plan was made for.
  operatorId      String
  /// DEMAND (the roast queue's requirement) | STOCK (no open demand: production › roast_to_stock)
  purpose         String          @default("DEMAND")
  /// PROPOSED | ALTERNATIVE (§5.2: the redistributed split, or «البديل»)
  split           String          @default("PROPOSED")
  batchCount      Int
  /// The sum of the slots' planned green (kg).
  greenKg         Decimal         @db.Decimal(10, 3)
  /// «الأخضر للتخطيط» as the planner computed it (§5.1). Differs from greenKg only by an authorized
  /// planning decision (§5.3), which carries overrideReason.
  computedGreenKg Decimal         @db.Decimal(10, 3)
  overrideReason  String?
  /// The planner's inputs at approval (remaining, required green, in progress, approved, loss).
  inputs          Json
  approvedById    String?
  approvedByName  String?
  createdAt       DateTime        @default(now())
  slots           ScheduledSlot[]

  @@index([productId, createdAt])
  @@index([roasterId, createdAt])
}

/// A planned roast slot — never a batch (ROASTERS.md §4 ScheduledSlot). Planned green lives here;
/// actual green, roasted and waste kg live only on the RoastingBatch recorded from it.
/// Stored status: PLANNED | IN_PROGRESS | RECORDED | CANCELLED. MISSED is derived on read (a
/// planned slot whose end has passed with no batch; a started one at the end of its Riyadh day),
/// never stored, so no job is needed (src/lib/services/schedule/planner.ts effectiveStatus).
/// A roaster, and an operator across all roasters, has at most one live slot at any moment —
/// checked in one transaction under an advisory lock (§5.5, §5.6).
model ScheduledSlot {
  id             String         @id @default(cuid())
  planId         String?
  plan           RoastPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  roasterId      String
  roaster        Roaster        @relation(fields: [roasterId], references: [id], onDelete: Restrict)
  /// Employee id (no FK, audit convention): assigned to this roaster (RoasterOperator) and holding
  /// production › start_batch when the slot was planned or reassigned.
  operatorId     String
  productId      String
  product        CoffeeProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// DEMAND | STOCK
  purpose        String         @default("DEMAND")
  startsAt       DateTime
  /// startsAt + the roaster's cycle at planning time; a later cycle change never moves it (§5.11).
  endsAt         DateTime
  plannedGreenKg Decimal        @db.Decimal(10, 3)
  status         String         @default("PLANNED")
  startedAt      DateTime?
  startedById    String?
  recordedAt     DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  batch          RoastingBatch?

  @@index([roasterId, startsAt])
  @@index([operatorId, startsAt])
  @@index([productId, status])
  @@index([status, endsAt])
  @@index([planId])
}

/// Append-only (by the application; no FK, audit convention) trail of the schedule: every plan
/// approval and every slot move, reassignment, start, link and cancellation, with before / after.
model ScheduleEvent {
  id        String   @id @default(cuid())
  /// PLAN_APPROVED | SLOT_MOVED | SLOT_REASSIGNED | SLOT_STARTED | SLOT_LINKED | SLOT_CANCELLED
  action    String
  planId    String?
  slotId    String?
  before    Json?
  after     Json?
  reason    String?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([slotId, createdAt])
  @@index([planId])
  @@index([createdAt])
}

/// A small incident record that deduplicates system alerts (additive, 20261028100000_credit_hold):
/// at most one OPEN incident per kind (partial unique index). BLOB_STORAGE: the private Blob store
/// of the customer files failed (UPLOAD_FAILED / DOWNLOAD_FAILED / DELETE_FAILED) or is not
/// configured in production (NOT_CONFIGURED). Counts what went to the DB fallback or was refused
/// meanwhile; resolved by the next successful Blob operation (services/system/storage-alerts.ts).
model SystemIncident {
  id            String    @id @default(cuid())
  /// BLOB_STORAGE (CHECK).
  kind          String
  /// OPEN | RESOLVED (CHECK).
  status        String    @default("OPEN")
  /// UPLOAD_FAILED | DOWNLOAD_FAILED | DELETE_FAILED | NOT_CONFIGURED (CHECK).
  cause         String
  /// The error's name / code — never a secret, a token or a URL.
  detail        String?
  openedAt      DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  occurrences   Int       @default(1)
  fallbackCount Int       @default(0)
  refusedCount  Int       @default(0)
  /// When the incident alert went out (NULL: suppressed by the cooldown).
  alertedAt     DateTime?
  resolvedAt    DateTime?

  @@index([kind, openedAt])
}

/// An in-app system alert («التنبيهات», the bell) for the accounts that hold Settings at edit —
/// the system had no in-app notification mechanism. Also e-mailed when an e-mail provider is
/// configured (lib/notify/email.ts). Read state is shared. Additive, 20261028100000_credit_hold.
model SystemAlert {
  id              String    @id @default(cuid())
  /// STORAGE_INCIDENT | STORAGE_RECOVERED (CHECK).
  kind            String
  /// danger | warning | success | info (CHECK).
  severity        String
  incidentId      String?
  titleAr         String
  titleEn         String
  bodyAr          String
  bodyEn          String
  /// SENT | FAILED | NOT_CONFIGURED | NO_RECIPIENTS (CHECK).
  emailStatus     String    @default("NOT_CONFIGURED")
  emailRecipients Int       @default(0)
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  readById        String?

  @@index([createdAt])
}

/// «التنبيهات» — one in-app notification for ONE account (additive, 20261029090000_notifications).
/// Written by lib/notifications/notify.ts from the one event catalogue (lib/notifications/catalog.ts),
/// in the transaction of the change it describes wherever that change has one. Never deleted on
/// read; rows older than 90 days are removed (lib/notifications/retention.ts). The recipient's own
/// rows only: every route filters by the session's account, never by a client-sent id.
model Notification {
  id             String    @id @default(cuid())
  recipientId    String
  recipient      Employee  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// The catalogue key (sales.quote_decided, hr.payslip_issued, …; CHECK on shape).
  kind           String
  /// sales | production | quality | finance | hr | me | system (CHECK).
  category       String
  /// info | success | warning | danger (CHECK).
  severity       String    @default("info")
  titleAr        String
  titleEn        String
  bodyAr         String    @default("")
  bodyEn         String    @default("")
  /// An app path (starts with /dashboard; CHECK), or NULL.
  link           String?
  entityType     String?
  entityId       String?
  /// Who did it (never a recipient of their own act). No FK: the actor may be deleted.
  actorId        String?
  /// The event instance: unique per recipient, so one event never produces two rows for one person.
  /// Also groups the e-mail of one event (at most one immediate e-mail per event).
  dedupeKey      String
  /// NONE (no e-mail for this row) | PENDING | SENDING | SENT | FAILED | OFF (the person's choice) |
  /// NO_ADDRESS | NOT_CONFIGURED | EXPIRED (CHECK).
  emailState     String    @default("NONE")
  emailClaimedAt DateTime?
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, category, createdAt])
  @@index([createdAt])
}

/// A person's e-mail choice for one notification category (additive, 20261029090000_notifications).
/// In-app is always on. No row = the category's default (lib/notifications/catalog.ts EMAIL_DEFAULT).
model NotificationPreference {
  employeeId String
  employee   Employee @relation("NotificationPreferenceOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  /// sales | production | quality | finance | hr | me | system (CHECK).
  category   String
  email      Boolean
  updatedAt  DateTime @updatedAt

  @@id([employeeId, category])
}

/// The last notified state of something whose state is DERIVED, not stored (additive,
/// 20261029090000_notifications): a customer's credit standing («credit:<customerId>» → "OVER_LIMIT,OVERDUE").
/// A notification goes out only when the state CHANGES — never a daily repeat.
model NotificationWatch {
  key       String   @id
  state     String
  updatedAt DateTime @updatedAt
}

// ─── QC station W3 · roast profiles, QC specifications, exceptions, dispositions (additive) ─────
// Migration 20261031090000_station_w3_qc. Owner decisions of 23 Oct 2026 (OWNER-REQUIREMENTS).

/// A roast profile: one coffee product (optionally one green coffee) roasted one way. Its colour
/// reference lives on its versions; there is no general target for a crop.
model RoastProfile {
  id            String                @id @default(cuid())
  productId     String
  product       CoffeeProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// NULL = every green lot of the product.
  greenBeanId   String?
  greenBean     GreenBean?            @relation(fields: [greenBeanId], references: [id], onDelete: Restrict)
  name          String
  notes         String?
  /// ACTIVE | ARCHIVED
  status        String                @default("ACTIVE")
  createdById   String?
  createdByName String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  versions      RoastProfileVersion[]

  @@index([productId, status])
}

/// One version of a profile. DRAFT (development: trial readings set the target and tolerance) →
/// APPROVED (spec frozen: whole and ground target ± tolerance, device, scale, sensory requirements;
/// approval needs a sensory evaluation) → RETIRED (when a newer version is approved). One APPROVED
/// version per profile (partial unique index); the spec of a non-DRAFT version cannot change (trigger).
model RoastProfileVersion {
  id                   String              @id @default(cuid())
  profileId            String
  profile              RoastProfile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  version              Int
  /// DRAFT | APPROVED | RETIRED
  status               String              @default("DRAFT")
  wholeTarget          Float?
  wholeTol             Float?
  groundTarget         Float?
  groundTol            Float?
  device               String?
  scale                String?
  sensoryRequirements  String?
  notes                String?
  /// The sensory evaluation of the approval (required): CONFORMING, with its notes.
  approvalSensory      String?
  approvalSensoryNotes String?
  approvedAt           DateTime?
  approvedById         String?
  approvedByName       String?
  retiredAt            DateTime?
  retiredById          String?
  createdById          String?
  createdByName        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  trials               RoastProfileTrial[]
  batches              RoastingBatch[]

  @@unique([profileId, version])
  @@index([status])
}

/// A TRIAL reading during development: whole and ground colour of a trial roast, with the device
/// and scale, and the sensory note. Trials guide the target and tolerance; they judge nothing.
model RoastProfileTrial {
  id             String              @id @default(cuid())
  versionId      String
  version        RoastProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          RoastingBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  colorWhole     Float
  colorGround    Float
  device         String
  scale          String
  sensoryResult  String?
  notes          String?
  recordedById   String
  recordedByName String
  createdAt      DateTime            @default(now())

  @@index([versionId, createdAt])
}

/// «طلب استثناء» (QX-01…06): a held batch, outside its APPROVED spec, released for a stated use by
/// a person other than the inspector and the requester (qc › approve_exception, privileged, step-up).
/// Never for foreign objects / contamination. Pending or rejected requests never change availability.
model QcException {
  id                   String        @id @default(cuid())
  /// QEX-YYYY-NNNN
  number               String        @unique
  batchId              String
  batch                RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  qcRecordId           String
  inspectorId          String?
  inspectorName        String?
  /// TASTE_ACCEPTED | BLEND_SUITABLE | CUSTOMER_APPROVAL | OTHER
  reason               String
  reasonNote           String?
  quantityKg           Float
  /// GENERAL | CUSTOMER | INTERNAL
  permittedUse         String
  permittedUseNote     String?
  measurementsSnapshot Json
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status               String        @default("PENDING")
  requestedById        String
  requestedByName      String
  stationId            String?
  requestKey           String        @unique
  decidedById          String?
  decidedByName        String?
  decisionReason       String?
  decidedAt            DateTime?
  decisionKey          String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([batchId])
}

/// The disposition of a held batch other than re-inspection and exception: CONVERT to another product
/// (meets that product's APPROVED spec), BLEND by an approved recipe (sources traced, output to QC),
/// DESTROY (reason, quantity; the roasted coffee leaves through a LOSS movement). Requested by QC
/// (qc › manage), decided by another person (qc › dispose, privileged, step-up, never the requester
/// or the inspector). Never CONVERT or BLEND for foreign objects.
model QcDisposition {
  id              String        @id @default(cuid())
  /// QDP-YYYY-NNNN
  number          String        @unique
  batchId         String
  batch           RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  qcRecordId      String?
  inspectorId     String?
  /// CONVERT | BLEND | DESTROY
  kind            String
  /// PENDING | APPROVED | REJECTED | EXECUTED | WITHDRAWN
  status          String        @default("PENDING")
  quantityKg      Float
  reason          String
  targetProductId String?
  targetVersionId String?
  /// CONVERT: the server's check of the batch's readings against the target's approved spec.
  conformity      Json?
  /// BLEND: the recipe — [{ batchId, batchNumber, quantityKg }] partners and the held quantity.
  recipe          Json?
  blendBatchId    String?
  movementId      String?
  requestedById   String
  requestedByName String
  requestKey      String        @unique
  decidedById     String?
  decidedByName   String?
  decisionReason  String?
  decidedAt       DateTime?
  executedAt      DateTime?
  executedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([batchId])
}

// ═════════════════════════════════════════════════════════════════════════════════════
//  SALES INVOICING + ACCOUNTS RECEIVABLE — accounting phase A2 (additive,
//  migration 20261103090000_sales_invoicing). docs/accounting/POSTING-CONTRACT.md §4, §7a.
//
//  • A tax invoice (STANDARD, B2B) or simplified tax invoice (SIMPLIFIED, B2C), a credit note or a
//    debit note — one table, `kind`. A note always names its original and carries a reason.
//  • DRAFT → ISSUED (immutable; the database numbers it gaplessly per series and refuses every later
//    change except the A4 ZATCA columns) or DRAFT → CANCELLED. An issued document is corrected only
//    by a credit / debit note.
//  • Customer, order, order line and delivery are plain ids (no foreign keys), like the ledger's
//    dimensions: a legal document outlives a reset of operational data. The issued snapshot carries
//    every particular the document states.
//  • Money Decimal(18,2); VAT per E-10: per (category, rate), on the taxable total, rounded once.
// ═════════════════════════════════════════════════════════════════════════════════════

model SalesInvoice {
  id                 String         @id @default(cuid())
  tenantId           String         @default("hiqbah")
  /// The document UUID (ZATCA cbc:UUID), set by the database at creation, never changed.
  uuid               String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// INVOICE | CREDIT_NOTE | DEBIT_NOTE (CHECK) — ZATCA 388 / 381 / 383.
  kind               String         @default("INVOICE")
  /// STANDARD (tax invoice, B2B, 0100000) | SIMPLIFIED (simplified tax invoice, B2C, 0200000).
  family             String         @default("STANDARD")
  /// DRAFT | ISSUED | CANCELLED (CHECK). CANCELLED only from DRAFT.
  status             String         @default("DRAFT")
  /// Set at issue: the series (prefix) the number comes from; seq and number by the database.
  series             String?
  seq                Int?
  number             String?
  customerId         String
  orderId            String?
  quoteId            String?
  /// A credit / debit note: the invoice it corrects (ZATCA BillingReference).
  originalInvoiceId  String?
  originalInvoice    SalesInvoice?  @relation("InvoiceNotes", fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  notesIssued        SalesInvoice[] @relation("InvoiceNotes")
  /// A note's reason code (RETURN | PRICE_ADJUSTMENT | DISCOUNT | CANCELLATION | AMENDMENT | OTHER) and text (KSA-10).
  reasonCode         String?
  reason             String?
  /// The Riyadh business day and time of issue (ZATCA IssueDate / IssueTime, AST).
  issueDate          DateTime?      @db.Date
  issueTime          String?
  issuedAt           DateTime?
  /// The supply date (KSA-5) and, for a continuous supply, its end (KSA-24).
  supplyDate         DateTime?      @db.Date
  supplyEndDate      DateTime?      @db.Date
  dueDate            DateTime?      @db.Date
  paymentTermsDays   Int?
  currency           String         @default("SAR")
  /// Σ line net (after line discounts) · Σ line discounts · taxable · VAT (E-10) · payable.
  lineExtensionTotal Decimal        @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal        @default(0) @db.Decimal(18, 2)
  taxableTotal       Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal        @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal        @default(0) @db.Decimal(18, 2)
  /// [{ category, rate, taxable, tax, exemptionReasonCode, exemptionReason }] — the VAT breakdown.
  taxBreakdown       Json?
  /// The buyer's particulars (name, VAT, CR, structured address): editable on a draft, frozen at issue.
  buyer              Json
  /// The seller's particulars, frozen at issue (NULL on a draft).
  seller             Json?
  notes              String?
  /// MANUAL | ORDER | DELIVERY — how the draft was opened.
  source             String         @default("MANUAL")
  /// Idempotent creation (an automatic draft per delivery: "delivery:<id>"; a client key otherwise).
  requestKey         String?        @unique
  createdById        String
  issuedById         String?
  /// SIMPLE MODE: a credit / debit note issued by its own preparer (four-eyes bypassed, recorded).
  sodBypass          Boolean        @default(false)
  cancelledAt        DateTime?
  cancelledById      String?
  cancelReason       String?
  // ── A4 (ZATCA Phase 2) placeholders: nullable; nothing writes them in A2 ──
  zatcaIcv           BigInt?
  zatcaPih           String?
  zatcaInvoiceHash   String?
  zatcaQr            String?
  zatcaStatus        String?
  zatcaXmlRef        String?
  // ── A4: an invoice created from an external order source (e.g. the Salla web shop, later) ──
  /// The sales channel the document came from (e.g. SALLA, WEBSITE, CAFE), with the order reference there:
  /// one document per (channel, external order) — a second request for the same order returns the first.
  channel            String?
  externalOrderRef   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  lines              SalesInvoiceLine[]
  applications       ArApplication[]    @relation("ArTarget")
  creditApplications ArApplication[]    @relation("ArCreditSource")

  @@unique([tenantId, number])
  @@unique([tenantId, channel, externalOrderRef])
  @@index([customerId, status])
  @@index([orderId])
  @@index([originalInvoiceId])
  @@index([kind, status, createdAt])
  @@index([status, issueDate])
}

model SalesInvoiceLine {
  id                  String             @id @default(cuid())
  tenantId            String             @default("hiqbah")
  invoiceId           String
  invoice             SalesInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position            Int                @default(0)
  /// The order line it invoices (over-invoicing is refused by the database), the delivery it came from.
  orderItemId         String?
  deliveryId          String?
  productSkuId        String?
  /// A note's line: the original invoice line it credits / debits (a credit is capped by it).
  originalLineId      String?
  originalLine        SalesInvoiceLine?  @relation("NoteLines", fields: [originalLineId], references: [id], onDelete: Restrict)
  noteLines           SalesInvoiceLine[] @relation("NoteLines")
  description         String
  descriptionEn       String?
  skuCode             String?
  quantity            Decimal            @db.Decimal(12, 3)
  /// UNIT | KG
  unit                String             @default("UNIT")
  unitPrice           Decimal            @db.Decimal(18, 2)
  discountPercent     Decimal            @default(0) @db.Decimal(5, 2)
  discountAmount      Decimal            @default(0) @db.Decimal(18, 2)
  /// S | Z | E | O (UNCL5305), with the exemption reason (code + text) for Z / E / O.
  taxCategory         String             @default("S")
  taxRatePercent      Decimal            @default(15) @db.Decimal(5, 2)
  exemptionReasonCode String?
  exemptionReason     String?
  /// round(qty × price) − discount; the line VAT is informational (KSA-11), the document's is E-10.
  lineNet             Decimal            @db.Decimal(18, 2)
  lineTax             Decimal            @db.Decimal(18, 2)
  lineTotal           Decimal            @db.Decimal(18, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([invoiceId, position])
  @@index([orderItemId])
  @@index([originalLineId])
}

/// One gapless counter per (tenant, series), advanced by the database inside the issue transaction.
model SalesDocumentCounter {
  tenantId String @default("hiqbah")
  series   String
  value    Int    @default(0)

  @@id([tenantId, series])
}

/// AR matching: a receipt (an APPROVED SalesCollection) or a credit note's credit applied to an
/// invoice / debit note of the same customer. Never edited: an application is REVERSED (unapplied).
/// The database refuses applying more than the receipt / credit holds or more than the invoice owes.
model ArApplication {
  id            String           @id @default(cuid())
  tenantId      String           @default("hiqbah")
  customerId    String
  invoiceId     String
  invoice       SalesInvoice     @relation("ArTarget", fields: [invoiceId], references: [id], onDelete: Restrict)
  collectionId  String?
  collection    SalesCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  creditNoteId  String?
  creditNote    SalesInvoice?    @relation("ArCreditSource", fields: [creditNoteId], references: [id], onDelete: Restrict)
  amount        Decimal          @db.Decimal(18, 2)
  /// The Riyadh business day of the application (its posting date).
  appliedDate   DateTime         @db.Date
  /// Made when the receipt was approved (posted inside its RECEIVED entry), or later (its own APPLIED entry).
  atReceipt     Boolean          @default(false)
  /// APPLIED | REVERSED
  status        String           @default("APPLIED")
  createdById   String
  createdAt     DateTime         @default(now())
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?

  @@index([invoiceId, status])
  @@index([collectionId, status])
  @@index([creditNoteId, status])
  @@index([customerId, status])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Accounting A3 — posting from operations (migration 20261104090000_ops_posting).
// docs/accounting/POSTING-CONTRACT.md §4 and §10. The inventory COST sub-ledger (perpetual, moving weighted
// average per stock-holding entity), the minimal AP sub-ledger (supplier invoices, payments, allocations),
// expense categories, costing settings, the opening inventory valuation and the commission ↔ ledger sync.
// Ids of operational entities are stored WITHOUT foreign keys (like the ledger's dimensions): the cost
// sub-ledger is part of the books and outlives a reset of operational data.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

/// One costed stock holder: a green-coffee lot (GreenBean), a packaging / café material (MaterialItem), a roast's
/// unpacked roasted coffee (RoastingBatch) or a finished-goods lot (FinishedGoodsLot). qty is in the entity's
/// own unit (kg for coffee, the material's unit), value in SAR. Moving weighted average: avgCost = value / qty.
/// CHECKs: qty ≥ 0, value ≥ 0, and an empty holder carries no value.
model CostItem {
  id         String     @id @default(cuid())
  tenantId   String     @default("hiqbah")
  /// GREEN_BEAN | MATERIAL | ROASTED_BATCH | FG_LOT
  kind       String
  entityId   String
  /// The inventory posting role its value sits under (INVENTORY_GREEN, INVENTORY_PACKAGING, INVENTORY_CAFE,
  /// INVENTORY_ROASTED, INVENTORY_PACKED), fixed when the holder is first costed.
  role       String
  qty        Decimal    @default(0) @db.Decimal(18, 4)
  value      Decimal    @default(0) @db.Decimal(18, 2)
  avgCost    Decimal    @default(0) @db.Decimal(18, 6)
  /// The unit cost of the last receipt (the "last known cost" the opening valuation proposes).
  lastInCost Decimal?   @db.Decimal(18, 6)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  moves      CostMove[]

  @@unique([tenantId, kind, entityId])
  @@index([role])
}

/// One movement of the cost sub-ledger, with the unit-cost snapshot it moved at. Append-only (cost_move_guard):
/// the only change ever made is resolving glState PENDING → POSTED / SKIPPED / NONE (and journalEntryId) in the
/// transaction that wrote it; a PENDING row is refused at commit. One row per (source event, holder, lineKey).
model CostMove {
  id                  String   @id @default(cuid())
  tenantId            String   @default("hiqbah")
  costItemId          String
  costItem            CostItem @relation(fields: [costItemId], references: [id], onDelete: Restrict)
  businessDay         DateTime @db.Date
  /// RECEIPT | ISSUE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | REVALUATION | OPENING | WRITE_OFF | RETURN
  kind                String
  /// Signed: + in, − out.
  qty                 Decimal  @db.Decimal(18, 4)
  value               Decimal  @db.Decimal(18, 2)
  unitCost            Decimal  @db.Decimal(18, 6)
  qtyAfter            Decimal  @db.Decimal(18, 4)
  valueAfter          Decimal  @db.Decimal(18, 2)
  sourceModule        String
  sourceType          String
  sourceId            String
  sourceEvent         String
  lineKey             String   @default("")
  inventoryMovementId String?
  journalEntryId      String?
  /// PENDING (inside its transaction only) | POSTED | SKIPPED (engine off / before go-live) | NONE (nothing to
  /// post: a transfer within one role, a zero value) | OPENING (the opening inventory valuation)
  glState             String   @default("PENDING")
  reason              String?
  createdBy           String
  createdAt           DateTime @default(now())

  @@unique([tenantId, sourceType, sourceId, sourceEvent, costItemId, lineKey])
  @@index([costItemId, createdAt])
  @@index([sourceType, sourceId])
  @@index([glState, businessDay])
}

/// Costing policy (singleton). abnormalRoastLossPct: a roast's loss (green − roasted, % of green) above it is
/// ABNORMAL and its cost is expensed to ROAST_LOSS; NULL = every loss is normal and absorbed into roasted cost.
model CostingSettings {
  id                      String    @id @default("singleton")
  abnormalRoastLossPct    Decimal?  @db.Decimal(5, 2)
  /// true: a roast's abnormal boundary is its product's expected loss + 5 points (CoffeeProduct.expectedRoastLoss —
  /// the boundary the roasting station already flags «فوق الحد»); abnormalRoastLossPct is then the fallback.
  abnormalUseProductLimit Boolean   @default(false)
  openingAppliedAt        DateTime?
  openingAppliedBy        String?
  updatedBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

/// The opening inventory valuation: the unit cost the owner entered for a holder (else the last known cost is
/// proposed). Applied once per go-live into the cost sub-ledger and the opening-balance grid.
model InventoryOpeningCost {
  id        String   @id @default(cuid())
  kind      String
  entityId  String
  unitCost  Decimal  @db.Decimal(18, 6)
  note      String?
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, entityId])
}

/// A non-stock purchase category (rent, maintenance, utilities…) → the expense account its bill lines post to.
model ExpenseCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String?
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceLines SupplierInvoiceLine[]
}

/// A supplier invoice (bill): DRAFT → SUBMITTED → POSTED (approve = post, by an AP holder other than the
/// submitter) → CANCELLED (reversed, only while nothing is paid). Totals are the sums of the lines (VAT per line).
model SupplierInvoice {
  id                     String         @id @default(cuid())
  tenantId               String         @default("hiqbah")
  /// «SINV-2026-000001», gapless per year among issued numbers (assigned at creation).
  number                 String         @unique
  supplierId             String
  supplier               Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// The supplier's own invoice number; unique per supplier among live invoices.
  supplierRef            String
  invoiceDate            DateTime       @db.Date
  dueDate                DateTime       @db.Date
  /// DRAFT | SUBMITTED | POSTED | CANCELLED
  status                 String         @default("DRAFT")
  netTotal               Decimal        @default(0) @db.Decimal(18, 2)
  vatTotal               Decimal        @default(0) @db.Decimal(18, 2)
  grossTotal             Decimal        @default(0) @db.Decimal(18, 2)
  paidTotal              Decimal        @default(0) @db.Decimal(18, 2)
  notes                  String?
  createdBy              String
  /// The last person who changed the draft (SoD: neither preparer, last editor nor submitter posts it).
  lastEditedBy           String?
  submittedBy            String?
  submittedAt            DateTime?
  postedBy               String?
  postedAt               DateTime?
  journalEntryId         String?
  cancelledBy            String?
  cancelledAt            DateTime?
  cancelReason           String?
  /// Phase 2: the customs declaration import VAT (P-IMP15) is claimed on — both or neither (CHECK).
  customsDeclarationNo   String?
  customsDeclarationDate DateTime?      @db.Date
  /// PURCHASES = the one-step purchase invoice (src/lib/accounting/ops/purchase-invoice.ts); AP = a bill entered through
  /// the legacy accounts-payable API (whose STOCK line capitalises value without a receipt). CHECK; frozen once posted.
  origin                 String         @default("AP")
  /// The day the invoice's goods were received (its receipts' and cost moves' day); NULL when it received nothing.
  receivedDate           DateTime?      @db.Date
  /// Phase 3 (20261115090000_stock_locations): «موقع الاستلام» — the site its goods are received at (NULL: the default).
  receivingLocationId    String?
  receivingLocation      StockLocation? @relation(fields: [receivingLocationId], references: [id], onDelete: Restrict)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  lines       SupplierInvoiceLine[]
  allocations SupplierPaymentAllocation[]

  @@index([supplierId, status])
  @@index([status, dueDate])
  @@index([receivingLocationId])
}

/// GRN: matched to one receipt (PurchaseRecord) — Dr GRNI at the receipt's value, the difference is a price
/// variance. STOCK: a stock line without a costed receipt (stockKind + stockItemId) — capitalised into the holder.
/// EXPENSE: a non-stock line (expenseCategoryId → its account).
model SupplierInvoiceLine {
  id                     String           @id @default(cuid())
  invoiceId              String
  invoice                SupplierInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo                 Int
  kind                   String
  /// PurchaseRecord.id (no FK: the receipt register is operational data).
  purchaseRecordId       String?
  stockKind              String?
  stockItemId            String?
  expenseCategoryId      String?
  expenseCategory        ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  description            String
  quantity               Decimal?         @db.Decimal(18, 4)
  net                    Decimal          @db.Decimal(18, 2)
  vatRate                Decimal          @default(15) @db.Decimal(5, 2)
  vat                    Decimal          @db.Decimal(18, 2)
  gross                  Decimal          @db.Decimal(18, 2)
  /// Filled when posted: the receipt's value (GRN), the price variance, and the part of it capitalised.
  matchedValue           Decimal?         @db.Decimal(18, 2)
  variance               Decimal?         @db.Decimal(18, 2)
  capitalized            Decimal?         @db.Decimal(18, 2)
  // ── Phase 2 (20261113090000_purchase_invoice_phase2): the purchase VAT category of the line ──
  taxCategoryId          String?
  taxCategory            TaxCategory?     @relation(fields: [taxCategoryId], references: [id], onDelete: Restrict)
  /// Written when the invoice is posted (buildPurchaseTaxSnapshot); never changed afterwards.
  taxSnapshot            Json?
  /// IMPORT_VAT lines: the customs value the import VAT is computed on (net is 0).
  customsValue           Decimal?         @db.Decimal(18, 2)
  /// P-RC15 lines: the self-assessed VAT (not payable to the supplier; Dr VAT_INPUT / Cr VAT_OUTPUT).
  selfAssessedVat        Decimal?         @db.Decimal(18, 2)
  /// LANDED_COST lines: the receipt (of any supplier) the freight / duty / clearance / insurance is capitalised onto.
  targetPurchaseRecordId String?
  targetPurchaseRecord   PurchaseRecord?  @relation("LandedCostTarget", fields: [targetPurchaseRecordId], references: [id], onDelete: Restrict)
  /// LANDED_COST lines: FREIGHT | DUTY | CLEARANCE | INSURANCE.
  landedCostType         String?

  @@unique([invoiceId, lineNo])
  @@index([purchaseRecordId])
  @@index([taxCategoryId])
  @@index([targetPurchaseRecordId])
}

/// A payment to a supplier, applied in full to its posted invoices. POSTED → VOIDED (reversed).
model SupplierPayment {
  id             String    @id @default(cuid())
  tenantId       String    @default("hiqbah")
  number         String    @unique
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paymentDate    DateTime  @db.Date
  amount         Decimal   @db.Decimal(18, 2)
  /// BANK_TRANSFER | CASH | CHEQUE
  method         String
  reference      String?
  /// POSTED | VOIDED
  status         String    @default("POSTED")
  journalEntryId String?
  createdBy      String
  voidedBy       String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  allocations SupplierPaymentAllocation[]

  @@index([supplierId, paymentDate])
}

model SupplierPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(18, 2)
  createdAt DateTime        @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

/// Commission ↔ ledger (one row per login × Riyadh month): what the ledger holds as approved commission
/// (postedTotal) and what was approved while the engine posted nothing (baselineTotal — part of the opening
/// balances, never posted later). The next accrual posts approved − posted − baseline.
model CommissionGlSync {
  id            String   @id @default(cuid())
  employeeId    String
  periodStart   DateTime
  postedTotal   Decimal  @default(0) @db.Decimal(18, 2)
  baselineTotal Decimal  @default(0) @db.Decimal(18, 2)
  postings      Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([employeeId, periodStart])
}

// ── ZATCA Phase 2 (Fatoora) e-invoicing — accounting phase A4 (20261105090000_zatca_phase2) ──────────────────
// The e-invoice generation solution (EGS) units, their CSIDs, the signed / cleared documents and the Fatoora log.
// The database keeps the chain: an EGS unit's ICV only ever moves by one, together with its last hash; a document's
// ICV and PIH are the EGS unit's next value and previous hash (checked against the previous document); the signed
// XML is stored byte for byte and never changes; the cleared XML is written once; nothing here is deleted.

/// The e-invoicing switch (one row, "singleton"): OFF (issuing works exactly as A2) | SANDBOX | SIMULATION |
/// PRODUCTION. The server must also allow it (ZATCA_ENABLED=true; PRODUCTION also ZATCA_PRODUCTION_ALLOWED=true).
model ZatcaSettings {
  id          String   @id @default("singleton")
  tenantId    String   @default("hiqbah")
  mode        String   @default("OFF")
  /// The EGS unit that signs what this ERP issues (one at a time; must be of the mode's environment).
  activeEgsId String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// An EGS unit: this ERP's own e-invoice generation solution towards ZATCA (separate from any other system the
/// taxpayer uses — its own CSID, ICV counter and PIH chain).
model ZatcaEgsUnit {
  id                   String    @id @default(cuid())
  tenantId             String    @default("hiqbah")
  /// SANDBOX (developer portal) | SIMULATION | PRODUCTION — fixed at creation.
  environment          String
  name                 String
  /// CSR subject: CN, SN (1-…|2-…|3-…), O, OU (branch), UID (VAT), title (TSCZ), registeredAddress, businessCategory.
  commonName           String
  serialNumber         String    @unique
  organizationName     String
  branchName           String
  branchId             String?
  vatNumber            String
  invoiceTypes         String    @default("1100")
  location             String
  industry             String
  /// NONE → COMPLIANCE → PRODUCTION → RENEWED; REVOKED (CSID state).
  csidState            String    @default("NONE")
  /// The private key (PKCS#8 PEM), AES-256-GCM with ZATCA_KEY_ENCRYPTION_KEY. Never returned, never logged.
  privateKeyEnc        String?
  publicKeyPem         String?
  csrPem               String?
  keyVersion           Int       @default(0)
  /// A renewal in progress: the new key and CSR until ZATCA issues the renewed CSID.
  pendingPrivateKeyEnc String?
  pendingCsrPem        String?
  /// The last ICV used (0 = none yet) and the hash of that document (the initial PIH before the first).
  icv                  BigInt    @default(0)
  lastHash             String    @default("NWZlY2ViNjZmZmM4NmYzOGQ5NTI3ODZjNmQ2OTZjNzljMmRiYzIzOWRkNGU5MWI0NjcyOWQ3M2EyN2ZiNTdlOQ==")
  lastDocumentAt       DateTime?
  /// The compliance checks run against the compliance CSID: [{ type, ok, status, at, warnings, errors }].
  complianceChecks     Json?
  complianceCheckedAt  DateTime?
  retiredAt            DateTime?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  csids     ZatcaCsid[]
  documents ZatcaDocument[]

  @@index([environment, csidState])
}

/// A CSID ZATCA issued to an EGS unit (compliance or production). Token and secret are stored encrypted.
model ZatcaCsid {
  id            String       @id @default(cuid())
  tenantId      String       @default("hiqbah")
  egsId         String
  egs           ZatcaEgsUnit @relation(fields: [egsId], references: [id], onDelete: Restrict)
  /// COMPLIANCE | PRODUCTION
  kind          String
  requestId     String
  tokenEnc      String
  secretEnc     String
  keyVersion    Int
  certSerial    String
  certIssuer    String
  certSha256    String
  certNotBefore DateTime?
  certNotAfter  DateTime?
  /// ACTIVE | SUPERSEDED | REVOKED
  status        String       @default("ACTIVE")
  createdById   String
  createdAt     DateTime     @default(now())
  supersededAt  DateTime?

  @@index([egsId, kind, status])
}

/// The e-invoice of one issued SalesInvoice: its place in the EGS chain, the signed XML (bytes, as signed), the
/// cleared XML (bytes, as ZATCA returned it), and the submission queue state (clearance or reporting).
model ZatcaDocument {
  id                String       @id @default(cuid())
  tenantId          String       @default("hiqbah")
  invoiceId         String       @unique
  egsId             String
  egs               ZatcaEgsUnit @relation(fields: [egsId], references: [id], onDelete: Restrict)
  csidId            String
  environment       String
  icv               BigInt
  pih               String
  invoiceHash       String
  uuid              String
  /// CLEARANCE (standard, B2B) | REPORTING (simplified, B2C)
  flow              String
  signedXml         Bytes
  signedXmlSha256   String
  clearedXml        Bytes?
  clearedXmlSha256  String?
  qr                String
  /// PENDING | CLEARED | CLEARED_WITH_WARNINGS | REPORTED | REPORTED_WITH_WARNINGS | REJECTED | ERROR
  status            String       @default("PENDING")
  attempts          Int          @default(0)
  nextAttemptAt     DateTime?
  leaseUntil        DateTime?
  lastHttpStatus    Int?
  lastError         String?
  warnings          Json?
  errors            Json?
  signedAt          DateTime
  reportingDeadline DateTime?
  submittedAt       DateTime?
  decidedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([egsId, icv])
  @@index([status, nextAttemptAt])
  @@index([flow, status, signedAt])
}

/// Every request to Fatoora and its answer (secrets, OTP, keys and invoice bodies left out). Append-only.
model ZatcaLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("hiqbah")
  egsId       String?
  documentId  String?
  /// COMPLIANCE_CSID | COMPLIANCE_CHECK | PRODUCTION_CSID | RENEW_CSID | CLEARANCE | REPORTING
  action      String
  environment String
  method      String
  endpoint    String
  httpStatus  Int?
  outcome     String
  durationMs  Int?
  attempt     Int?
  request     Json?
  response    Json?
  actorId     String?
  at          DateTime @default(now())

  @@index([egsId, at])
  @@index([documentId, at])
  @@index([action, at])
}

/// Accounting A5 (20261106090000_accounting_reports): the month-end close checklist as it stood when it was run —
/// a review, the soft close, the final close or the year-end close — with who ran it and the note on any warning
/// accepted. Evidence for the auditor: append-only in the database (ledger_close_review_guard).
model PeriodCloseReview {
  id             String       @id @default(cuid())
  tenantId       String       @default("hiqbah")
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  /// REVIEW | SOFT_CLOSE | CLOSE | YEAR_END
  action         String
  /// [{ key, status: PASS | WARN | FAIL | NA, count, amount, ar, en, href }]
  results        Json
  blocking       Int          @default(0)
  warnings       Int          @default(0)
  note           String?
  actorId        String
  at             DateTime     @default(now())

  @@index([fiscalPeriodId, at])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// SMART MARKETING DEPARTMENT («قسم التسويق الذكي») — additive, migration
// 20261107090000_marketing_foundation. docs/marketing/ARCHITECTURE.md is the reference.
//
// Conventions kept from the rest of the schema: status columns are TEXT with a CHECK in the
// migration (not Prisma enums); money is Decimal(18,2) in the row's own currency; every metric
// a platform may not report is NULLABLE — NULL means «غير متاح», never zero. Employee ids are
// plain columns (the audit trail outlives an account), the product link is a real foreign key.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// The single settings row (id "default"): kill switches, approval policy, messaging limits.
model MktSettings {
  id                             String   @id @default("default")
  /// Emergency stops. Each is read by the worker before every external write; ALL stops everything.
  killAll                        Boolean  @default(false)
  killPublishing                 Boolean  @default(false)
  killAds                        Boolean  @default(false)
  killMessaging                  Boolean  @default(false)
  /// IANA zone the company reports in (platform timestamps are stored UTC and converted for display).
  timezone                       String   @default("Asia/Riyadh")
  currency                       String   @default("SAR")
  /// Which actions need a second person: { publish, aiPublish, campaignCreate, budgetIncrease,
  /// campaignPause, trackingChange, sensitiveReply, messageCampaign } → boolean. Missing = required.
  approvalPolicy                 Json     @default("{}")
  /// Messaging guard rails.
  maxMessagesPerDay              Int      @default(500)
  maxMarketingPerCustomerPerWeek Int      @default(2)
  quietHoursStart                Int      @default(22) // hour, company timezone
  quietHoursEnd                  Int      @default(9)
  /// Attribution defaults.
  attributionModel               String   @default("LAST_TOUCH")
  attributionWindowDays          Int      @default(7)
  updatedById                    String?
  updatedAt                      DateTime @updatedAt
}

/// Brand kit: what generated or reviewed content must respect. One row per brand (id "default").
model MktBrandKit {
  id          String   @id @default("default")
  brandNameAr String   @default("حقبة")
  brandNameEn String   @default("Hiqbah")
  /// [{ name, hex }]
  colors      Json     @default("[]")
  /// [{ role, family }]
  fonts       Json     @default("[]")
  toneAr      String?
  toneEn      String?
  /// Approved phrasing, banned words, claims that need evidence.
  doList      String[] @default([])
  dontList    String[] @default([])
  /// Approved example captions / posts.
  examples    String[] @default([])
  logoAssetId String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Product economics for marketing decisions (break-even ROAS, target CAC). Entered, never guessed.
model MktProductEconomics {
  productId            String        @id
  product              CoffeeProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Average selling price per order in SAR (incl. or excl. VAT is stated by vatIncluded).
  avgOrderValue        Decimal?      @db.Decimal(18, 2)
  vatIncluded          Boolean       @default(false)
  /// Gross margin as a fraction 0–1 (price minus cost of goods).
  grossMarginPct       Decimal?      @db.Decimal(6, 4)
  /// Variable cost per order besides COGS (shipping subsidy, payment fee, packaging) in SAR.
  variableCostPerOrder Decimal?      @db.Decimal(18, 2)
  /// The owner's target acquisition cost for a new customer of this product, SAR.
  targetCac            Decimal?      @db.Decimal(18, 2)
  /// Typical days between repeat purchases (for replenishment reminders).
  repurchaseCycleDays  Int?
  updatedById          String?
  updatedAt            DateTime      @updatedAt
}

/// A marketing campaign — the spine every post, ad, message, budget line and order links to.
model MktCampaign {
  id                        String              @id @default(cuid())
  name                      String
  /// AWARENESS | ENGAGEMENT | TRAFFIC | LEADS | CONVERSIONS | SALES | RETENTION (CHECK)
  objective                 String
  /// DRAFT | PLANNED | ACTIVE | PAUSED | COMPLETED | ARCHIVED (CHECK)
  status                    String              @default("DRAFT")
  /// Channels this campaign runs on (platform keys, see lib/marketing/platforms.ts).
  channels                  String[]            @default([])
  productId                 String?
  product                   CoffeeProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  audience                  String?
  offer                     String?
  landingUrl                String?
  /// utm_campaign value; unique so an order's UTM resolves to exactly one campaign.
  utmCampaign               String              @unique
  startAt                   DateTime?
  endAt                     DateTime?
  plannedBudget             Decimal?            @db.Decimal(18, 2)
  currency                  String              @default("SAR")
  /// Decision targets (NULL = use the product economics; none at all = «بيانات غير كافية»).
  targetCac                 Decimal?            @db.Decimal(18, 2)
  targetRoas                Decimal?            @db.Decimal(8, 3)
  /// Minimum evidence before the decision engine judges: spend and conversions.
  minSpendForDecision       Decimal?            @db.Decimal(18, 2)
  minConversionsForDecision Int?
  /// Ids of this campaign on each ad platform: { META: "...", TIKTOK: "..." }.
  externalRefs              Json                @default("{}")
  notes                     String?
  ownerId                   String?
  createdById               String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  posts                     MktPost[]
  assets                    MktAsset[]
  budgets                   MktBudget[]
  metrics                   MktMetricSnapshot[]
  decisions                 MktDecision[]
  messages                  MktMessage[]
  storeOrders               MktStoreOrder[]
  /// «مساحة عملي» (additive): occasions linked to this campaign.
  workOccasions             WorkOccasion[]      @relation("WorkOccasionCampaign")

  @@index([status])
  @@index([productId])
}

/// A content asset (design, photo, video, source file, copy). Versions keep every upload; the
/// original is never overwritten.
model MktAsset {
  id          String            @id @default(cuid())
  title       String
  /// IMAGE | VIDEO | DESIGN_SOURCE | DOCUMENT | COPY (CHECK)
  kind        String
  tags        String[]          @default([])
  campaignId  String?
  campaign    MktCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  productId   String?
  product     CoffeeProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Usage rights: OWNED | LICENSED | UGC_PERMISSION | STOCK | UNKNOWN (CHECK).
  rights      String            @default("UNKNOWN")
  rightsNote  String?
  /// COPY assets carry their text here instead of a file.
  text        String?
  /// The brief this asset answers (objective, audience, message, offer, cta, size, platform).
  brief       Json?
  /// True when the content was produced by the AI studio (approval policy may differ).
  aiGenerated Boolean           @default(false)
  archived    Boolean           @default(false)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    MktAssetVersion[]
  postLinks   MktPostAsset[]

  @@index([campaignId])
  @@index([productId])
  @@index([kind, archived])
}

/// One uploaded file of an asset. Immutable once written.
model MktAssetVersion {
  id           String   @id @default(cuid())
  assetId      String
  asset        MktAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version      Int
  /// The first version is the original and is kept forever.
  isOriginal   Boolean  @default(false)
  fileName     String
  /// Proven from the file signature, never the browser's claim.
  mimeType     String
  sizeBytes    Int
  sha256       String
  width        Int?
  height       Int?
  /// Bytes in the row (no Blob store configured) — exactly one of content / blobPathname (CHECK).
  content      Bytes?
  blobPathname String?  @unique
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([assetId, version])
}

/// A planned or published piece of organic content. One post, one or more platform variants.
model MktPost {
  id          String           @id @default(cuid())
  title       String
  campaignId  String?
  campaign    MktCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  productId   String?
  product     CoffeeProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// AWARENESS | ENGAGEMENT | TRAFFIC | CONVERSIONS | SALES (CHECK)
  objective   String
  audience    String?
  /// POST | REEL | STORY | VIDEO | CAROUSEL | SHORT | ARTICLE | PIN (CHECK)
  contentType String           @default("POST")
  caption     String           @default("")
  hashtags    String[]         @default([])
  link        String?
  cta         String?
  /// UTC instant; displayed in MktSettings.timezone.
  scheduledAt DateTime?
  /// DRAFT | IN_REVIEW | APPROVED | SCHEDULED | PUBLISHING | PUBLISHED | PARTIAL | FAILED | CANCELLED (CHECK)
  status      String           @default("DRAFT")
  brief       Json?
  aiGenerated Boolean          @default(false)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    MktPostVariant[]
  assets      MktPostAsset[]
  changes     MktPostChange[]

  @@index([scheduledAt])
  @@index([status])
  @@index([campaignId])
}

/// The post as it goes to one platform: its own caption/hashtags and its own publishing result.
model MktPostVariant {
  id                  String          @id @default(cuid())
  postId              String
  post                MktPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform            String
  /// NULL = use the post's caption / hashtags.
  caption             String?
  hashtags            String[]        @default([])
  /// PENDING | QUEUED | PUBLISHING | PUBLISHED | FAILED | MANUAL_REQUIRED | MANUAL_DONE | CANCELLED (CHECK)
  status              String          @default("PENDING")
  externalPostId      String?
  externalUrl         String?
  publishedAt         DateTime?
  /// Who confirmed a manual publication, and the URL they gave as evidence.
  manualConfirmedById String?
  lastError           String?
  updatedAt           DateTime        @updatedAt
  jobs                MktPublishJob[]

  @@unique([postId, platform])
  @@index([status])
}

model MktPostAsset {
  postId    String
  post      MktPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MktAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  /// Pinned version; NULL = the asset's latest at publish time.
  versionId String?
  position  Int      @default(0)

  @@id([postId, assetId])
}

/// Append-only: every change of a post's schedule, status or content, by whom and why.
model MktPostChange {
  id        String   @id @default(cuid())
  postId    String
  post      MktPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String?
  field     String
  before    String?
  after     String?
  reason    String?
  at        DateTime @default(now())

  @@index([postId, at])
}

/// One attempt-set to publish one variant. The idempotency key makes a retry the same job,
/// never a second post.
model MktPublishJob {
  id             String         @id @default(cuid())
  variantId      String
  variant        MktPostVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  idempotencyKey String         @unique
  /// QUEUED | RUNNING | SUCCEEDED | FAILED | MANUAL_REQUIRED | CANCELLED (CHECK)
  status         String         @default("QUEUED")
  attempts       Int            @default(0)
  runAt          DateTime
  lockedAt       DateTime?
  lastError      String?
  externalId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, runAt])
}

/// Two-person approval of a marketing action. Requester can never decide (service + CHECK).
model MktApproval {
  id              String    @id @default(cuid())
  /// POST | CAMPAIGN | BUDGET_CHANGE | AD_CHANGE | MESSAGE_CAMPAIGN | TRACKING_CHANGE | SENSITIVE_REPLY (CHECK)
  subjectType     String
  subjectId       String
  /// The action approved: publish, ai_publish, create, increase, pause, send …
  action          String
  /// PENDING | APPROVED | REJECTED | CANCELLED (CHECK)
  status          String    @default("PENDING")
  /// What exactly is being approved (a snapshot, so a later edit cannot ride on an old approval).
  payload         Json      @default("{}")
  payloadHash     String
  requestedById   String
  requestedByName String?
  requestNote     String?
  decidedById     String?
  decidedByName   String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
}

/// A connection to an external platform. Tokens are AES-256-GCM encrypted with
/// MARKETING_TOKEN_KEY; the ciphertext never leaves the server.
model MktConnection {
  id              String    @id @default(cuid())
  /// Platform key (lib/marketing/platforms.ts), one row each.
  platform        String    @unique
  /// NOT_CONFIGURED | PENDING | CONNECTED | EXPIRED | ERROR | DISABLED (CHECK)
  status          String    @default("NOT_CONFIGURED")
  accountId       String?
  accountName     String?
  scopes          String[]  @default([])
  tokenCiphertext String?
  tokenExpiresAt  DateTime?
  /// Non-secret settings (ad account id, page id, phone number id …).
  config          Json      @default("{}")
  lastCheckedAt   DateTime?
  lastError       String?
  connectedById   String?
  updatedAt       DateTime  @updatedAt
}

/// A budget line for a period (YYYY-MM month or YYYY-Qn quarter).
model MktBudget {
  id                 String       @id @default(cuid())
  period             String
  /// TOTAL | PLATFORM | CAMPAIGN | PRODUCT (CHECK)
  scope              String
  /// Platform key / product id when scope says so (campaign uses campaignId).
  scopeRef           String?
  campaignId         String?
  campaign           MktCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  planned            Decimal      @db.Decimal(18, 2)
  dailyCap           Decimal?     @db.Decimal(18, 2)
  /// The most an automatic rule may add in one step, as a fraction (0.2 = +20%).
  maxAutoIncreasePct Decimal?     @db.Decimal(6, 4)
  currency           String       @default("SAR")
  note               String?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([period, scope, scopeRef, campaignId])
  @@index([period])
}

/// Daily performance as a platform (or a person, for MANUAL) reported it. Every metric nullable.
model MktMetricSnapshot {
  id               String       @id @default(cuid())
  /// The day in the company timezone, as a date.
  day              DateTime     @db.Date
  platform         String
  /// ACCOUNT | CAMPAIGN | ADSET | AD | POST (CHECK)
  level            String
  /// The platform's id of the object (campaign/ad/post), or "account".
  externalId       String
  campaignId       String?
  campaign         MktCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// PAID | ORGANIC (CHECK)
  kind             String       @default("PAID")
  currency         String       @default("SAR")
  spend            Decimal?     @db.Decimal(18, 2)
  impressions      Int?
  reach            Int?
  clicks           Int?
  linkClicks       Int?
  landingPageViews Int?
  videoViews       Int?
  engagements      Int?
  followersDelta   Int?
  leads            Int?
  purchases        Int?
  /// Platform-reported conversion value (platform attribution — never summed across platforms).
  conversionValue  Decimal?     @db.Decimal(18, 2)
  /// API | MANUAL | IMPORT (CHECK)
  source           String
  fetchedAt        DateTime     @default(now())
  enteredById      String?

  @@unique([day, platform, level, externalId, source])
  @@index([campaignId, day])
  @@index([day])
}

/// Store customers mirrored from the e-commerce platform — read-only copy.
model MktStoreCustomer {
  id            String          @id @default(cuid())
  source        String          @default("STORE")
  externalId    String
  name          String?
  /// E.164 without "+", normalised (9665…).
  phone         String?
  email         String?
  firstOrderAt  DateTime?
  ordersCount   Int             @default(0)
  /// Optional link to the ERP B2B customer when the same party buys both ways.
  erpCustomerId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        MktStoreOrder[]
  carts         MktCart[]

  @@unique([source, externalId])
  @@index([phone])
}

/// Store orders mirrored from the e-commerce platform — the revenue truth for attribution.
model MktStoreOrder {
  id           String            @id @default(cuid())
  source       String            @default("STORE")
  externalId   String
  orderNumber  String?
  customerId   String?
  customer     MktStoreCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Platform status as received, and the normalised one:
  /// PENDING | PAID | FULFILLED | CANCELLED | REFUNDED | PARTIALLY_REFUNDED (CHECK)
  rawStatus    String?
  status       String
  currency     String            @default("SAR")
  subtotal     Decimal?          @db.Decimal(18, 2)
  discount     Decimal?          @db.Decimal(18, 2)
  shipping     Decimal?          @db.Decimal(18, 2)
  tax          Decimal?          @db.Decimal(18, 2)
  total        Decimal           @db.Decimal(18, 2)
  refunded     Decimal           @default(0) @db.Decimal(18, 2)
  couponCode   String?
  placedAt     DateTime
  cancelledAt  DateTime?
  /// First order of this customer at this store (new-customer acquisition).
  isFirstOrder Boolean?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  landingUrl   String?
  referrer     String?
  /// Resolved from utmCampaign (or a message click) by the attribution job.
  campaignId   String?
  campaign     MktCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Product lines: [{ sku, name, qty, price }]
  lines        Json              @default("[]")
  /// SHA-256 of the last payload applied (an identical webhook is a no-op).
  payloadHash  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  touches      MktTouch[]

  @@unique([source, externalId])
  @@index([placedAt])
  @@index([campaignId])
}

/// A marketing touch on a customer's path (click, message, visit) — the input of attribution.
model MktTouch {
  id         String         @id @default(cuid())
  /// The phone or store customer id the touch belongs to.
  subjectKey String
  at         DateTime
  /// UTM | WHATSAPP | AD_CLICK | ORGANIC | REFERRAL (CHECK)
  channel    String
  platform   String?
  campaignId String?
  messageId  String?
  orderId    String?
  order      MktStoreOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  detail     Json           @default("{}")

  @@index([subjectKey, at])
  @@index([orderId])
}

/// Abandoned carts mirrored from the store.
model MktCart {
  id                       String            @id @default(cuid())
  source                   String            @default("STORE")
  externalId               String
  customerId               String?
  customer                 MktStoreCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone                    String?
  value                    Decimal?          @db.Decimal(18, 2)
  currency                 String            @default("SAR")
  /// Link back to the cart, only if the store supplied one.
  recoveryUrl              String?
  lines                    Json              @default("[]")
  abandonedAt              DateTime
  /// OPEN | CONVERTED | EXPIRED (CHECK)
  status                   String            @default("OPEN")
  convertedOrderExternalId String?
  convertedAt              DateTime?
  updatedAt                DateTime          @updatedAt
  createdAt                DateTime          @default(now())

  @@unique([source, externalId])
  @@index([status, abandonedAt])
}

/// The central consent ledger for a channel. The latest event decides; nothing is deleted.
model MktConsent {
  /// E.164 digits (9665…) — one row per phone and channel.
  phone     String
  channel   String            @default("WHATSAPP")
  /// OPTED_IN | OPTED_OUT (CHECK)
  status    String
  /// CHECKOUT | FORM | IN_STORE | REPLY_STOP | ADMIN | IMPORT (CHECK)
  source    String
  evidence  String?
  updatedAt DateTime          @updatedAt
  events    MktConsentEvent[]

  @@id([phone, channel])
}

model MktConsentEvent {
  id       String     @id @default(cuid())
  phone    String
  channel  String
  consent  MktConsent @relation(fields: [phone, channel], references: [phone, channel], onDelete: Cascade)
  status   String
  source   String
  evidence String?
  actorId  String?
  at       DateTime   @default(now())

  @@index([phone, channel, at])
}

/// WhatsApp message templates as approved by Meta (synced or entered).
model MktWaTemplate {
  id        String   @id @default(cuid())
  name      String
  language  String   @default("ar")
  /// MARKETING | UTILITY | AUTHENTICATION (CHECK)
  category  String
  /// APPROVED | PENDING | REJECTED | PAUSED | DISABLED | LOCAL_DRAFT (CHECK)
  status    String   @default("LOCAL_DRAFT")
  body      String
  /// Ordered variable names the body's {{1}}, {{2}} … stand for.
  variables String[] @default([])
  /// What the template is for: ABANDONED_CART, WELCOME, ORDER_UPDATE, PROMOTION …
  purpose   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([name, language])
}

/// A lifecycle journey (abandoned cart, welcome, win-back …): trigger, steps, exits.
model MktJourney {
  id          String                 @id @default(cuid())
  /// ABANDONED_CART | WELCOME | POST_PURCHASE | REVIEW_REQUEST | REPLENISH | WINBACK | CROSS_SELL (CHECK)
  kind        String                 @unique
  name        String
  active      Boolean                @default(false)
  /// { steps: [{ waitMinutes, templateId, discountAllowed }], maxMessages, minCartValue, … }
  config      Json                   @default("{}")
  updatedById String?
  updatedAt   DateTime               @updatedAt
  enrollments MktJourneyEnrollment[]
}

/// One subject (a cart, an order, a customer) going through a journey. Unique per journey and
/// subject, so a repeated webhook can never enrol the same cart twice.
model MktJourneyEnrollment {
  id         String       @id @default(cuid())
  journeyId  String
  journey    MktJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  subjectKey String
  phone      String?
  /// ACTIVE | COMPLETED | STOPPED | FAILED (CHECK)
  status     String       @default("ACTIVE")
  stepIndex  Int          @default(0)
  nextRunAt  DateTime?
  stopReason String?
  context    Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   MktMessage[]

  @@unique([journeyId, subjectKey])
  @@index([status, nextRunAt])
}

/// An outbound marketing / service message (WhatsApp Cloud API).
model MktMessage {
  id           String                @id @default(cuid())
  channel      String                @default("WHATSAPP")
  phone        String
  enrollmentId String?
  enrollment   MktJourneyEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     MktCampaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  templateId   String?
  /// MARKETING | UTILITY | SERVICE (CHECK) — consent rules differ.
  category     String
  /// Rendered preview of what the customer sees.
  preview      String
  variables    Json                  @default("[]")
  /// One message per purpose and subject, ever: retries reuse the row.
  dedupeKey    String                @unique
  /// QUEUED | SENDING | SENT | DELIVERED | READ | FAILED | SKIPPED | CANCELLED (CHECK)
  status       String                @default("QUEUED")
  statusNote   String?
  attempts     Int                   @default(0)
  scheduledAt  DateTime
  /// The WhatsApp message id (wamid) returned by the Cloud API.
  providerId   String?               @unique
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  /// Cost as billed/estimated, in currency.
  cost         Decimal?              @db.Decimal(18, 4)
  currency     String                @default("SAR")
  /// The tracked link in the message (carries utm_campaign + a message id).
  trackedUrl   String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, scheduledAt])
  @@index([phone, createdAt])
  @@index([campaignId])
}

/// Decision engine verdicts — one row per evaluation, kept to compare with what happened next.
model MktDecision {
  id               String      @id @default(cuid())
  campaignId       String
  campaign         MktCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// SCALE | KEEP | OPTIMIZE | TEST | PAUSE | HUMAN_REVIEW | INSUFFICIENT_DATA (CHECK)
  verdict          String
  periodStart      DateTime
  periodEnd        DateTime
  /// The figures used, the targets, the rules that fired, the limitations.
  evidence         Json
  confidence       String
  reasoning        String
  requiresApproval Boolean     @default(true)
  /// PROPOSED | ACCEPTED | DISMISSED | EXECUTED (CHECK)
  status           String      @default("PROPOSED")
  outcomeNote      String?
  decidedById      String?
  createdAt        DateTime    @default(now())

  @@index([campaignId, createdAt])
}

/// Alerts raised by jobs and rules. dedupeKey keeps one open alert per condition.
model MktAlert {
  id           String    @id @default(cuid())
  kind         String
  /// INFO | WARNING | CRITICAL (CHECK)
  severity     String
  title        String
  detail       String?
  subjectType  String?
  subjectId    String?
  /// OPEN | ACKNOWLEDGED | RESOLVED (CHECK)
  status       String    @default("OPEN")
  dedupeKey    String    @unique
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status, createdAt])
}

/// Every run of a marketing job (publisher, sync, journeys, alerts) and what it did.
model MktJobRun {
  id         String    @id @default(cuid())
  job        String
  trigger    String
  /// RUNNING | SUCCEEDED | FAILED | SKIPPED (CHECK)
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json      @default("{}")
  error      String?

  @@index([job, startedAt])
}

/// Append-only audit trail of everything that changes marketing state or reaches outside.
model MktAuditLog {
  id         String   @id @default(cuid())
  /// USER | RULE | SYSTEM | WEBHOOK (CHECK)
  actorKind  String
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  note       String?
  at         DateTime @default(now())

  @@index([entityType, entityId, at])
  @@index([at])
}

/// Webhook deliveries received (store, WhatsApp) — kept for idempotency and diagnosis.
model MktWebhookEvent {
  id          String    @id @default(cuid())
  source      String
  /// The provider's event id, or a hash of the body when it sends none.
  eventKey    String
  topic       String?
  signatureOk Boolean
  payload     Json
  /// RECEIVED | PROCESSED | IGNORED | FAILED (CHECK)
  status      String    @default("RECEIVED")
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([source, eventKey])
  @@index([status, receivedAt])
}

// ─── «مساحة عملي» · My Workspace (additive, 20261108090000_my_workspace) ─────────────────────────
// docs/workspace/INTEGRATION.md. New tables only: the work that had no home (tasks, appointments,
// marketing occasions, the reminder outbox). Approvals stay in their departments; the workspace reads
// and decides them through the departments' own services. Status / kind columns are strings with a
// CHECK (the marketing convention). "WorkTaskEvent" is append-only (trigger).

/// A unit of work with ONE accountable owner (the assignee). Overdue is derived (dueAt < now and not
/// DONE / CANCELLED), never a status; completing late keeps completedAt > dueAt for ever.
model WorkTask {
  id                  String        @id @default(cuid())
  /// TASK | FOLLOW_UP (a customer follow-up whose result goes to the CRM timeline) (CHECK)
  kind                String        @default("TASK")
  title               String
  description         String?
  /// NOT_STARTED | IN_PROGRESS | ON_HOLD | IN_REVIEW | DONE | CANCELLED (CHECK)
  status              String        @default("NOT_STARTED")
  /// Required while ON_HOLD (CHECK).
  holdReason          String?
  /// LOW | NORMAL | HIGH | URGENT (CHECK)
  priority            String        @default("NORMAL")
  assigneeId          String
  assignee            Employee      @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           Employee      @relation("WorkTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// The deadline, a UTC instant (shown in Asia/Riyadh).
  dueAt               DateTime
  /// How the deadline was chosen: CLOCK (actual hours) | BUSINESS (working hours) | EXACT (CHECK).
  dueBasis            String        @default("EXACT")
  /// Reserved execution time — distinct from the deadline (a due date never blocks a whole day).
  plannedStartAt      DateTime?
  plannedMinutes      Int?
  requiresReview      Boolean       @default(false)
  reviewerId          String?
  reviewer            Employee?     @relation("WorkTaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// Minutes before dueAt for the «قبل الاستحقاق» reminder; NULL = none.
  remindBeforeMinutes Int?          @default(60)
  /// FOLLOW_UP channel: CALL | VISIT | MEETING (CHECK).
  channel             String?
  customerId          String?
  customer            Customer?     @relation("WorkTaskCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  leadId              String?
  lead                Lead?         @relation("WorkTaskLead", fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId       String?
  opportunity         Opportunity?  @relation("WorkTaskOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)
  /// Any other document, by type and id (an order, a quote, an invoice …) with its label at link time.
  refType             String?
  refId               String?
  refLabel            String?
  occasionId          String?
  occasion            WorkOccasion? @relation(fields: [occasionId], references: [id], onDelete: SetNull)
  /// The CRM Activity that recorded this follow-up's result (one result per task).
  resultActivityId    String?       @unique
  /// Recurrence: DAILY | WEEKLY | MONTHLY (CHECK), every `recurInterval`, until `recurUntil`. The series
  /// is the first task's id; the next occurrence is created when one is completed (unique per series).
  recurRule           String?
  recurInterval       Int?
  recurUntil          DateTime?
  seriesId            String?
  occurrence          Int           @default(1)
  startedAt           DateTime?
  submittedAt         DateTime?
  completedAt         DateTime?
  completedById       String?
  cancelledAt         DateTime?
  cancelledById       String?
  cancelReason        String?
  /// Optimistic concurrency: every write bumps it; a write naming an older version is refused (409).
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  checklist   WorkTaskChecklistItem[]
  comments    WorkTaskComment[]
  watchers    WorkTaskWatcher[]
  attachments WorkTaskAttachment[]
  events      WorkTaskEvent[]
  reminders   WorkReminder[]

  @@unique([seriesId, occurrence])
  @@index([assigneeId, status, dueAt])
  @@index([createdById, status])
  @@index([status, dueAt])
  @@index([customerId])
  @@index([occasionId])
}

model WorkTaskChecklistItem {
  id       String    @id @default(cuid())
  taskId   String
  task     WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label    String
  position Int       @default(0)
  doneAt   DateTime?
  doneById String?

  @@index([taskId, position])
}

model WorkTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee @relation("WorkTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// A file on a task (PDF, JPEG or PNG — the type proven by the bytes; at most 5 MB, kept in the row).
/// Read only by the people who may see the task; never a public URL.
model WorkTaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  content      Bytes
  uploadedById String
  uploadedBy   Employee @relation("WorkTaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([taskId, createdAt])
}

model WorkTaskWatcher {
  taskId     String
  task       WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("WorkTaskWatcher", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

/// The history of a task: created, assigned, status changes, due changes, review, comments … Append-only.
model WorkTaskEvent {
  id      String   @id @default(cuid())
  taskId  String
  task    WorkTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorId String?
  /// CREATED | ASSIGNED | REASSIGNED | STATUS | DUE_CHANGED | UPDATED | REVIEW_APPROVED | REVIEW_RETURNED |
  /// RESULT_RECORDED | CANCELLED | CHECKLIST | COMMENTED | REMINDER_SNOOZED
  action  String
  data    Json     @default("{}")
  at      DateTime @default(now())

  @@index([taskId, at])
}

/// A time actually reserved: a meeting, a visit, a call. Ending is not the activity done — the result is
/// recorded explicitly (a CRM Activity when linked to a customer / lead / deal).
model WorkAppointment {
  id                  String       @id @default(cuid())
  /// MEETING | VISIT | CALL | OTHER (CHECK)
  kind                String       @default("MEETING")
  title               String
  notes               String?
  startAt             DateTime
  endAt               DateTime
  location            String?
  meetingUrl          String?
  /// Outside attendees, free text (a customer's contact person).
  externalAttendees   String?
  organizerId         String
  organizer           Employee     @relation("WorkAppointmentOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  /// SCHEDULED | DONE | CANCELLED (CHECK)
  status              String       @default("SCHEDULED")
  customerId          String?
  customer            Customer?    @relation("WorkAppointmentCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  leadId              String?
  lead                Lead?        @relation("WorkAppointmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId       String?
  opportunity         Opportunity? @relation("WorkAppointmentOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)
  taskId              String?
  remindBeforeMinutes Int?         @default(30)
  recurRule           String?
  recurInterval       Int?
  recurUntil          DateTime?
  seriesId            String?
  occurrence          Int          @default(1)
  outcomeActivityId   String?      @unique
  cancelledAt         DateTime?
  cancelledById       String?
  cancelReason        String?
  version             Int          @default(1)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  participants WorkAppointmentParticipant[]
  reminders    WorkReminder[]

  @@unique([seriesId, occurrence])
  @@index([organizerId, startAt])
  @@index([startAt, endAt])
  @@index([customerId])
}

model WorkAppointmentParticipant {
  appointmentId String
  appointment   WorkAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee        @relation("WorkAppointmentParticipant", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([appointmentId, employeeId])
  @@index([employeeId])
}

/// A marketing occasion, exhibition or campaign moment on the calendar. Imported dates keep their source
/// and when they were last verified; nothing is assumed to recur on the same date. DRAFT until reviewed.
model WorkOccasion {
  id             String       @id @default(cuid())
  name           String
  /// OCCASION | EXHIBITION | CAMPAIGN | HOLIDAY (CHECK)
  kind           String       @default("OCCASION")
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  location       String?
  notes          String?
  sourceUrl      String?
  sourceNote     String?
  lastVerifiedAt DateTime?
  /// DRAFT | CONFIRMED | CANCELLED (CHECK)
  status         String       @default("DRAFT")
  campaignId     String?
  campaign       MktCampaign? @relation("WorkOccasionCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  createdById    String
  confirmedById  String?
  confirmedAt    DateTime?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks WorkTask[]

  @@index([startDate, endDate])
  @@index([status])
}

/// The reminder outbox. Rows are planned when a task / appointment is written and re-planned when it
/// changes (old rows CANCELLED in the same transaction). The runner claims due rows (SKIP LOCKED),
/// re-checks them against the record (`anchorAt` must still be its due / start instant) and notifies
/// through lib/notifications (dedupe per recipient + key): a retry or a second runner never sends twice.
model WorkReminder {
  id            String           @id @default(cuid())
  taskId        String?
  task          WorkTask?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   WorkAppointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  /// DUE_SOON | OVERDUE | ESCALATION | APPOINTMENT | SNOOZE (CHECK)
  kind          String
  recipientId   String
  recipient     Employee         @relation("WorkReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  fireAt        DateTime
  /// The due / start instant the reminder was computed for.
  anchorAt      DateTime
  /// PENDING | SENDING | SENT | CANCELLED | SKIPPED | FAILED (CHECK)
  status        String           @default("PENDING")
  attempts      Int              @default(0)
  lastError     String?
  claimedAt     DateTime?
  sentAt        DateTime?
  dedupeKey     String           @unique
  createdAt     DateTime         @default(now())

  @@index([status, fireAt])
  @@index([taskId])
  @@index([appointmentId])
}

/// Workspace policy (one row). Working hours are a PROPOSAL (hoursConfirmed = false) until the owner
/// confirms them; quick deadlines count clock hours unless «ساعات الدوام» is chosen.
model WorkSettings {
  id                         String   @id @default("default")
  /// 0 = Sunday … 6 = Saturday.
  workDays                   Int[]    @default([0, 1, 2, 3, 4])
  dayStart                   String   @default("08:00")
  dayEnd                     String   @default("17:00")
  hoursConfirmed             Boolean  @default(false)
  defaultRemindBeforeMinutes Int      @default(60)
  /// Hours overdue before the escalation to the assigner / the assignee's manager; NULL = no escalation.
  escalateAfterHours         Int?     @default(4)
  updatedById                String?
  updatedAt                  DateTime @updatedAt
}

/// One run of the workspace jobs (reminders, escalations): when, by what, what it did.
model WorkJobRun {
  id         String    @id @default(cuid())
  /// cron | request | manual
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | SUCCEEDED | FAILED (CHECK)
  status     String    @default("RUNNING")
  summary    Json      @default("{}")
  error      String?

  @@index([startedAt])
}

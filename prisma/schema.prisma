  submittedAt       DateTime?
  acknowledgedAt    DateTime?
}

model HrIncident {
  id           String     @id @default(cuid())
  employeeId   String
  employee     HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                String         @id @default(cuid())
  name              String
  username          String?        @unique
  /// Secure Version B: bcrypt(pinVerifierInput(pin)), where pinVerifierInput is
  /// base64(HMAC-SHA384(PIN_LOOKUP_SECRET, "pin:verify:v1:" + pin)). bcrypt is over the keyed
  /// derivation, never the raw PIN, so a stolen row cannot be brute-forced offline without the
  /// application secret and the raw PIN never verifies directly.
  pin               String
  /// HMAC-SHA256(PIN_LOOKUP_SECRET, "pin:lookup:v1:" + pin), base64. The login selector:
  /// unforgeable and unsearchable without the application secret, so a database copy no longer
  /// yields working PINs. Selector only — bcrypt on `pin` remains the proof. Nullable until
  /// every PIN has been reissued.
  pinLookup         String?        @unique
  password          String?
  role              String // admin, inventory, roasting, qc, dispatch, custom
  permissions       String         @default("{}")
  defaultRoute      String         @default("/dashboard")
  active            Boolean        @default(true)
  phoneNumber       String?
  preferredLanguage String         @default("ar") // "ar" | "en"
  /// The language automation WhatsApp messages reach this employee in: "ar" | "en" (CHECK), chosen on
  /// «خدماتي». NULL = «حسب إعداد النظام» (AutomationSettings.employeeMessageLang, else Arabic).
  /// Migration 20261110090000_i18n_preferences (additive).
  whatsappLanguage  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  qcRecords         QcRecord[]
  cuppingScores     CuppingScore[]
  ownedOrders       Order[]        @relation("OrderOwner") // Order Operations S0 (additive)

  // Sales CRM & commissions (additive). Relation fields only — no columns are added to
  // this table, so the deployed build reads it unchanged.
  leadsOwned               Lead[]                    @relation("LeadOwner")
  opportunitiesOwned       Opportunity[]             @relation("OpportunityOwner")
  opportunitySplits        OpportunityOwner[]        @relation("OpportunitySplitOwner")
  activitiesOwned          Activity[]                @relation("ActivityOwner")
  commissionAssignments    CommissionAssignment[]    @relation("CommissionAssignee")
  commissionAccruals       CommissionAccrual[]       @relation("CommissionEarner")
  commissionLedger         CommissionLedgerEntry[]   @relation("CommissionLedgerOwner")
  salesTargets             SalesTarget[]             @relation("SalesTargetOwner")
  /// Commission plan builder (additive, 20261101090000_commission_builder).
  commissionPeriodResults  CommissionPeriodResult[]  @relation("CommissionPeriodResultOwner")
  commissionBonusDecisions CommissionBonusDecision[] @relation("CommissionBonusDecisionOwner")
  collectionsSubmitted     SalesCollection[]         @relation("CollectionSubmitter")
  collectionsDecided       SalesCollection[]         @relation("CollectionDecider")
  collectionsReversed      SalesCollection[]         @relation("CollectionReverser")
  evidenceUploaded         CollectionEvidence[]      @relation("EvidenceUploader")

  // Native HR (additive). The HR person this login belongs to, if any. A login account is
  // never required to be an HR person and an HR person never requires a login.
  hrPerson       HrEmployee?       @relation("HrPersonAccount")
  /// Owner decision 1 (Option A): or the verified external person (e.g. an outside accountant)
  /// this login belongs to. Never both (DB trigger).
  externalPerson HrExternalPerson? @relation("HrExternalPersonAccount")

  // Owner security decision (username + PIN): server-side sessions and MFA (additive).
  authSessions       AuthSession[]
  // Workstations W2 (20261027090000_station_w2; additive, relation fields only): the stations this
  // login may sign in at (UR-13) and its own station PIN (never unique, no lookup index).
  stationAssignments StationAssignment[]
  stationPin         StationPin?
  authMfa            AuthMfa?
  authRecoveryCodes  AuthRecoveryCode[]

  // Customer account (additive): the accounts this employee is responsible for.
  customerAccounts        Customer[]               @relation("CustomerAccountOwner")
  customerFiles           CustomerFile[]           @relation("CustomerFileUploader")
  // In-app notifications (additive, 20261029090000_notifications): this account's inbox (the bell)
  // and its per-category e-mail choices.
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceOwner")
  /// Direct browser-to-Blob uploads this account started (additive, 20261029100000_blob_client_upload).
  customerFileUploads     CustomerFileUpload[]     @relation("CustomerFileUploadRequester")
  // Credit hold (additive, 20261028100000_credit_hold).
  customerHoldsPlaced     CustomerSalesHold[]      @relation("CustomerHoldCreator")
  customerHoldsLifted     CustomerSalesHold[]      @relation("CustomerHoldLifter")
  customerCreditLog       CustomerCreditLog[]      @relation("CustomerCreditActor")
  /// «البريد الإلكتروني للشركة» of an account with NO linked HR person (additive,
  /// 20261028100000_credit_hold). A linked account's company e-mail is its person's
  /// HrEmployee.workEmail — one source of truth (lib/notify/recipients.ts). Every system
  /// notification is e-mailed to the company e-mail. Unique among active people and accounts
  /// (case-insensitive), enforced by the application.
  workEmail               String?

  // Users, roles & permissions (Figma Phase 8, 20261022090000_users_roles; additive).
  /// The custom role this account follows (role = "custom"); null = a system template or none.
  /// The account's `permissions` document stays the one the session applies; a role save
  /// rewrites the documents of its members (role template plus their explicit overrides).
  accessRoleId           String?
  accessRole             AccessRole?                  @relation("AccessRoleMembers", fields: [accessRoleId], references: [id], onDelete: SetNull)
  /// Explicit per-user exceptions to the role (grant or deny, reason, optional expiry).
  permissionOverrides    PermissionOverride[]         @relation("PermissionOverrideAccount")
  /// An administrator issued a temporary password: every request is refused until the person
  /// sets their own (PUT /api/profile/password), and the temporary one stops working at
  /// passwordTempExpiresAt if it was never used.
  passwordMustChange     Boolean                      @default(false)
  passwordTempExpiresAt  DateTime?
  /// An administrator cleared the station PIN: the person sets a new one themselves from their
  /// profile after confirming their identity with the password (no current PIN needed then).
  pinResetRequired       Boolean                      @default(false)
  /// «مساحة عملي» (additive, 20261108090000_my_workspace): relation fields only.
  workTasksAssigned      WorkTask[]                   @relation("WorkTaskAssignee")
  workTasksCreated       WorkTask[]                   @relation("WorkTaskCreator")
  workTasksReviewing     WorkTask[]                   @relation("WorkTaskReviewer")
  workTaskComments       WorkTaskComment[]            @relation("WorkTaskCommentAuthor")
  workTaskAttachments    WorkTaskAttachment[]         @relation("WorkTaskAttachmentUploader")
  workTasksWatching      WorkTaskWatcher[]            @relation("WorkTaskWatcher")
  workAppointments       WorkAppointment[]            @relation("WorkAppointmentOrganizer")
  workAppointmentInvites WorkAppointmentParticipant[] @relation("WorkAppointmentParticipant")
  workReminders          WorkReminder[]               @relation("WorkReminderRecipient")

  @@index([accessRoleId])
}

/// A custom access role (Figma UR-05 / UR-06): a named permission template. The system templates
/// (admin, inventory, roasting, qc, dispatch and «بلا وصول») stay in code and are read-only.
model AccessRole {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  /// The template: the same JSON permission document an account stores.
  permissions String     @default("{}")
  /// The system template key or custom role id this role was copied from.
  basedOn     String?
  /// Optimistic concurrency for the role editor (UR-S10): every save increments it.
  version     Int        @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  members     Employee[] @relation("AccessRoleMembers")
}

/// One explicit exception to an account's role (Figma UR-09): a cell of the permission matrix —
/// a module's level (sub = null) or one action — granted beyond or denied below the role, with a
/// reason, an optional expiry and, for a permanent sensitive grant, a review date. The account's
/// `permissions` document carries the value; this row explains it and ends it on expiry.
model PermissionOverride {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("PermissionOverrideAccount", fields: [employeeId], references: [id], onDelete: Cascade)
  module      String
  /// null = the module's own level; otherwise the action (sub-privilege) key.
  sub         String?
  /// GRANT | DENY
  effect      String
  /// The value this exception sets: none | view | edit for a module level, true | false for an action.
  value       String
  /// The role template's value for the cell when the exception was made (what expiry returns to).
  roleValue   String
  sensitive   Boolean   @default(false)
  reason      String
  expiresAt   DateTime?
  reviewAt    DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  /// Set when the exception stops applying: REMOVED (by a person), EXPIRED (by the system) or
  /// REPLACED (a later exception on the same cell, or the cell now equals the role).
  endedAt     DateTime?
  endedById   String?
  endReason   String?

  @@index([employeeId, endedAt])
  @@index([endedAt, expiresAt])
}

/// One signed-in session; the token names it (jti). Valid only while not revoked and within
/// the idle and absolute deadlines. authTime is the last strong authentication (step-up).
model AuthSession {
  id              String    @id
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// PIN | USERNAME_PIN | PASSWORD
  method          String
  mfa             Boolean   @default(false)
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  authTime        DateTime  @default(now())
  /// PIN | PASSWORD — the secret of the last strong authentication (sign-in or step-up); null = not
  /// recorded (before 20261017230000). A privileged stock change needs PIN (owner decision 4).
  authFactor      String?
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?
  ipHash          String?
  userAgent       String?
  /// The browser the session was opened from: an opaque random id from the httpOnly hq_device
  /// cookie (not a credential). Groups the own profile's device list; null = before 20261019120000.
  deviceId        String?
  /// Workstations W2 (20261027090000_station_w2): ERP | STATION. A STATION session is opened by a
  /// station PIN on a registered station device, is bound to that station and device, and is refused
  /// by every ERP API (getUserWithPermissions); method = STATION_PIN.
  scope           String    @default("ERP")
  stationId       String?
  stationDeviceId String?

  @@index([employeeId])
  @@index([expiresAt])
  @@index([stationDeviceId])
}

/// TOTP (RFC 6238); the secret is AES-256-GCM encrypted with a key from the environment.
model AuthMfa {
  employeeId String    @id
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  secretEnc  String
  enrolledAt DateTime?
  lastStep   BigInt?
  createdAt  DateTime  @default(now())
}

/// One-time recovery codes (keyed hashes only).
model AuthRecoveryCode {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

model Customer {
  id               String                    @id @default(cuid())
  name             String
  nameAr           String?
  phone            String?
  email            String?
  address          String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  orders           Order[]
  roastPreferences CustomerRoastPreference[]

  // Sales CRM (additive, relation fields only).
  leadConversions  LeadConversion[]
  opportunities    Opportunity[]
  quotes           Quote[]
  activities       Activity[]
  collectionEvents CollectionEvent[]
  salesCollections SalesCollection[]

  /// WhatsApp automation (additive, defaulted): the customer asked not to receive WhatsApp
  /// messages. Every automated message to this customer is recorded as SKIPPED instead.
  whatsappOptOut Boolean @default(false)

  // ─── Customer account (additive, migration 20261019120000_customer_account) ───────────
  // The account page (Figma crm-account 179:1312) shows particulars the system had no source
  // of truth for. Each is a NULLABLE column an administrator edits; none has a default, so
  // every existing row reads "not set" and no figure is invented. Nothing reads them in a
  // calculation: the credit limit is shown, not enforced (no enforcement rule is decided).
  /// Commercial registration number (السجل التجاري), digits only; shown as «CR-…».
  commercialRegNo  String?
  /// VAT registration number (الرقم الضريبي): 15 digits, starting and ending with 3.
  vatNumber        String?
  /// Account category code: WHOLESALE | RETAIL | CAFE | DISTRIBUTOR | OTHER (validated by the API).
  segment          String?
  city             String?
  /// The price list / tier the customer is on, as text («جملة · فئة أ»). There is no
  /// price-list model; this records the agreement, it prices nothing.
  priceList        String?
  /// Agreed payment terms in days (0–365).
  paymentTermsDays Int?
  /// Agreed credit limit in SAR. Displayed only.
  creditLimit      Decimal?          @db.Decimal(18, 2)
  /// The employee responsible for the account («المسؤول»).
  accountOwnerId   String?
  accountOwner     Employee?         @relation("CustomerAccountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  contacts         CustomerContact[]
  /// The customer file's documents (additive, migration 20261027120000_customer_file).
  files            CustomerFile[]

  // ─── Credit warnings and the sales hold (additive, migration 20261028100000_credit_hold) ──
  /// «مدة الإيقاف الافتراضية»: the duration (days, 1–365) the «إيقاف البيع» dialog proposes.
  /// NULL = not set (the dialog proposes 14 days).
  defaultHoldDays Int?
  /// Every hold placed on this customer (at most one unlifted — partial unique index).
  salesHolds      CustomerSalesHold[]
  /// Append-only: every grace, hold, lift and automatic lift.
  creditLog       CustomerCreditLog[]

  // ─── New-client commission exclusion (additive, 20261101090000_commission_builder) ──────
  /// «مستثنى من عمولة العميل الجديد»: the customer was in the active client base or already in
  /// negotiation before the salesperson started (commission policy, section A). No such flag
  /// existed on the customer or on deal assignment, so it is a manual decision by a sales
  /// manager. While true, the order-sequence component pays the plan's existing-client rate.
  newClientCommissionExcluded Boolean           @default(false)
  /// Why (required while excluded; CHECK).
  newClientExclusionReason    String?
  newClientExclusionById      String?
  newClientExclusionAt        DateTime?
  /// Opening setup «تهيئة العملاء الحاليين قبل تفعيل العمولات»: how many collected orders this
  /// customer already had before commissions were activated, so the next is order N+1 of the
  /// sequence. NULL = not set: a customer created before the activation date is then an EXISTING
  /// client (existing-client rate); a customer created after it follows the new-client rules.
  commissionPriorOrders       Int?
  /// «مساحة عملي» (additive, 20261108090000_my_workspace): relation fields only.
  workTasks                   WorkTask[]        @relation("WorkTaskCustomer")
  workAppointments            WorkAppointment[] @relation("WorkAppointmentCustomer")

  @@index([accountOwnerId])
}

/// «إيقاف البيع» — a manual sales hold, placed by a person holding customers › sales_hold (never
/// automatically). While it is in force, no new quotation or order is created for the customer
/// (services/customers/credit-db.ts assertSalesAllowed, 409 CUSTOMER_SALES_HOLD); existing orders and
/// deliveries continue. Lifted in place: by hand (MANUAL), or — checked on read and at creation,
/// never by a job — at its end (EXPIRED, when autoLiftAtEnd) or when the customer is back within
/// the limit with nothing overdue (PAID, when autoLiftOnPayment). Additive, 20261028100000_credit_hold.
model CustomerSalesHold {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason            String
  /// What the warning said when the hold was placed: OVER_LIMIT | OVERDUE | BOTH | OTHER (CHECK).
  basis             String
  startsAt          DateTime  @default(now())
  /// NULL = «حتى السداد» / open-ended.
  endsAt            DateTime?
  autoLiftAtEnd     Boolean   @default(false)
  autoLiftOnPayment Boolean   @default(false)
  createdById       String?
  createdBy         Employee? @relation("CustomerHoldCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  liftedAt          DateTime?
  liftedById        String?
  liftedBy          Employee? @relation("CustomerHoldLifter", fields: [liftedById], references: [id], onDelete: SetNull)
  /// MANUAL | EXPIRED | PAID (CHECK).
  liftKind          String?
  liftReason        String?

  @@index([customerId, createdAt])
}

/// The customer's credit log («سجل الائتمان»): GRACE (days, untilAt, reason), HOLD, LIFT and
/// AUTO_LIFT (holdId). Append-only by convention — the application never updates or deletes a row.
/// Shown in the customer file's activity. Additive, 20261028100000_credit_hold.
model CustomerCreditLog {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// GRACE | HOLD | LIFT | AUTO_LIFT (CHECK).
  kind       String
  holdId     String?
  days       Int?
  untilAt    DateTime?
  reason     String?
  /// The standing at the time (overLimit, overdueDays) and the hold's options.
  detail     Json?
  actorId    String?
  actor      Employee? @relation("CustomerCreditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

/// A person at a customer (Figma crm-account «جهات الاتصال»): a café has a buyer, an
/// accountant and an owner, and none of them is the customer. Customer.phone / email stay the
/// customer's own particulars; contacts are additional.
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  /// Free text: «مدير المشتريات», «المالية».
  role       String?
  phone      String?
  email      String?
  /// Display order within the customer (ascending).
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, position])
}

/// A document on the customer's file — the account page's «الملفات» tab (Figma crm-account
/// 179:1312): a signed contract, the commercial register, the VAT certificate, a price agreement.
///
/// Where the bytes live (20261028100000_credit_hold): new uploads go to the PRIVATE Vercel Blob store
/// when one is configured (`blobPathname`, up to 20 MB), and stay in `content` otherwise (5 MB) —
/// local development and tests, and every file uploaded before. PDF / JPEG / PNG (CHECKs in the
/// migrations). `lib/services/customers/files.ts` is the only reader and writer of the bytes; the
/// download route streams them and never hands the browser a Blob URL. Additive, migrations
/// 20261027120000_customer_file and 20261028100000_credit_hold.
model CustomerFile {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// CONTRACT | REGISTRATION | TAX | PRICE_AGREEMENT | OTHER (CHECK).
  category     String
  /// What the file is, in the uploader's words («عقد التوريد 2026»).
  title        String
  /// Safe filename (no separators, quotes or control characters; extension from the bytes).
  fileName     String
  /// The type proven by the file's own signature, never the browser's claim.
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes.
  sha256       String
  /// The bytes, for a file stored in the row (every file before 20261028100000_credit_hold, and
  /// every file while no Blob store is configured). NULL for a file in the private Blob store.
  content      Bytes?
  /// The private Vercel Blob pathname (customers/<customerId>/<fileId>-<safe name>) of a file kept
  /// in the Blob store; never sent to the browser. Exactly one of content / blobPathname (CHECK).
  blobPathname String?   @unique
  uploadedById String?
  uploadedBy   Employee? @relation("CustomerFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
}

/// A direct browser-to-Blob upload in flight (additive, migration 20261029100000_blob_client_upload).
/// Created when the server hands out an upload slot for ONE exact pathname; deleted when the upload is
/// finalized into a CustomerFile (same id), refused at finalize (the blob is deleted), or swept as an
/// orphan an hour later (the blob is deleted). Only this database's own slots are ever swept, so an
/// environment never deletes a blob it did not authorize. No FK to Customer on purpose: a slot outlives
/// its customer's deletion so that its blob is still swept.
model CustomerFileUpload {
  /// The id the CustomerFile row will take (cf + 24 hex), also inside the pathname.
  id             String    @id
  customerId     String
  /// customers/<customerId>/<id>-<safe name> — the ONLY pathname the upload token is scoped to.
  pathname       String    @unique
  category       String
  title          String?
  /// The uploader's file name (the stored name takes its extension from the bytes at finalize).
  fileName       String
  /// What the browser declared; the finalize step checks the blob itself.
  declaredBytes  Int
  declaredType   String
  requestedById  String?
  requestedBy    Employee? @relation("CustomerFileUploadRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  /// The upload token's own expiry (short); the slot itself may be finalized for up to 50 minutes.
  tokenExpiresAt DateTime

  @@index([createdAt])
  @@index([customerId])
}

model GreenBean {
  id               String                    @id @default(cuid())
  serialNumber     String                    @unique
  beanType         String
  beanTypeAr       String?
  country          String
  countryAr        String?
  region           String?
  regionAr         String?
  variety          String?
  process          String?
  processAr        String?
  altitude         String?
  location         String?
  quantityKg       Float                     @default(0)
  isActive         Boolean                   @default(true)
  receivedDate     DateTime                  @default(now())
  /// The label's barcode payload (20261114090000_green_lot_labels): 'GL-00042', from a sequence, never reused. The
  /// serial number stays free text; this is what a scanner reads.
  labelCode        String                    @unique @default(dbgenerated("('GL-'::text || lpad((nextval('\"GreenBean_labelCode_seq\"'::regclass))::text, 5, '0'::text))"))
  /// Per-sack labels: «كيس 3 من 15» (1–999 sacks; the weight only with a count). Both nullable.
  sackCount        Int?
  sackWeightKg     Float?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  orderItems       OrderItem[]
  roastingBatches  RoastingBatch[]
  cuppingSessions  CuppingSession[]
  roastPreferences CustomerRoastPreference[]
  coffeeProducts   CoffeeProduct[]
  roastProfiles    RoastProfile[]
  productionOrders ProductionOrder[]

  @@index([isActive])
  @@index([isActive, quantityKg])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       Int         @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  quotationNumber   String?
  quotationSentDate DateTime?
  approvalStatus    String      @default("Pending") // Pending, Yes, No
  approvalDate      DateTime?
  paymentStatus     String      @default("Not Paid") // Paid, Not Paid, Partial Paid
  vatInvoiceStatus  String      @default("Not Yet") // Sent, Not Yet, Not Paid
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]

  // ─── Order Operations S0 (additive) ──────────────────────────────────────
  // Backend-controlled lifecycle status — independent of approvalStatus above,
  // never accepted through the generic create/update payloads. String (not enum)
  // to match the existing convention on this model (approvalStatus/paymentStatus/
  // vatInvoiceStatus are also plain strings, not Prisma enums).
  // Values: Waiting Approval, Waiting Preparation Review, Preparing,
  // Ready for Shipping, Completed, On Hold, Cancelled, Rejected
  status  String    @default("Waiting Approval")
  ownerId String?
  owner   Employee? @relation("OrderOwner", fields: [ownerId], references: [id])

  activities OrderActivity[]

  // Workstations W4 (additive, relation fields only): the station's verified picks and the
  // ready-for-dispatch handoffs of this order (J-18).
  preparationPicks PreparationPick[]
  dispatchHandoffs DispatchHandoff[]

  // Sales CRM (additive, relation fields only).
  opportunityLinks OpportunityOrder[]
  collectionEvents CollectionEvent[]
  salesCollections SalesCollection[]

  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([ownerId])
}

model OrderItem {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  greenBeanId      String?
  greenBean        GreenBean?        @relation(fields: [greenBeanId], references: [id])
  productId        String?
  product          CoffeeProduct?    @relation(fields: [productId], references: [id])
  productSkuId     String?
  productSku       ProductSKU?       @relation(fields: [productSkuId], references: [id])
  beanTypeName     String
  quantityKg       Float
  productionStatus String            @default("Pending") // Pending, In Production, Completed, Order cancelled
  deliveryStatus   String            @default("Not Yet") // Not Yet, Partial Delivered, Delivered
  deliveredQty     Float             @default(0)
  remainingQty     Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  roastingBatches  RoastingBatch[]
  deliveries       Delivery[]
  productionOrders ProductionOrder[]

  // ─── Order Operations S0 (additive) ──────────────────────────────────────
  // Written only by POST /api/orders/[id]/preparation-review — never by the
  // generic order edit route. Float to match quantityKg/deliveredQty/remainingQty
  // above — this model has no Decimal fields to stay consistent with.
  // Since the shelf-allocation change these three are SERVER-DERIVED, never client
  // supplied: availableQuantity is the sum of RESERVED StockAllocation rows for this
  // item and productionRequiredQuantity is the outstanding remainder.
  preparationDecision        String? // Available on Shelf, Needs Production, Partially Available, Blocked
  availableQuantity          Float?
  productionRequiredQuantity Float?

  allocations StockAllocation[]

  // Workstations W4 (additive, relation fields only).
  preparationPicks     PreparationPick[]
  dispatchHandoffLines DispatchHandoffLine[]

  // ─── SKU-based sales lines ───────────────────────────────────────────────
  // A line created through the Finished Products flow sells whole units of one SKU:
  // `productSkuId` is set and `quantityUnits` is authoritative. `quantityKg` is still
  // written, derived as units x (weightGrams / 1000), because delivery, production and
  // every report downstream read it — it is a projection of units, not a rival total.
  //
  // Legacy lines (26 of the 35 that existed at the time of this change) have
  // quantityUnits = null and only quantityKg. They stay readable and deliverable but
  // no new line may be created that way: order creation now requires a valid SKU.
  quantityUnits  Int?
  deliveredUnits Int  @default(0)

  @@index([productionStatus])
  @@index([deliveryStatus])
  @@index([productionStatus, deliveryStatus])
  @@index([productSkuId])
}

model RoastingBatch {
  id String @id @default(cuid())

  // Optional since roast-to-stock. A batch with no order item is a deliberate
  // replenishment of the shelf: it consumes green stock and writes the same ledger
  // entries as any other roast, but its packaged output is reserved to nobody and
  // becomes free-to-promise for whichever order needs it first. Every batch created
  // before this change carries an order item, and the order-driven path still sets one.
  orderItemId         String?
  orderItem           OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchNumber         String
  date                DateTime       @default(now())
  greenBeanId         String?
  greenBean           GreenBean?     @relation(fields: [greenBeanId], references: [id])
  productId           String?
  product             CoffeeProduct? @relation(fields: [productId], references: [id])
  greenBeanQuantity   Float
  roastedBeanQuantity Float          @default(0)
  wasteQuantity       Float          @default(0)
  roastProfile        String?
  status              String         @default("Pending QC")

  // Packaging (filled post-QC)
  bags3kg      Int   @default(0)
  bags1kg      Int   @default(0)
  bags250g     Int   @default(0)
  bags150g     Int   @default(0)
  samplesGrams Float @default(0)

  // ─── Roasted / intermediate stock ────────────────────────────────────────
  // Roasted coffee from this batch that has not yet been packed into a finished SKU.
  // This is the intermediate stage the finished-goods BOM draws on: roasting raises it,
  // packaging lowers it. Green coffee is consumed by roasting alone and never by a BOM.
  //
  // Seeded from roastedBeanQuantity minus what this batch had already packed at
  // migration time, so existing batches do not suddenly present already-packed coffee
  // as available. A CHECK constraint keeps it within [0, roastedBeanQuantity].
  roastedAvailableKg Float @default(0)

  // Blending lineage
  isBlend       Boolean         @default(false) // true = this is a blend output, NOT new production
  blendTiming   String?
  parentBatchId String?
  parentBatch   RoastingBatch?  @relation("BlendLineage", fields: [parentBatchId], references: [id])
  childBatches  RoastingBatch[] @relation("BlendLineage")

  // Multi-tester QC panel
  qcDeadline            DateTime?
  qcToken               String?   @unique
  qcClosedById          String?
  qcFinalDecisionReason String?

  // ─── QC exceptional approval (additive, migration 20261023090000_production_qc_simplify) ───
  /// Owner decision D2: true when the QC decision was taken with fewer evaluators than the minimum
  /// in force (SystemConfig.qcMinEvaluators, default 2), by a holder of qc › finalize_override, with
  /// a written reason and an explicit confirmation. NULL = no exceptional approval (every batch
  /// before this column, and every normal decision). CHECK: true ⇒ reason, actor and time present.
  qcOverride       Boolean?
  qcOverrideReason String?
  qcOverrideById   String?
  qcOverrideAt     DateTime?
  /// The minimum in force when the exceptional approval was taken (the setting may change later).
  qcOverrideMin    Int?

  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  // ─── Roasting station W1 (additive, migration 20261025090000_station_w1) ───
  /// The roaster this batch was roasted on (Settings › Production & roasting › Roasters). NULL =
  /// none chosen: every batch before this column, and every roast recorded without a roaster
  /// (no roaster configured), exactly as before. No FK (audit convention, like RoasterOperator.employeeId).
  roasterId  String?
  /// Client-supplied Idempotency-Key of the POST that recorded this batch (same pattern as
  /// Delivery.requestKey). Nullable: a caller that sends none records as before. Unique, so two
  /// retries of one roast collapse to a single batch.
  requestKey String? @unique
  /// SHA-256 over the normalized roast intent: the same key with a different intent is a 422.
  intentHash String?

  /// Roasting schedule (RM6–RM8, migration 20261026090000_roast_schedule): the planned slot this
  /// batch was recorded from, or NULL (recorded without a slot — every batch before the schedule).
  /// Planned and actual stay separate: the slot keeps its planned green, the batch its measured
  /// weights. One batch per slot (unique).
  scheduledSlotId String?        @unique
  scheduledSlot   ScheduledSlot? @relation(fields: [scheduledSlotId], references: [id], onDelete: SetNull)

  // ─── QC station W3 (additive, migration 20261031090000_station_w3_qc) ───
  /// The roast-profile version this batch was roasted to: the product's APPROVED version when the
  /// batch was recorded (stored, never re-derived). NULL = none approved then — every batch before
  /// this column, and every batch of a profile still in development: its QC shows «المواصفة قيد
  /// المعايرة» (manual, documented acceptance; no numeric conformity). A batch is never its own reference.
  profileVersionId       String?
  profileVersion         RoastProfileVersion? @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  /// «محجوزة» (status "QC Hold"): when, by which inspection, and whether the hold is for foreign
  /// objects / contamination — such a hold is NEVER released by a commercial exception.
  qcHoldAt               DateTime?
  qcHoldRecordId         String?
  qcHoldForeignObject    Boolean?
  /// The approved QcException that released this batch (QEX-…) and the use it permits.
  qcExceptionId          String?
  qcPermittedUse         String?
  /// Converted from another product by an approved disposition (the product it was roasted as).
  convertedFromProductId String?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  qcRecords             QcRecord[]
  cuppingSessions       CuppingSession[]
  cuppingSessionBatches CuppingSessionBatch[]
  blendInputs           BlendIngredient[]     @relation("BlendTarget")
  blendOutputs          BlendIngredient[]     @relation("BlendSource")
  finishedGoodsLots     FinishedGoodsLot[]
  packedLots            FinishedGoodsLot[]    @relation("PackedFromBatch")
  /// Grams this roast contributed to packaged lots, including top-ups of packages that were
  /// originally filled from a different roast.
  packagingSources      PackagingSource[]     @relation("PackagingSourceBatch")
  serialHistory         BatchSerialHistory[]
  qcInvites             QcInvite[]
  packagingOperations   PackagingOperation[]
  qcExceptions          QcException[]
  qcDispositions        QcDisposition[]
  profileTrials         RoastProfileTrial[]

  @@unique([greenBeanId, batchNumber])
  @@index([greenBeanId, createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([roasterId, createdAt])
  @@index([profileVersionId])
}

model BlendIngredient {
  id                 String        @id @default(cuid())
  sourceBatchId      String
  sourceBatch        RoastingBatch @relation("BlendSource", fields: [sourceBatchId], references: [id], onDelete: Cascade)
  targetBlendBatchId String
  targetBlendBatch   RoastingBatch @relation("BlendTarget", fields: [targetBlendBatchId], references: [id], onDelete: Cascade)
  quantityUsed       Float
  createdAt          DateTime      @default(now())
}

model QcRecord {
  id                String                @id @default(cuid())
  batchId           String
  batch             RoastingBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date              DateTime              @default(now())
  coffeeOrigin      String
  processing        String
  serialNumber      String
  onProfile         Boolean               @default(false)
  underDeveloped    Boolean               @default(false)
  overDeveloped     Boolean               @default(false)
  color             Int?
  colorWhole        Float?
  colorGround       Float?
  remarks           String?
  // Multi-tester panel fields
  employeeId        String?
  employee          Employee?             @relation(fields: [employeeId], references: [id])
  isExternal        Boolean               @default(false)
  testerName        String?
  decision          String                @default("Accept") // "Accept" or "Reject"
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  correctionHistory QcCorrectionHistory[]

  // ─── QC station W3 inspection (additive, migration 20261031090000_station_w3_qc) ───
  // NULL on every panel record (the legacy evaluator form, guests). An inspection («فحص بالقياس»)
  // has kind INSPECTION and freezes what it was judged against: specSnapshot holds the profile
  // version's spec as it stood (or state CALIBRATING), so a later version never changes a past
  // result. Verdicts are computed by the server against that snapshot.
  /// INSPECTION | NULL (panel record)
  kind               String?
  /// Idempotency-Key of the POST that recorded it (station and ERP send one); intent hash beside it.
  requestKey         String?  @unique
  intentHash         String?
  profileVersionId   String?
  specSnapshot       Json?
  wholeDevice        String?
  wholeScale         String?
  groundDevice       String?
  groundScale        String?
  /// LIGHTER | ON_TARGET | DARKER — only against an APPROVED snapshot (never inferred development).
  wholeVerdict       String?
  groundVerdict      String?
  defectUneven       Boolean?
  defectScorched     Boolean?
  defectPale         Boolean?
  defectForeign      Boolean?
  /// CONFORMING | NON_CONFORMING | NEEDS_REVIEW
  sensoryResult      String?
  sensoryNotes       String?
  sensoryRequired    Boolean?
  /// APPROVAL | FIRST_OF_DAY | DEVIATION (why the server required it)
  sensoryRequiredWhy String?
  cuppingScore       Float?
  moisturePct        Float?
  densityGL          Float?
  /// Roast loss of the batch (green → roasted), copied for reference only: never re-entered, never a hold.
  lossPct            Float?
  /// Under calibration: ACCEPT | HOLD, with the documented note.
  manualDecision     String?
  manualNote         String?
  /// RELEASED | HELD | AWAITING_EVALUATORS (conforming, below the QC minimum of evaluators)
  outcome            String?
  /// Why it was held: WHOLE_OUT, GROUND_OUT, DEFECT_UNEVEN, DEFECT_SCORCHED, DEFECT_PALE,
  /// FOREIGN_OBJECT, SENSORY_NON_CONFORMING, SENSORY_REVIEW, MANUAL_HOLD.
  holdReasons        Json?
  /// A re-inspection names the inspection it follows; after a foreign-object hold, the cleaning done.
  reinspectionOfId   String?
  cleaningNote       String?
  stationId          String?

  @@index([date])
  @@index([batchId, date])
  @@index([kind, createdAt])
  @@index([profileVersionId])
}

/// A guest evaluator invited to a batch's QC panel (owner decision D4, migration
/// 20261023090000_production_qc_simplify). Only qc › manage invites. PRESENT = evaluates on the
/// inviting device; LINK = sent the batch's guest link (WhatsApp under AutomationSettings.sendMode,
/// or copied). PENDING until a guest record with the same name arrives (DONE), or the panel is
/// finalized / the invite withdrawn (CANCELLED). Holds no customer or order data.
model QcInvite {
  id          String        @id @default(cuid())
  batchId     String
  batch       RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// PRESENT | LINK
  channel     String
  name        String
  /// Normalised international digits when a WhatsApp number was given.
  phone       String?
  /// PENDING | DONE | CANCELLED
  status      String        @default("PENDING")
  /// The guest QcRecord that completed the invite.
  qcRecordId  String?
  /// The WhatsAppMessage queued for a LINK invite with a phone (ids only, audit convention).
  messageId   String?
  createdById String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  @@index([batchId, status])
}

model Delivery {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  quantityKg   Float
  deliveryType String // full, partial
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Units shipped, for deliveries against a SKU line. Null on legacy kg deliveries.
  // quantityKg stays populated in both cases (derived from units for SKU lines) so
  // dispatch history and the inventory ledger keep reading one field.
  quantityUnits Int?

  /// Client-supplied Idempotency-Key for the dispatch this row records. Nullable so the
  /// previous application version, which sends none, keeps inserting deliveries while this
  /// column already exists; unique so two concurrent retries of one dispatch collapse to a
  /// single shipment.
  requestKey String? @unique
  /// SHA-256 over a fixed-position array of the normalized dispatch intent. The same key
  /// carrying a different intent is a client error, not a second shipment.
  intentHash String?

  /// Which finished-goods lots this dispatch drew from (production simplification Phase D, gap
  /// G09). One row per lot; the rows' quantities sum to this delivery's quantityUnits /
  /// quantityKg. Empty on deliveries recorded before 20261023100000_delivery_lines: those carry
  /// their single lot only on the ledger (InventoryMovement OUT, sourceDocType DELIVERY,
  /// sourceDocId = this id), and readers fall back to it (services/delivery-lots.ts).
  lines DeliveryLine[]

  /// Phase 3: the site the dispatch shipped from (the production site; FG lots are not moved between sites yet).
  locationId String        @default(dbgenerated("stock_location_current()"))
  location   StockLocation @relation(fields: [locationId], references: [id])

  @@index([date])
  @@index([locationId])
}

/// One lot's share of one Delivery. Written in the same transaction as the Delivery and the
/// InventoryMovement OUT of that lot, never edited afterwards.
model DeliveryLine {
  id                 String           @id @default(cuid())
  deliveryId         String
  delivery           Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  finishedGoodsLotId String
  finishedGoodsLot   FinishedGoodsLot @relation(fields: [finishedGoodsLotId], references: [id])
  /// Whole units drawn from this lot (SKU lines); null on a kilogram line.
  quantityUnits      Int?
  /// Kilograms drawn from this lot — derived from units on a SKU line, as on Delivery.
  quantityKg         Float
  createdAt          DateTime         @default(now())

  @@unique([deliveryId, finishedGoodsLotId])
  @@index([finishedGoodsLotId])
}

model CuppingSession {
  id             String                @id @default(cuid())
  name           String
  date           DateTime              @default(now())
  status         String                @default("Open")
  sessionToken   String?               @unique
  batchId        String?
  greenBeanId    String?
  batch          RoastingBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  greenBean      GreenBean?            @relation(fields: [greenBeanId], references: [id], onDelete: SetNull)
  sessionBatches CuppingSessionBatch[]
  scores         CuppingScore[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // Closure record (E6 / C-1…C-5). All null on a session that is still open, and on every
  // session closed before the close policy existed: those are not reclassified
  // retroactively (C-4) and display as plain «مغلقة».
  /// COMPLETE: closed with at least the minimum of distinct staff scorers.
  /// INCOMPLETE: closed by an administrator below the minimum, with a mandatory reason.
  closeKind         String?
  closedAt          DateTime?
  /// Employee.id, denormalized — no FK relation (the QcCorrectionHistory convention), so the
  /// record survives the employee row.
  closedById        String?
  closedByName      String?
  closeReason       String?   @db.Text
  /// The minimum that applied to this session when it was closed (snapshot of CuppingSettings).
  minScorersAtClose Int?
  /// Distinct authenticated staff scorers when it was closed (guests never count, C-3).
  scorersAtClose    Int?

  @@index([status])
}

/// Singleton. The administrator-configurable cupping close policy (E6, C-5): range 2–20,
/// enforced by the API and by a CHECK constraint.
model CuppingSettings {
  id          String   @id @default("singleton")
  minScorers  Int      @default(2)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Append-only (DB trigger): every cupping session closure and every change of the cupping
/// settings. No FK to the session, so the history outlives a deleted session.
model CuppingAuditLog {
  id         String   @id @default(cuid())
  /// SESSION_CLOSED | SETTINGS_UPDATED
  action     String
  /// CuppingSession | CuppingSettings
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?  @db.Text
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model CuppingSessionBatch {
  id                   String         @id @default(cuid())
  sessionId            String
  session              CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  batchId              String?
  batch                RoastingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  isExternalSample     Boolean        @default(false)
  externalSampleName   String?
  externalSupplierName String?
  order                Int            @default(0)
  scores               CuppingScore[]
  createdAt            DateTime       @default(now())
}

model CuppingScore {
  id                String               @id @default(cuid())
  sessionId         String
  session           CuppingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionBatchId    String?
  sessionBatch      CuppingSessionBatch? @relation(fields: [sessionBatchId], references: [id], onDelete: SetNull)
  employeeId        String?
  employee          Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  externalName      String?
  fragranceAroma    Float                @default(7)
  flavor            Float                @default(7)
  aftertaste        Float                @default(7)
  acidity           Float                @default(7)
  body              Float                @default(7)
  balance           Float                @default(7)
  uniformity        Float                @default(10)
  cleanCup          Float                @default(10)
  sweetness         Float                @default(10)
  overall           Float                @default(7)
  defectCups        Int                  @default(0)
  defectType        String               @default("none")
  finalScore        Float                @default(0)
  notes             String?              @db.Text
  flavorDescriptors String[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model SystemConfig {
  id         String  @id @default("singleton")
  logoBase64 String? @db.Text

  // ─── Quotations (additive, migration 20261021090000_sales_quotes) ─────────────────────
  /// Discount (percent of the subtotal) above which issuing a quotation needs approval by a
  /// holder of sales › quote_approve_discount. NULL = not set by the owner: the built-in policy
  /// value (DISCOUNT_APPROVAL_THRESHOLD, 10%) applies, exactly as before this column existed.
  /// CHECK 0–60 (DISCOUNT_MAX, the hard ceiling no approval passes).
  quoteDiscountApprovalPercent Decimal? @db.Decimal(5, 2)
  /// The seller block of the quotation document. All optional; an empty field is not printed.
  sellerLegalNameAr            String?
  sellerLegalNameEn            String?
  sellerAddressAr              String?
  sellerAddressEn              String?
  /// VAT registration number (15 digits, starts and ends with 3; validated by the API).
  sellerVatNumber              String?
  /// Commercial registration number (digits; validated by the API).
  sellerCrNumber               String?
  sellerPhone                  String?
  /// Bank transfer details printed on the quotation («بيانات التحويل البنكي»). All optional; the
  /// section is not printed while all three are empty. Frozen into the issued snapshot with the
  /// seller block.
  sellerBankName               String?
  sellerBankAccountName        String?
  /// Saudi IBAN, stored normalised: «SA» + 22 digits, no spaces (validated by the API).
  sellerIban                   String?

  // ─── Settings sections (additive, migration 20261022110000_settings_sections) ─────────
  /// Settings › Inventory: green coffee below this many kg is flagged «مخزون منخفض» on the
  /// inventory screen. NULL = not set by the owner: the built-in 20 kg applies, exactly as
  /// before this column existed. CHECK > 0 and ≤ 100000.
  inventoryLowStockGreenKg Decimal? @db.Decimal(10, 3)
  /// Settings › Invoicing & tax: the VAT percent a NEW quotation line starts with. NULL = the
  /// built-in 15%. Issued documents keep the rate each line carries. CHECK 0–100.
  invoiceDefaultVatPercent Decimal? @db.Decimal(5, 2)

  // ─── QC (additive, migration 20261023090000_production_qc_simplify) ─────────────────────
  /// Settings › Production & roasting › QC: the minimum number of evaluators a batch needs before
  /// the QC decision (owner decision D1). NULL = not set by the owner: the built-in 2 applies.
  /// CHECK 1–10. Fewer than this is an exceptional approval (qc › finalize_override, D2).
  qcMinEvaluators Int?

  // ─── Roasting station (additive, migration 20261116090000_station_lot_scan) ─────────────
  /// «تأكيد الكيس بالمسح في محطة التحميص». false (default): the station shows no scan — the server picks the lot
  /// (default, else FIFO at the production site) and the station shows «اسحب من». true: the scan is offered as an
  /// override (a different sack from the suggested one), never a mandatory step.
  stationLotScanRequired Boolean @default(false)

  // ─── Sales invoicing A2 (additive, migration 20261103090000_sales_invoicing) ─────────────
  /// «بادئة سلسلة الفواتير»: the series of a tax invoice number (INV → INV-000001). NULL = "INV".
  /// Each series has its own gapless counter (SalesDocumentCounter); a new prefix starts a new series.
  invoicePrefix           String?
  /// The credit note series. NULL = "CN".
  creditNotePrefix        String?
  /// The debit note series. NULL = "DN".
  debitNotePrefix         String?
  /// «نقطة الفوترة»: MANUAL (default, NULL) or ON_DELIVERY (a recorded delivery opens a DRAFT
  /// invoice for what it shipped; it is reviewed and issued by a person — never issued automatically).
  invoicingPoint          String?
  /// Default payment terms (days) of a new invoice when the customer has none. NULL = 30.
  invoiceDefaultTermsDays Int?
  /// The structured national address of the seller (ZATCA BR-KSA-09), frozen into every issued invoice.
  sellerBuildingNo        String?
  sellerStreet            String?
  sellerDistrict          String?
  sellerCity              String?
  sellerPostalCode        String?
  sellerAdditionalNo      String?

  // ─── Sign-in line (additive, migration 20261110090000_i18n_preferences) ──────────────────
  /// The line under the brand on the sign-in screen, per language (owner decision 1). NULL = the
  /// built-in line (src/lib/login-tagline.ts). CHECK 1–120 characters after trimming.
  loginTaglineAr String?
  loginTaglineEn String?
}

/// Settings › Production & roasting › Roasters (Figma 377:2, ROASTERS.md §4; RM1–RM5). Machine
/// configuration only: capacity and limits are for planning and validation, never the source of a
/// roasted weight or a loss (those come from each RoastingBatch). Retired, never deleted.
/// CHECKs (migration): 0 < min ≤ target ≤ max ≤ nominal, 0 < cycle ≤ 1440, a reason for
/// MAINTENANCE / STOPPED; unique name (case-insensitive) and one default per type (partial index).
model Roaster {
  id                String               @id @default(cuid())
  name              String
  /// «الشركة المصنّعة والطراز» — optional free text.
  manufacturerModel String?
  /// PRODUCTION | SAMPLE
  type              String
  nominalCapacityKg Decimal              @db.Decimal(10, 3)
  defaultTargetKg   Decimal              @db.Decimal(10, 3)
  minBatchKg        Decimal              @db.Decimal(10, 3)
  maxBatchKg        Decimal              @db.Decimal(10, 3)
  cycleMinutes      Int
  /// Employee id (no FK, audit convention): must be assigned and hold production › start_batch.
  defaultOperatorId String?
  /// AVAILABLE | MAINTENANCE | STOPPED | RETIRED
  status            String               @default("AVAILABLE")
  statusReason      String?
  statusUntil       DateTime?
  statusSince       DateTime             @default(now())
  isDefault         Boolean              @default(false)
  createdById       String?
  updatedById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  /// Scheduling (RM6–RM8, migration 20261026090000_roast_schedule): the working days and hours slots
  /// are placed in, Asia/Riyadh, 0 = Sunday — {"days":[0,1,2,3,4],"start":"07:00","end":"15:00"}.
  /// NULL = not set by the owner: the built-in Sunday–Thursday 07:00–15:00 applies (ROASTERS.md §4,
  /// illustrative until confirmed, D6). Changing it never moves an approved slot (§5.11).
  workingHours      Json?
  maintenance       RoasterMaintenance[]
  scheduledSlots    ScheduledSlot[]
  roastPlans        RoastPlan[]
  operators         RoasterOperator[]

  @@index([type, status])
}

/// A maintenance window of a roaster (RM4 «الصيانة»): planned, in progress, done or cancelled.
model RoasterMaintenance {
  id              String   @id @default(cuid())
  roasterId       String
  roaster         Roaster  @relation(fields: [roasterId], references: [id], onDelete: Restrict)
  title           String
  /// ROUTINE | ONE_OFF
  kind            String
  /// ROUTINE only: every N weeks (descriptive; nothing generates the next window).
  recurrenceWeeks Int?
  startsAt        DateTime
  endsAt          DateTime
  /// PLANNED | IN_PROGRESS | DONE | CANCELLED
  status          String   @default("PLANNED")
  /// Employee id (no FK): «بطلب …».
  requestedById   String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roasterId, startsAt])
}

/// RM5: who is ASSIGNED to a roaster. Authorization is not stored here — it is the role
/// permission production › start_batch, read at the time; an assignment of somebody who no longer
/// holds it is inactive and cannot be made.
model RoasterOperator {

model SystemConfig {
  id         String  @id @default("singleton")
  logoBase64 String? @db.Text

  // ─── Quotations (additive, migration 20261021090000_sales_quotes) ─────────────────────
  /// Discount (percent of the subtotal) above which issuing a quotation needs approval by a
  /// holder of sales › quote_approve_discount. NULL = not set by the owner: the built-in policy
  /// value (DISCOUNT_APPROVAL_THRESHOLD, 10%) applies, exactly as before this column existed.
  /// CHECK 0–60 (DISCOUNT_MAX, the hard ceiling no approval passes).
  quoteDiscountApprovalPercent Decimal? @db.Decimal(5, 2)
  /// The seller block of the quotation document. All optional; an empty field is not printed.
  sellerLegalNameAr            String?
  sellerLegalNameEn            String?
  sellerAddressAr              String?
  sellerAddressEn              String?
  /// VAT registration number (15 digits, starts and ends with 3; validated by the API).
  sellerVatNumber              String?
  /// Commercial registration number (digits; validated by the API).
  sellerCrNumber               String?
  sellerPhone                  String?
  /// Bank transfer details printed on the quotation («بيانات التحويل البنكي»). All optional; the
  /// section is not printed while all three are empty. Frozen into the issued snapshot with the
  /// seller block.
  sellerBankName               String?
  sellerBankAccountName        String?
  /// Saudi IBAN, stored normalised: «SA» + 22 digits, no spaces (validated by the API).
  sellerIban                   String?

  // ─── Settings sections (additive, migration 20261022110000_settings_sections) ─────────
  /// Settings › Inventory: green coffee below this many kg is flagged «مخزون منخفض» on the
  /// inventory screen. NULL = not set by the owner: the built-in 20 kg applies, exactly as
  /// before this column existed. CHECK > 0 and ≤ 100000.
  inventoryLowStockGreenKg     Decimal? @db.Decimal(10, 3)
  /// Settings › Invoicing & tax: the VAT percent a NEW quotation line starts with. NULL = the
  /// built-in 15%. Issued documents keep the rate each line carries. CHECK 0–100.
  invoiceDefaultVatPercent     Decimal? @db.Decimal(5, 2)

  // ─── QC (additive, migration 20261023090000_production_qc_simplify) ─────────────────────
  /// Settings › Production & roasting › QC: the minimum number of evaluators a batch needs before
  /// the QC decision (owner decision D1). NULL = not set by the owner: the built-in 2 applies.
  /// CHECK 1–10. Fewer than this is an exceptional approval (qc › finalize_override, D2).
  qcMinEvaluators              Int?
}

/// Settings › Production & roasting › Roasters (Figma 377:2, ROASTERS.md §4; RM1–RM5). Machine
/// configuration only: capacity and limits are for planning and validation, never the source of a
/// roasted weight or a loss (those come from each RoastingBatch). Retired, never deleted.
/// CHECKs (migration): 0 < min ≤ target ≤ max ≤ nominal, 0 < cycle ≤ 1440, a reason for
/// MAINTENANCE / STOPPED; unique name (case-insensitive) and one default per type (partial index).
model Roaster {
  id                String              @id @default(cuid())
  name              String
  /// «الشركة المصنّعة والطراز» — optional free text.
  manufacturerModel String?
  /// PRODUCTION | SAMPLE
  type              String
  nominalCapacityKg Decimal             @db.Decimal(10, 3)
  defaultTargetKg   Decimal             @db.Decimal(10, 3)
  minBatchKg        Decimal             @db.Decimal(10, 3)
  maxBatchKg        Decimal             @db.Decimal(10, 3)
  cycleMinutes      Int
  /// Employee id (no FK, audit convention): must be assigned and hold production › start_batch.
  defaultOperatorId String?
  /// AVAILABLE | MAINTENANCE | STOPPED | RETIRED
  status            String              @default("AVAILABLE")
  statusReason      String?
  statusUntil       DateTime?
  statusSince       DateTime            @default(now())
  isDefault         Boolean             @default(false)
  createdById       String?
  updatedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  /// Scheduling (RM6–RM8, migration 20261026090000_roast_schedule): the working days and hours slots
  /// are placed in, Asia/Riyadh, 0 = Sunday — {"days":[0,1,2,3,4],"start":"07:00","end":"15:00"}.
  /// NULL = not set by the owner: the built-in Sunday–Thursday 07:00–15:00 applies (ROASTERS.md §4,
  /// illustrative until confirmed, D6). Changing it never moves an approved slot (§5.11).
  workingHours      Json?
  maintenance       RoasterMaintenance[]
  scheduledSlots    ScheduledSlot[]
  roastPlans        RoastPlan[]
  operators         RoasterOperator[]

  @@index([type, status])
}

/// A maintenance window of a roaster (RM4 «الصيانة»): planned, in progress, done or cancelled.
model RoasterMaintenance {
  id              String   @id @default(cuid())
  roasterId       String
  roaster         Roaster  @relation(fields: [roasterId], references: [id], onDelete: Restrict)
  title           String
  /// ROUTINE | ONE_OFF
  kind            String
  /// ROUTINE only: every N weeks (descriptive; nothing generates the next window).
  recurrenceWeeks Int?
  startsAt        DateTime
  endsAt          DateTime
  /// PLANNED | IN_PROGRESS | DONE | CANCELLED
  status          String   @default("PLANNED")
  /// Employee id (no FK): «بطلب …».
  requestedById   String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roasterId, startsAt])
}

/// RM5: who is ASSIGNED to a roaster. Authorization is not stored here — it is the role
/// permission production › start_batch, read at the time; an assignment of somebody who no longer
/// holds it is inactive and cannot be made.
model RoasterOperator {
  id          String   @id @default(cuid())
  roasterId   String
  roaster     Roaster  @relation(fields: [roasterId], references: [id], onDelete: Cascade)
  /// Employee id (no FK, audit convention).
  employeeId  String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([roasterId, employeeId])
}

/// Roaster controls at «تسجيل دفعة» (owner decision D5, ROASTERS.md §5.12; migration
/// 20261025090000_station_w1). Append-only by the application; no FK (audit convention). One row per
/// exception the server let through, written in the same transaction as the batch it belongs to:
///   CAPACITY_ACK           green outside the roaster's min–max, recorded only with an explicit
///                          acknowledgement (ack: true). Above nominal is never recorded at all.
///   OPERATOR_ADMIN_BYPASS  an admin who is not an assigned RoasterOperator of the roaster recorded
///                          on it (admins are never blocked; the bypass is kept visible).
model RoasterControlLog {
  id              String   @id @default(cuid())
  kind            String
  roasterId       String
  roasterName     String
  batchId         String?
  batchNumber     String?
  requestKey      String?
  employeeId      String
  employeeName    String
  employeeRole    String
  greenKg         Decimal  @db.Decimal(10, 3)
  nominalKg       Decimal  @db.Decimal(10, 3)
  minKg           Decimal  @db.Decimal(10, 3)
  maxKg           Decimal  @db.Decimal(10, 3)
  /// CAPACITY_ACK: BELOW_MIN | ABOVE_MAX. NULL otherwise.
  direction       String?
  /// WEB (ERP «تسجيل دفعة») | STATION (/station/roasting)
  sourceInterface String   @default("WEB")
  detail          Json?
  createdAt       DateTime @default(now())

  @@index([roasterId, createdAt])
  @@index([batchId])
  @@index([kind, createdAt])
}

/// Append-only (by the application; no FK, audit convention) trail of the settings sections of
/// migration 20261022110000: every change with its before / after.
model SettingsAuditLog {
  id         String   @id @default(cuid())
  /// production | inventory | invoicing
  section    String
  /// SETTINGS_UPDATED | ROASTER_CREATED | ROASTER_UPDATED | ROASTER_STATUS_CHANGED |
  /// MAINTENANCE_CREATED | MAINTENANCE_UPDATED | OPERATOR_ASSIGNED | OPERATOR_UNASSIGNED |
  /// ORDER_STATUS_RECOMPUTED (20261024090000_small_fixes)
  action     String
  entityType String
  entityId   String
  /// The field names that changed.
  changed    String[]
  before     Json?
  after      Json?
  reason     String?
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([section, createdAt])
}

model CustomerRoastPreference {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  greenBeanId           String
  greenBean             GreenBean @relation(fields: [greenBeanId], references: [id], onDelete: Cascade)
  profileName           String
  usageType             String    @default("BOTH")
  notes                 String?
  // Agtron color targets
  targetColorWhole      Float?
  targetToleranceWhole  Float?
  targetColorGround     Float?
  targetToleranceGround Float?
  targetDeltaMin        Float?
  targetDeltaMax        Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([customerId, greenBeanId])
}

model CoffeeProduct {
  id                 String             @id @default(cuid())
  productNameEn      String
  productNameAr      String?
  countryEn          String
  countryAr          String?
  regionEn           String?
  regionAr           String?
  varietyEn          String?
  varietyAr          String?
  processEn          String?
  processAr          String?
  altitude           String?
  cupNotesEn         String?
  cupNotesAr         String?
  roastPathEn        String?
  roastPathAr        String?
  defaultGreenBeanId String?
  defaultGreenBean   GreenBean?         @relation(fields: [defaultGreenBeanId], references: [id])
  expectedRoastLoss  Float              @default(15.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orderItems         OrderItem[]
  roastingBatches    RoastingBatch[]
  finishedGoodsLots  FinishedGoodsLot[]
  productSkus        ProductSKU[]
  scheduledSlots     ScheduledSlot[]
  roastPlans         RoastPlan[]

  // BOM lines that consume this coffee as roasted/intermediate stock.
  bomComponents BomComponent[]

  // ─── Product catalog (20261020090000_product_catalog, additive) ──────────
  // One user-defined category per product (D5); every SKU of the product inherits it.
  // Nullable: a product without one is «بلا تصنيف». RESTRICT is the database backstop for
  // «a category holding products cannot be deleted»; the API refuses first with a 409.
  categoryId String?
  category   CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Product-level switch: an inactive product is left out of the new-order product pickers
  // (with all its SKUs). Existing orders keep resolving it. Defaults true, so every existing
  // product stays active.
  isActive   Boolean          @default(true)

  @@index([categoryId])
  @@index([isActive])

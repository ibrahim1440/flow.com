  purchases PurchaseRecord[]

  // ── Accounting A3 (20261104090000_ops_posting): the supplier as an AP party ──
  /// The supplier's VAT registration number (15 digits in KSA), shown on its invoices and statement.
  vatNumber        String?
  /// Default credit terms in days (the due date a new supplier invoice proposes). NULL = 30.
  paymentTermsDays Int?
  /// Phase 2 (20261113090000_purchase_invoice_phase2): a non-resident supplier — its services are reverse-charged (P-RC15).
  isNonResident    Boolean           @default(false)
  /// GOODS_SERVICES (default) | CUSTOMS | CLEARING_AGENT — import VAT (P-IMP15) is billed by customs / a clearing agent only.
  kind             String            @default("GOODS_SERVICES")
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
}

model PurchaseRecord {
  id           String       @id @default(cuid())
  supplierId   String
  supplier     Supplier     @relation(fields: [supplierId], references: [id])
  type         PurchaseType
  itemId       String?
  quantity     Float
  costPerUnit  Float
  totalCost    Float
  purchaseDate DateTime
  notes        String?
  userId       String?
  createdAt    DateTime     @default(now())

  // Typed link for PACKAGING purchases. `itemId` above stays as-is for the existing
  // untyped rows; this is the FK that lets a purchase actually restock a MaterialItem.
  materialItemId  String?
  materialItem    MaterialItem?         @relation(fields: [materialItemId], references: [id])
  /// Phase 2: landed-cost lines (freight, duty, clearance, insurance) capitalised onto this receipt.
  landedCostLines SupplierInvoiceLine[] @relation("LandedCostTarget")
  /// Phase 3: the site the goods were received at (its reversal takes them back from there).

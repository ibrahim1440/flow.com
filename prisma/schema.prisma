generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                String         @id @default(cuid())
  name              String
  username          String?        @unique
  /// Secure Version B: bcrypt(pinVerifierInput(pin)), where pinVerifierInput is
  /// base64(HMAC-SHA384(PIN_LOOKUP_SECRET, "pin:verify:v1:" + pin)). bcrypt is over the keyed
  /// derivation, never the raw PIN, so a stolen row cannot be brute-forced offline without the
  /// application secret and the raw PIN never verifies directly.
  pin               String
  /// HMAC-SHA256(PIN_LOOKUP_SECRET, "pin:lookup:v1:" + pin), base64. The login selector:
  /// unforgeable and unsearchable without the application secret, so a database copy no longer
  /// yields working PINs. Selector only — bcrypt on `pin` remains the proof. Nullable until
  /// every PIN has been reissued.
  pinLookup         String?        @unique
  password          String?
  role              String // admin, inventory, roasting, qc, dispatch, custom
  permissions       String         @default("{}")
  defaultRoute      String         @default("/dashboard")
  active            Boolean        @default(true)
  phoneNumber       String?
  preferredLanguage String         @default("ar") // "ar" | "en"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  qcRecords         QcRecord[]
  cuppingScores     CuppingScore[]
  ownedOrders       Order[]        @relation("OrderOwner") // Order Operations S0 (additive)

  // Sales CRM & commissions (additive). Relation fields only — no columns are added to
  // this table, so the deployed build reads it unchanged.
  leadsOwned           Lead[]                  @relation("LeadOwner")
  opportunitiesOwned   Opportunity[]           @relation("OpportunityOwner")
  opportunitySplits    OpportunityOwner[]      @relation("OpportunitySplitOwner")
  activitiesOwned      Activity[]              @relation("ActivityOwner")
  commissionAssignments CommissionAssignment[] @relation("CommissionAssignee")
  commissionAccruals   CommissionAccrual[]     @relation("CommissionEarner")
  commissionLedger     CommissionLedgerEntry[] @relation("CommissionLedgerOwner")
  salesTargets         SalesTarget[]           @relation("SalesTargetOwner")
  collectionsSubmitted SalesCollection[]       @relation("CollectionSubmitter")
  collectionsDecided   SalesCollection[]       @relation("CollectionDecider")
  collectionsReversed  SalesCollection[]       @relation("CollectionReverser")
  evidenceUploaded     CollectionEvidence[]    @relation("EvidenceUploader")
}

model Customer {
  id               String                    @id @default(cuid())
  name             String
  nameAr           String?
  phone            String?
  email            String?
  address          String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  orders           Order[]
  roastPreferences CustomerRoastPreference[]

  // Sales CRM (additive, relation fields only).
  leadConversions  LeadConversion[]
  opportunities    Opportunity[]
  quotes           Quote[]
  activities       Activity[]
  collectionEvents CollectionEvent[]
  salesCollections SalesCollection[]
}

model GreenBean {
  id               String                    @id @default(cuid())
  serialNumber     String                    @unique
  beanType         String
  beanTypeAr       String?
  country          String
  countryAr        String?
  region           String?
  regionAr         String?
  variety          String?
  process          String?
  processAr        String?
  altitude         String?
  location         String?
  quantityKg       Float                     @default(0)
  isActive         Boolean                   @default(true)
  receivedDate     DateTime                  @default(now())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  orderItems       OrderItem[]
  roastingBatches  RoastingBatch[]
  cuppingSessions  CuppingSession[]
  roastPreferences CustomerRoastPreference[]
  coffeeProducts   CoffeeProduct[]
  productionOrders ProductionOrder[]

  @@index([isActive])
  @@index([isActive, quantityKg])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       Int         @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  quotationNumber   String?
  quotationSentDate DateTime?
  approvalStatus    String      @default("Pending") // Pending, Yes, No
  approvalDate      DateTime?
  paymentStatus     String      @default("Not Paid") // Paid, Not Paid, Partial Paid
  vatInvoiceStatus  String      @default("Not Yet") // Sent, Not Yet, Not Paid
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]

  // ─── Order Operations S0 (additive) ──────────────────────────────────────
  // Backend-controlled lifecycle status — independent of approvalStatus above,
  // never accepted through the generic create/update payloads. String (not enum)
  // to match the existing convention on this model (approvalStatus/paymentStatus/
  // vatInvoiceStatus are also plain strings, not Prisma enums).
  // Values: Waiting Approval, Waiting Preparation Review, Preparing,
  // Ready for Shipping, Completed, On Hold, Cancelled, Rejected
  status  String    @default("Waiting Approval")
  ownerId String?
  owner   Employee? @relation("OrderOwner", fields: [ownerId], references: [id])

  activities OrderActivity[]

  // Sales CRM (additive, relation fields only).
  opportunityLinks OpportunityOrder[]
  collectionEvents CollectionEvent[]

  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([status])
  @@index([ownerId])
  salesCollections SalesCollection[]
}

model OrderItem {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  greenBeanId      String?
  greenBean        GreenBean?        @relation(fields: [greenBeanId], references: [id])
  productId        String?
  product          CoffeeProduct?    @relation(fields: [productId], references: [id])
  productSkuId     String?
  productSku       ProductSKU?       @relation(fields: [productSkuId], references: [id])
  beanTypeName     String
  quantityKg       Float
  productionStatus String            @default("Pending") // Pending, In Production, Completed, Order cancelled
  deliveryStatus   String            @default("Not Yet") // Not Yet, Partial Delivered, Delivered
  deliveredQty     Float             @default(0)
  remainingQty     Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  roastingBatches  RoastingBatch[]
  deliveries       Delivery[]
  productionOrders ProductionOrder[]

  // ─── Order Operations S0 (additive) ──────────────────────────────────────
  // Written only by POST /api/orders/[id]/preparation-review — never by the
  // generic order edit route. Float to match quantityKg/deliveredQty/remainingQty
  // above — this model has no Decimal fields to stay consistent with.
  // Since the shelf-allocation change these three are SERVER-DERIVED, never client
  // supplied: availableQuantity is the sum of RESERVED StockAllocation rows for this
  // item and productionRequiredQuantity is the outstanding remainder.
  preparationDecision        String? // Available on Shelf, Needs Production, Partially Available, Blocked
  availableQuantity          Float?
  productionRequiredQuantity Float?

  allocations StockAllocation[]

  // ─── SKU-based sales lines ───────────────────────────────────────────────
  // A line created through the Finished Products flow sells whole units of one SKU:
  // `productSkuId` is set and `quantityUnits` is authoritative. `quantityKg` is still
  // written, derived as units x (weightGrams / 1000), because delivery, production and
  // every report downstream read it — it is a projection of units, not a rival total.
  //
  // Legacy lines (26 of the 35 that existed at the time of this change) have
  // quantityUnits = null and only quantityKg. They stay readable and deliverable but
  // no new line may be created that way: order creation now requires a valid SKU.
  quantityUnits  Int?
  deliveredUnits Int  @default(0)

  @@index([productionStatus])
  @@index([deliveryStatus])
  @@index([productionStatus, deliveryStatus])
  @@index([productSkuId])
}

model RoastingBatch {
  id String @id @default(cuid())

  // Optional since roast-to-stock. A batch with no order item is a deliberate
  // replenishment of the shelf: it consumes green stock and writes the same ledger
  // entries as any other roast, but its packaged output is reserved to nobody and
  // becomes free-to-promise for whichever order needs it first. Every batch created
  // before this change carries an order item, and the order-driven path still sets one.
  orderItemId         String?
  orderItem           OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchNumber         String
  date                DateTime       @default(now())
  greenBeanId         String?
  greenBean           GreenBean?     @relation(fields: [greenBeanId], references: [id])
  productId           String?
  product             CoffeeProduct? @relation(fields: [productId], references: [id])
  greenBeanQuantity   Float
  roastedBeanQuantity Float          @default(0)
  wasteQuantity       Float          @default(0)
  roastProfile        String?
  status              String         @default("Pending QC")

  // Packaging (filled post-QC)
  bags3kg      Int   @default(0)
  bags1kg      Int   @default(0)
  bags250g     Int   @default(0)
  bags150g     Int   @default(0)
  samplesGrams Float @default(0)

  // ─── Roasted / intermediate stock ────────────────────────────────────────
  // Roasted coffee from this batch that has not yet been packed into a finished SKU.
  // This is the intermediate stage the finished-goods BOM draws on: roasting raises it,
  // packaging lowers it. Green coffee is consumed by roasting alone and never by a BOM.
  //
  // Seeded from roastedBeanQuantity minus what this batch had already packed at
  // migration time, so existing batches do not suddenly present already-packed coffee
  // as available. A CHECK constraint keeps it within [0, roastedBeanQuantity].
  roastedAvailableKg Float @default(0)

  // Blending lineage
  isBlend       Boolean         @default(false) // true = this is a blend output, NOT new production
  blendTiming   String?
  parentBatchId String?
  parentBatch   RoastingBatch?  @relation("BlendLineage", fields: [parentBatchId], references: [id])
  childBatches  RoastingBatch[] @relation("BlendLineage")

  // Multi-tester QC panel
  qcDeadline            DateTime?
  qcToken               String?   @unique
  qcClosedById          String?
  qcFinalDecisionReason String?

  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  qcRecords             QcRecord[]
  cuppingSessions       CuppingSession[]
  cuppingSessionBatches CuppingSessionBatch[]
  blendInputs           BlendIngredient[]     @relation("BlendTarget")
  blendOutputs          BlendIngredient[]     @relation("BlendSource")
  finishedGoodsLots     FinishedGoodsLot[]
  packedLots            FinishedGoodsLot[]    @relation("PackedFromBatch")
  /// Grams this roast contributed to packaged lots, including top-ups of packages that were
  /// originally filled from a different roast.
  packagingSources      PackagingSource[]     @relation("PackagingSourceBatch")
  serialHistory         BatchSerialHistory[]
  packagingOperations   PackagingOperation[]

  @@unique([greenBeanId, batchNumber])
  @@index([greenBeanId, createdAt])
  @@index([status])
  @@index([status, createdAt])
}

model BlendIngredient {
  id                 String        @id @default(cuid())
  sourceBatchId      String
  sourceBatch        RoastingBatch @relation("BlendSource", fields: [sourceBatchId], references: [id], onDelete: Cascade)
  targetBlendBatchId String
  targetBlendBatch   RoastingBatch @relation("BlendTarget", fields: [targetBlendBatchId], references: [id], onDelete: Cascade)
  quantityUsed       Float
  createdAt          DateTime      @default(now())
}

model QcRecord {
  id                String                @id @default(cuid())
  batchId           String
  batch             RoastingBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date              DateTime              @default(now())
  coffeeOrigin      String
  processing        String
  serialNumber      String
  onProfile         Boolean               @default(false)
  underDeveloped    Boolean               @default(false)
  overDeveloped     Boolean               @default(false)
  color             Int?
  colorWhole        Float?
  colorGround       Float?
  remarks           String?
  // Multi-tester panel fields
  employeeId        String?
  employee          Employee?             @relation(fields: [employeeId], references: [id])
  isExternal        Boolean               @default(false)
  testerName        String?
  decision          String                @default("Accept") // "Accept" or "Reject"
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  correctionHistory QcCorrectionHistory[]

  @@index([date])
  @@index([batchId, date])
}

model Delivery {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  quantityKg   Float
  deliveryType String // full, partial
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Units shipped, for deliveries against a SKU line. Null on legacy kg deliveries.
  // quantityKg stays populated in both cases (derived from units for SKU lines) so
  // dispatch history and the inventory ledger keep reading one field.
  quantityUnits Int?

  /// Client-supplied Idempotency-Key for the dispatch this row records. Nullable so the
  /// previous application version, which sends none, keeps inserting deliveries while this
  /// column already exists; unique so two concurrent retries of one dispatch collapse to a
  /// single shipment.
  requestKey    String? @unique
  /// SHA-256 over a fixed-position array of the normalized dispatch intent. The same key
  /// carrying a different intent is a client error, not a second shipment.
  intentHash    String?

  @@index([date])
}

model CuppingSession {
  id             String                @id @default(cuid())
  name           String
  date           DateTime              @default(now())
  status         String                @default("Open")
  sessionToken   String?               @unique
  batchId        String?
  greenBeanId    String?
  batch          RoastingBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  greenBean      GreenBean?            @relation(fields: [greenBeanId], references: [id], onDelete: SetNull)
  sessionBatches CuppingSessionBatch[]
  scores         CuppingScore[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
}

model CuppingSessionBatch {
  id                   String         @id @default(cuid())
  sessionId            String
  session              CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  batchId              String?
  batch                RoastingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  isExternalSample     Boolean        @default(false)
  externalSampleName   String?
  externalSupplierName String?
  order                Int            @default(0)
  scores               CuppingScore[]
  createdAt            DateTime       @default(now())
}

model CuppingScore {
  id                String               @id @default(cuid())
  sessionId         String
  session           CuppingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionBatchId    String?
  sessionBatch      CuppingSessionBatch? @relation(fields: [sessionBatchId], references: [id], onDelete: SetNull)
  employeeId        String?
  employee          Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  externalName      String?
  fragranceAroma    Float                @default(7)
  flavor            Float                @default(7)
  aftertaste        Float                @default(7)
  acidity           Float                @default(7)
  body              Float                @default(7)
  balance           Float                @default(7)
  uniformity        Float                @default(10)
  cleanCup          Float                @default(10)
  sweetness         Float                @default(10)
  overall           Float                @default(7)
  defectCups        Int                  @default(0)
  defectType        String               @default("none")
  finalScore        Float                @default(0)
  notes             String?              @db.Text
  flavorDescriptors String[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model SystemConfig {
  id         String  @id @default("singleton")
  logoBase64 String? @db.Text
}

model CustomerRoastPreference {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  greenBeanId           String
  greenBean             GreenBean @relation(fields: [greenBeanId], references: [id], onDelete: Cascade)
  profileName           String
  usageType             String    @default("BOTH")
  notes                 String?
  // Agtron color targets
  targetColorWhole      Float?
  targetToleranceWhole  Float?
  targetColorGround     Float?
  targetToleranceGround Float?
  targetDeltaMin        Float?
  targetDeltaMax        Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([customerId, greenBeanId])
}

model CoffeeProduct {
  id                 String             @id @default(cuid())
  productNameEn      String
  productNameAr      String?
  countryEn          String
  countryAr          String?
  regionEn           String?
  regionAr           String?
  varietyEn          String?
  varietyAr          String?
  processEn          String?
  processAr          String?
  altitude           String?
  cupNotesEn         String?
  cupNotesAr         String?
  roastPathEn        String?
  roastPathAr        String?
  defaultGreenBeanId String?
  defaultGreenBean   GreenBean?         @relation(fields: [defaultGreenBeanId], references: [id])
  expectedRoastLoss  Float              @default(15.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orderItems         OrderItem[]
  roastingBatches    RoastingBatch[]
  finishedGoodsLots  FinishedGoodsLot[]
  productSkus        ProductSKU[]

  // BOM lines that consume this coffee as roasted/intermediate stock.
  bomComponents BomComponent[]
}

// ─── Procurement ─────────────────────────────────────────────────────────────

enum PurchaseType {
  GREEN_BEAN
  PACKAGING
  EQUIPMENT
  OTHER
}

model Supplier {
  id        String           @id @default(cuid())
  name      String
  contact   String?
  createdAt DateTime         @default(now())
  purchases PurchaseRecord[]
}

model PurchaseRecord {
  id           String       @id @default(cuid())
  supplierId   String
  supplier     Supplier     @relation(fields: [supplierId], references: [id])
  type         PurchaseType
  itemId       String?
  quantity     Float
  costPerUnit  Float
  totalCost    Float
  purchaseDate DateTime
  notes        String?
  userId       String?
  createdAt    DateTime     @default(now())

  // Typed link for PACKAGING purchases. `itemId` above stays as-is for the existing
  // untyped rows; this is the FK that lets a purchase actually restock a MaterialItem.
  materialItemId String?
  materialItem   MaterialItem? @relation(fields: [materialItemId], references: [id])

  @@index([purchaseDate])
  @@index([supplierId, purchaseDate])
  @@index([materialItemId])
}

// ─── Inventory Ledger ─────────────────────────────────────────────────────────

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  LOSS
}

enum InventoryCategory {
  RAW_MATERIAL
  FINISHED_GOODS
  ROASTED_COFFEE // intermediate stock between roasting and packaging
  PACKAGING_MATERIAL // MaterialItem stock: bags, labels, cartons
}

enum SourceDocType {
  PURCHASE
  ROASTING_BATCH
  DELIVERY
  BLEND
  MANUAL_ADJUSTMENT
  PACKING
  BOM_CONSUMPTION // packaging drawing roasted coffee + materials per a SKU's BOM
  PRODUCTION_ORDER
}

model InventoryMovement {
  id                String            @id @default(cuid())
  type              MovementType
  category          InventoryCategory
  referenceEntityId String?
  quantityChanged   Float
  previousQuantity  Float
  newQuantity       Float
  sourceDocType     SourceDocType
  sourceDocId       String?
  userId            String?
  timestamp         DateTime          @default(now())
  notes             String?

  @@index([timestamp])
  @@index([category, timestamp])
  @@index([referenceEntityId])
}

// ─── Finished Goods ───────────────────────────────────────────────────────────

enum LotStatus {
  AVAILABLE
  RESERVED
  SHIPPED

  /// A physical package that exists but is not a complete sellable unit — a 1 KG bag
  /// holding 250 g, for instance. It is real inventory: the coffee left the roast and the
  /// bag was used, and both are accounted for. It simply is not a sellable SKU yet.
  ///
  /// The status is what keeps it out of allocation. Every path that can promise or ship
  /// stock — availableUnitsBySku, reserveFinishedUnits, consumeFinishedUnits, the shelf
  /// allocator, fulfillment-options — already requires status = AVAILABLE, so a PARTIAL lot
  /// is invisible to all of them without a line of change in any of them. Topping the
  /// package up to its nominal weight flips it to AVAILABLE, and that is the only way it
  /// becomes sellable.
  PARTIAL
}

model FinishedGoodsLot {
  id              String         @id @default(cuid())
  productId       String
  product         CoffeeProduct  @relation(fields: [productId], references: [id])
  productSkuId    String?
  productSku      ProductSKU?    @relation(fields: [productSkuId], references: [id])
  batchNumber     String
  roastingBatchId String?        @unique
  roastingBatch   RoastingBatch? @relation(fields: [roastingBatchId], references: [id])
  quantityKg      Float
  availableQty    Float

  // ─── Shelf allocation ────────────────────────────────────────────────────
  // Kilograms already promised to an order item but not yet shipped. Denormalised
  // sum of the RESERVED StockAllocation rows pointing at this lot — kept on the lot
  // itself so "is there enough free stock" is answerable by a single conditional
  // UPDATE (availableQty - reservedQty >= n), the same atomic pattern the delivery
  // deduction already uses. Free-to-promise is always availableQty - reservedQty.
  reservedQty Float             @default(0)
  allocations StockAllocation[]

  status    LotStatus @default(AVAILABLE)
  createdAt DateTime  @default(now())

  // ─── Unit-native finished goods ──────────────────────────────────────────
  // For a SKU-tracked lot, UNITS are the single source of truth: kg-equivalent is
  // always derived as units x (ProductSKU.weightGrams / 1000), never stored twice.
  //
  // `isUnitTracked` is the discriminator, not a second opinion on the same balance.
  // A lot is EITHER unit-tracked (new packaging output; units* authoritative,
  // availableQty/reservedQty frozen at 0) OR legacy kg (rows produced before this
  // change; availableQty/reservedQty authoritative, units* stay 0). The legacy rows
  // cannot be converted honestly — 8.45 kg against a 1 KG SKU is not a whole number
  // of bags — so they keep serving the legacy bean-based order lines in kg and are
  // never rewritten.
  isUnitTracked  Boolean @default(false)
  unitsProduced  Int     @default(0)
  unitsAvailable Int     @default(0)
  unitsReserved  Int     @default(0)

  // Which roast this lot was packed from. Distinct from `roastingBatchId` above, and not
  // a duplicate of it: that column is 1:1 and UNIQUE — "this lot is that batch's entire
  // packaged output", the legacy shape where a batch became exactly one kg lot. One roast
  // can be packed into several SKUs (a 1 KG lot and a 250 g lot from the same batch), so
  // the unit-tracked path needs a MANY:1 link and cannot reuse a unique column.
  //
  // Unit-tracked lots set this and leave `roastingBatchId` null; legacy lots are the
  // reverse. Nothing sets both, so batch traceability is unambiguous either way.
  packedFromBatchId String?
  packedFromBatch   RoastingBatch? @relation("PackedFromBatch", fields: [packedFromBatchId], references: [id])

  packagingOperations PackagingOperation[]

  // ─── Actual fill, in whole grams ─────────────────────────────────────────
  // Integers, not Float. Packaging arithmetic decides whether a package is sellable, and
  // "is 0.1 + 0.2 === 0.3" is not a question inventory may depend on. Grams are the
  // smallest unit anyone weighs here, so an Int holds the exact figure and comparisons
  // against the nominal weight are exact. Float stays where it already is elsewhere in the
  // packaging domain; nothing here re-denominates existing columns.
  //
  // Both are null on legacy rows and on ordinary standard lots, where the SKU's nominal
  // weight times the unit count is the whole truth.

  /// What is physically inside the package(s) of this lot. For a PARTIAL lot this is the
  /// under-nominal fill; for a standard lot recorded through the unified workflow it is the
  /// real weight that went in, which may legitimately exceed nominal (1005 g in a 1 KG bag).
  actualContentGrams Int?

  /// The SKU's nominal net weight at the moment of packing, copied so a later change to
  /// master data cannot retroactively reclassify a package that was correct when it was made.
  nominalContentGrams Int?

  /// Whether the physical packaging materials for this lot have already been drawn. Set on
  /// first pack and never cleared: topping a partial package up consumes more coffee but not
  /// a second bag, and this flag is what makes that decision from data rather than from
  /// inference about the operation's shape.
  materialsConsumed Boolean @default(false)

  /// Where the coffee in this lot came from, in grams per contributing roast. A top-up may
  /// draw from a different batch than the original fill, so lineage cannot be a single
  /// column — packedFromBatchId still names the first roast, and this carries the full story.
  sources PackagingSource[]

  @@index([status])
  @@index([createdAt])
  @@index([productSkuId, status])
  @@index([isUnitTracked, status])
  @@index([packedFromBatchId])
}

/// One roast's contribution to one packaged lot.
///
/// Packaging used to be one roast in, one lot out, so a single column carried the lineage.
/// A partial package that is finished later from a second roast breaks that: the bag holds
/// coffee from two batches and both have to remain traceable, with the grams each supplied.
/// Rows are append-only — a correction adds a reversing packaging operation, it does not
/// rewrite where the coffee came from.
model PackagingSource {
  id String @id @default(cuid())

  finishedGoodsLotId String
  finishedGoodsLot   FinishedGoodsLot @relation(fields: [finishedGoodsLotId], references: [id], onDelete: Cascade)

  roastingBatchId String
  roastingBatch   RoastingBatch @relation("PackagingSourceBatch", fields: [roastingBatchId], references: [id], onDelete: Restrict)

  /// Whole grams this roast contributed. Integer for the same reason as the lot columns.
  gramsContributed Int

  /// The packaging operation that recorded this contribution, for audit join-up.
  packagingOperationId String?

  createdAt DateTime @default(now())

  @@index([finishedGoodsLotId])
  @@index([roastingBatchId])
  @@index([packagingOperationId])
}

enum AllocationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

// One order item may be covered by several lots, so the promise is a row per
// (order item, lot) pair rather than a column on either side. RESERVED rows are the
// detail behind FinishedGoodsLot.reservedQty; CONSUMED rows record what a delivery
// actually shipped; RELEASED rows are cancelled promises kept for audit.
model StockAllocation {
  id                 String           @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  finishedGoodsLotId String
  finishedGoodsLot   FinishedGoodsLot @relation(fields: [finishedGoodsLotId], references: [id])
  quantityKg         Float
  status             AllocationStatus @default(RESERVED)
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Whole sellable units reserved, for allocations against a unit-tracked lot.
  // Null on the legacy kg allocations (including the four written by the
  // 20260826120000 backfill), where quantityKg remains authoritative. Exactly one of
  // the two is meaningful per row, decided by the lot's isUnitTracked flag.
  quantityUnits Int?

  @@index([orderItemId, status])
  @@index([finishedGoodsLotId, status])
}

// ─── Product Catalog & Production Planning ────────────────────────────────────

enum PackagingMethod {
  KG // the legacy kilogram bag path — PUT /api/roasting-batches/[id]/package
  UNIT // the finished-SKU path      — POST /api/roasting-batches/[id]/pack-sku

  /// The unified workflow — POST /api/roasting-batches/[id]/pack.
  ///
  /// Not a third way of packaging: it is the only one an operator now sees. The two values
  /// above are retained because they label operations that were already recorded, and an
  /// audit row must keep saying what actually happened. New operations are always PACK.
  PACK
}

/**
 * One packaging SUBMIT, recorded so that a retry can be recognised instead of re-executed.
 *
 * Packaging is not naturally idempotent and never can be. Packing a roast in several goes
 * is ordinary operational reality, so "the same request twice" and "two genuine partial
 * packs" are indistinguishable from the payload alone — the two are separated only by the
 * key the client chose. That is why identity lives here, on the operation, and not as a
 * single request key on RoastingBatch: one key per batch would make the second partial pack
 * look like a replay of the first.
 *
 * Scoped to (batchId, requestKey) rather than requestKey alone. A key is meaningful only
 * against the batch it was submitted for; a global unique would make two unrelated roasts
 * collide if a client ever reused a key, and would turn a local mistake into a cross-batch
 * failure.
 *
 * The row is written in the SAME transaction as the stock it describes, so a failed
 * packaging leaves no operation behind and the same key may legitimately be retried.
 */
model PackagingOperation {
  id String @id @default(cuid())

  // RESTRICT, deliberately. This table is the audit record of stock that physically moved,
  // so a cascade would erase the history at exactly the moment it matters most. The batch
  // DELETE route carries a matching domain guard that answers 409 before the database is
  // reached — the constraint is the backstop, not the user-facing behaviour.
  batchId String
  batch   RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  // Client-supplied idempotency key, or a server-generated one for callers that predate
  // the contract. A server-generated key gives the operation an audit identity but cannot
  // deduplicate a retry, because the retry would arrive without the original key.
  requestKey String

  // SHA-256 over the NORMALISED request intent, never over raw JSON text — property order
  // must not change the hash. Same key + different hash is a client error, not a replay.
  requestHash String

  method PackagingMethod

  // Kilograms for the KG path, whole units for the UNIT path. Float to match the rest of
  // the packaging domain (StockAllocation.quantityKg, FinishedGoodsLot.availableQty);
  // the Decimal columns in this schema belong to accounting.
  quantityKg    Float?
  quantityUnits Int?

  productSkuId String?
  productSku   ProductSKU? @relation(fields: [productSkuId], references: [id])

  finishedGoodsLotId String?
  finishedGoodsLot   FinishedGoodsLot? @relation(fields: [finishedGoodsLotId], references: [id])

  // The response the first execution returned, replayed verbatim to a retry.
  responseStatus Int
  responseJson   Json

  // Employee.id, denormalized — no FK relation (matches the InventoryMovement /
  // OrderActivity / WorkItemClaim audit-table convention).
  userId String?

  createdAt DateTime @default(now())

  @@unique([batchId, requestKey])
  @@index([batchId, createdAt])
}

enum ProductionOrderStatus {
  PENDING
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  ROASTED_COFFEE
  GREEN_COFFEE
  MERCHANDISE
  OTHER
}

enum UnitOfMeasure {
  UNIT // a discrete sellable pack (bag, box) — the default for finished SKUs
  KG
  GRAM
  PIECE
}

enum MaterialCategory {
  PACKAGING // bags, cartons
  LABEL // stickers, printed labels
  CONSUMABLE
  OTHER
}

// Stocked non-coffee inventory: the bags, labels and cartons a BOM consumes.
// Deliberately separate from GreenBean (coffee, kg-denominated) — these are counted
// in discrete pieces and are never roasted. PurchaseRecord.materialItemId links a
// PACKAGING purchase to the item it restocks, so buying bags can raise stock instead
// of only recording cost.
model MaterialItem {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  nameAr         String?
  category       MaterialCategory @default(PACKAGING)
  unitOfMeasure  UnitOfMeasure    @default(PIECE)
  quantityOnHand Float            @default(0)
  reorderPoint   Float            @default(0)
  isActive       Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  bomComponents BomComponent[]
  purchases     PurchaseRecord[]

  @@index([isActive])
  @@index([category, isActive])
}

enum BomComponentType {
  ROASTED_COFFEE // consumes kg from roasted/intermediate stock, identified by CoffeeProduct
  MATERIAL // consumes pieces from MaterialItem
}

// One line of a finished SKU's bill of materials, expressed PER SELLABLE UNIT.
//
// A ROASTED_COFFEE line points at a CoffeeProduct and is measured in kilograms — it
// draws on roasted/intermediate stock, never on GreenBean directly. Green coffee is
// consumed only by roasting; the chain is
//   GreenBean -> Roasting -> roasted stock -> Packaging (this BOM) -> FinishedGoodsLot.
// A MATERIAL line points at a MaterialItem and is measured in pieces.
//
// Exactly one of coffeeProductId / materialItemId is set; a CHECK constraint in the
// migration enforces that rather than leaving it to route code.
model BomComponent {
  id           String     @id @default(cuid())
  productSkuId String
  productSku   ProductSKU @relation(fields: [productSkuId], references: [id], onDelete: Cascade)

  type BomComponentType

  coffeeProductId String?
  coffeeProduct   CoffeeProduct? @relation(fields: [coffeeProductId], references: [id])
  materialItemId  String?
  materialItem    MaterialItem?  @relation(fields: [materialItemId], references: [id])

  quantityPerUnit Float // kg for ROASTED_COFFEE, pieces for MATERIAL
  unitOfMeasure   UnitOfMeasure
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([productSkuId])
  @@index([materialItemId])
  @@index([coffeeProductId])
}

// A ProductSKU is the sellable Finished Product: exactly one SKU per row
// ("Brazil Coffee – 1 KG" and "Brazil Coffee – 250g" are two rows). The coffee/origin
// it is made from is `product` (CoffeeProduct); the pack size is `weightGrams`.
// Sales orders reference ONLY this model — never a green bean, never a CoffeeProduct.
model ProductSKU {
  id                String             @id @default(cuid())
  productId         String
  product           CoffeeProduct      @relation(fields: [productId], references: [id])
  skuCode           String             @unique
  weightGrams       Float // net weight of one sellable unit; master data for BOM/production maths
  isBulk            Boolean            @default(false)
  price             Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  finishedGoodsLots FinishedGoodsLot[]
  productionOrders  ProductionOrder[]
  packagingOperations PackagingOperation[]

  // ─── Finished Products catalog (additive) ────────────────────────────────
  // Explicit display name. Nullable because the six pre-existing SKUs were created
  // before this field; the API falls back to "<product name> – <pack size>" when unset.
  name          String?
  nameAr        String?
  category      ProductCategory @default(ROASTED_COFFEE)
  unitOfMeasure UnitOfMeasure   @default(UNIT)
  isActive      Boolean         @default(true)

  // Bill of materials — what one unit of this SKU consumes.
  bomComponents BomComponent[]

  // Sales CRM (additive, relation fields only).
  quoteLines      QuoteLine[]
  sampleShipments SampleShipment[]

  @@index([isActive])
  @@index([category, isActive])
}

model ProductionOrder {
  id                  String                @id @default(cuid())
  productionNumber    String                @unique
  productSkuId        String
  productSku          ProductSKU            @relation(fields: [productSkuId], references: [id])
  targetUnits         Int
  targetWeightKg      Float
  expectedGreenBeanKg Float
  status              ProductionOrderStatus @default(PENDING)
  surplusHandled      Boolean               @default(false)
  sourceOrderItemId   String?
  sourceOrderItem     OrderItem?            @relation(fields: [sourceOrderItemId], references: [id])
  greenBeanId         String?
  greenBean           GreenBean?            @relation(fields: [greenBeanId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  roastingBatches     RoastingBatch[]
}

// ─── QC Correction History ────────────────────────────────────────────────────

model QcCorrectionHistory {
  id               String                    @id @default(cuid())
  qcRecordId       String
  qcRecord         QcRecord                  @relation(fields: [qcRecordId], references: [id], onDelete: Cascade)
  batchId          String
  correctionReason String
  changedById      String
  changedByName    String
  changedAt        DateTime                  @default(now())
  fieldChanges     QcCorrectionFieldChange[]

  @@index([qcRecordId])
  @@index([batchId])
  @@index([changedAt])
}

model QcCorrectionFieldChange {
  id           String              @id @default(cuid())
  correctionId String
  correction   QcCorrectionHistory @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  fieldName    String
  oldValue     String?
  newValue     String?

  @@index([correctionId])
}

// ─── Batch Serial History ─────────────────────────────────────────────────────

model BatchSerialHistory {
  id             String        @id @default(cuid())
  batchId        String
  batch          RoastingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  greenBeanId    String?
  oldBatchNumber String
  newBatchNumber String
  reason         String
  changedById    String
  changedByName  String
  changedAt      DateTime      @default(now())

  @@index([batchId])
  @@index([oldBatchNumber])
}

// ─── Order Operations S0 — Activity Timeline ──────────────────────────────────
// Unified append-only timeline for both system-generated lifecycle events and
// manual operational notes on an Order. Deliberately one table, not one history
// table per event kind: every row shares the same shape and the UI renders them
// as a single chronological feed — `type` already covers query-time filtering.
//
// onDelete: Cascade on the Order relation matches the existing domain-history
// convention (QcCorrectionHistory -> QcRecord, BatchSerialHistory -> RoastingBatch,
// both Cascade above): activity history has no independent existence once its
// parent Order is gone. The existing Order.notes free-text field is untouched
// and continues to serve whatever it already serves; OrderActivity is additive.
//
// Future tenancy: tenant-owned transitively through Order (see docs/saas-readiness.md).
// No tenantId added now, per the standing SaaS-readiness constraint.
model OrderActivity {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type    String // ORDER_CREATED | ORDER_APPROVED | ORDER_REJECTED | PREPARATION_REVIEWED |
  // STATUS_CHANGED | MANUAL_NOTE | ORDER_HELD | ORDER_RESUMED | ORDER_CANCELLED | ORDER_COMPLETED
  message String @db.Text

  department String? // Sales, Online, Preparation, Production, Operations, Shipping — set only on MANUAL_NOTE
  authorId   String? // Employee.id, denormalized — no FK relation (matches WorkItemClaim/QcCorrectionHistory convention)
  authorName String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model LoginAttempt {
  id             String   @id @default(cuid())
  ipHash         String
  identifierHash String
  createdAt      DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([ipHash, identifierHash, createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
  @@index([createdAt])
}

// ─── Migration-history recovery ────────────────────────────────────────────
// The models below are owned by sibling repos (ERP-login, ERP-workstations) and were
// already applied directly to the shared demo database by those branches before this
// branch's migration history existed. Imported byte-identical to their source schemas
// (see ERP-login/prisma/schema.prisma and ERP-workstations/prisma/schema.prisma) purely
// so this branch's schema.prisma matches the live demo DB and `prisma migrate dev` does
// not propose dropping them. Not part of Accounting S0 — do not extend or modify here;
// changes belong in the owning repo.

model AuthAuditLog {
  id               String   @id @default(cuid())
  userId           String?
  identifierHash   String?
  action           String
  result           String
  reasonCode       String?
  sourceInterface  String   @default("WEB")
  workspaceRouting String?
  ipHash           String
  userAgent        String?
  metadata         Json?
  occurredAt       DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([identifierHash, occurredAt])
  @@index([action, occurredAt])
  @@index([result, occurredAt])
}

model WorkItemClaim {
  id             String    @id @default(cuid())
  stationType    String // ROASTING | QUALITY | WAREHOUSE | PACKAGING | BAR
  itemType       String // e.g. "RoastingBatch" | "QcRecord" — polymorphic, like InventoryMovement.referenceEntityId
  itemId         String
  itemRef        String // `${itemType}:${itemId}`
  activeItemRef  String?   @unique // == itemRef while status="ACTIVE", null otherwise (enforces at most one active claim per item)
  claimedById    String // Employee.id, denormalized — no FK relation (audit-table convention)
  claimedByName  String
  status         String    @default("ACTIVE") // ACTIVE | RELEASED | EXPIRED | OVERRIDDEN
  claimedAt      DateTime  @default(now())
  expiresAt      DateTime?
  releasedAt     DateTime?
  releasedById   String?
  releasedByName String?

  @@index([stationType, status])
  @@index([itemType, itemId])
  @@index([itemRef])
  @@index([claimedById])
  @@index([claimedAt])
  @@index([status, expiresAt])
}

model WorkstationActionLog {
  id              String   @id @default(cuid())
  stationType     String
  itemType        String
  itemId          String
  action          String // CLAIM | RELEASE | ADVANCE:<action> | FLAG
  fromState       String?
  toState         String?
  employeeId      String // Employee.id, denormalized — no FK relation
  employeeName    String
  idempotencyKey  String   @unique
  status          String // SUCCESS | REJECTED | ERROR
  reason          String?
  sourceInterface String   @default("STATION")
  createdAt       DateTime @default(now())

  @@index([stationType, createdAt])
  @@index([itemType, itemId])
  @@index([employeeId])
  @@index([status])
}

// ─── Accounting S0 Foundation ──────────────────────────────────────────────
// Single-tenant (no tenantId — no Tenant model exists; see docs/saas-readiness.md).
// Money fields use Decimal (not Float) — debit=credit integrity cannot tolerate
// floating-point rounding error. This is a deliberate deviation from the Float
// convention used elsewhere in this schema, scoped only to these tables.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TaxCategoryType {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

enum FiscalPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum JournalEntryType {
  MANUAL
  AUTO
  REVERSAL
  ADJUSTMENT
  OPENING
  CLOSING
}

enum JournalEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REVERSED
}

enum AccountingEventStatus {
  PENDING
  TRANSLATED
  FAILED
}

enum QoyodExportStatus {
  NOT_EXPORTED
  READY_FOR_EXPORT
  EXPORTED
  EXPORT_FAILED
}

model AccountingSettings {
  // Singleton row, same pattern as SystemConfig — no Tenant model exists yet.
  id String @id @default("singleton")

  baseCurrency String @default("SAR")

  // Phase 2+ placeholders — stored now per spec, not enforced by any service logic in S0.
  costingMethod        String @default("WeightedAverage")
  cogsPolicy           String @default("OnShipping")
  branchAccountingMode String @default("CostCenterOnly")

  exportToQoyod Boolean @default(false)

  // Posting is blocked everywhere except setup routes while this is false. Must not
  // default to true — there is no setup wizard in S0, so setup is never complete by default.
  setupComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Account {
  id             String      @id @default(cuid())
  code           String      @unique
  nameAr         String?
  nameEn         String
  parentId       String?
  parent         Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]   @relation("AccountHierarchy")
  type           AccountType
  allowPosting   Boolean     @default(true)
  isActive       Boolean     @default(true)
  qoyodAccountId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?

  journalEntryLines JournalEntryLine[]

  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

model TaxCategory {
  id                   String          @id @default(cuid())
  code                 String          @unique
  nameAr               String?
  nameEn               String
  rate                 Decimal         @db.Decimal(5, 2)
  categoryType         TaxCategoryType @default(STANDARD)
  isDefault            Boolean         @default(false)
  isActive             Boolean         @default(true)
  requiresReason       Boolean         @default(false)
  requiresApproval     Boolean         @default(false)
  zatcaTaxCategoryCode String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdBy            String?
  updatedBy            String?

  @@index([isActive])
  @@index([categoryType])
}

model FiscalPeriod {
  id        String             @id @default(cuid())
  year      Int
  periodNo  Int
  startDate DateTime
  endDate   DateTime
  status    FiscalPeriodStatus @default(OPEN)
  lockedAt  DateTime?
  lockedBy  String?
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  journalEntries JournalEntry[]

  @@unique([year, periodNo])
  @@index([status])
  @@index([startDate, endDate])
}

model JournalEntry {
  id               String             @id @default(cuid())
  entryNo          Int                @unique @default(autoincrement())
  entryDate        DateTime
  fiscalPeriodId   String
  fiscalPeriod     FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  type             JournalEntryType   @default(MANUAL)
  status           JournalEntryStatus @default(DRAFT)
  sourceModule     String             @default("manual")
  sourceDocumentId String?
  description      String?

  // Reversal link lives on the REVERSAL entry, pointing at the ORIGINAL it reverses.
  // @unique on reversesEntryId means Postgres allows many NULLs (non-reversal entries)
  // but at most one row may point at a given original — i.e. an entry can only ever
  // be reversed once. This is enforced at the DB level, not just in service code.
  reversesEntryId String?       @unique
  reversesEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversesEntryId], references: [id])
  reversedByEntry JournalEntry? @relation("JournalEntryReversal")

  totalDebit  Decimal @default(0) @db.Decimal(18, 2)
  totalCredit Decimal @default(0) @db.Decimal(18, 2)
  currency    String  @default("SAR")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  submittedAt DateTime?
  submittedBy String?
  approvedAt  DateTime?
  approvedBy  String?
  postedAt    DateTime?
  postedBy    String?

  // Set only on the reversal entry itself (explanation for why the original was reversed).
  reversalReason String?

  lines              JournalEntryLine[]
  accountingEvents   AccountingEvent[]
  qoyodExportRecords QoyodExportRecord[]

  @@index([status])
  @@index([fiscalPeriodId])
  @@index([entryDate])
  @@index([sourceModule, sourceDocumentId])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])

  // DB-level CHECK constraint (added by hand to the migration SQL, same precedent as the
  // existing non-negative-quantity constraints) enforces: debit >= 0, credit >= 0, and
  // exactly one of the two is > 0 while the other is exactly 0. See migration SQL comment.
  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)

  description         String?
  taxCategorySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journalEntryId])
  @@index([accountId])
}

model AccountingEvent {
  id               String @id @default(cuid())
  eventType        String
  sourceModule     String
  sourceDocumentId String
  sourceEventId    String

  // Dedicated idempotency key, built from sourceModule + sourceDocumentId + eventType +
  // sourceEventId (the source's own event/version id). A single source document can emit
  // many distinct events (e.g. multiple deliveries against one order) — keying only on
  // (sourceModule, sourceDocumentId, eventType) would incorrectly block valid repeats.
  idempotencyKey String @unique

  occurredAt     DateTime              @default(now())
  payload        Json
  status         AccountingEventStatus @default(PENDING)
  journalEntryId String?
  journalEntry   JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceModule, sourceDocumentId])
  @@index([status])
  @@index([eventType])
}

model QoyodExportRecord {
  id                String            @id @default(cuid())
  journalEntryId    String
  journalEntry      JournalEntry      @relation(fields: [journalEntryId], references: [id])
  externalExportKey String            @unique
  status            QoyodExportStatus @default(NOT_EXPORTED)
  payloadSnapshot   Json?
  responseSnapshot  Json?
  qoyodReferenceId  String?
  retryCount        Int               @default(0)
  errorMessage      String?
  exportedAt        DateTime?
  exportedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([journalEntryId])
}

// ═══════════════════════════════════════════════════════════════════════════════
//  SALES CRM & COMMISSIONS
//
//  Added whole, alongside the existing domain. Nothing above this line is altered:
//  every table here is new, so the build currently in production keeps working
//  against this schema unchanged.
//
//  Two conventions inherited deliberately from the existing schema:
//    • money is Decimal(18,2), never Float — the same rule the accounting models
//      state explicitly, and for the same reason;
//    • state is a stable CODE, never a translated label, so an Arabic UI cannot
//      change what a row means.
// ═══════════════════════════════════════════════════════════════════════════════

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

/// How a lead reached us. Extended by configuration, not by code.
enum LeadSource {
  WALK_IN
  REFERRAL
  PHONE
  SOCIAL
  EXHIBITION
  WEBSITE
  OTHER
}

model Lead {
  id           String     @id @default(cuid())
  /// Business name. The person is a contact ON this lead, because a café has many
  /// people and none of them is the customer.
  companyName  String
  companyNameAr String?
  contactName  String
  phone        String?
  email        String?
  city         String?
  address      String?
  source       LeadSource @default(OTHER)
  sourceNote   String?
  status       LeadStatus @default(NEW)

  /// Who is responsible. Ownership is the scoping key for every read and write.
  ownerId      String
  owner        Employee   @relation("LeadOwner", fields: [ownerId], references: [id])

  /// The next commitment. A lead with no next step is the thing this screen exists
  /// to make visible, so it is a first-class column rather than a derived guess.
  nextFollowUpAt DateTime?

  notes        String?

  /// Normalised duplicate-detection keys. Written by the service, never by a client.
  /// Deliberately NOT unique: two genuine contacts can share a company, and merging
  /// on name similarity alone is how real customers get destroyed.
  normalizedCompany String?
  normalizedPhone   String?

  conversion   LeadConversion?
  activities   Activity[]

  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ownerId, status])
  @@index([status, nextFollowUpAt])
  @@index([normalizedCompany])
  @@index([normalizedPhone])
}

/// The proof that a lead became a customer and an opportunity.
///
/// Unique on leadId: converting twice is impossible, which is what makes a
/// double-clicked button harmless. Every conversion metric is computed from these
/// rows — never from counting leads and opportunities in a period and dividing,
/// which measures nothing when the two sets are unrelated.
model LeadConversion {
  id            String      @id @default(cuid())
  leadId        String      @unique
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Restrict)

  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  /// True when this conversion created the customer rather than linking an existing one.
  customerCreated Boolean   @default(false)

  convertedById String?
  convertedAt   DateTime    @default(now())

  @@index([customerId])
  @@index([convertedAt])
}

/// A configurable pipeline column. Terminal outcomes are NOT stages — see Opportunity.
/// What a stage MEANS to the automation, as distinct from what it is called.
///
/// The lifecycle has to know which column a newly-qualified lead lands in and which one an
/// issued quotation moves a deal to. Matching on the label is the obvious way and the wrong
/// one: the labels are translated, editable and, in this deployment, actually read
/// "Qualifying" and "Proposal". Matching on position is no better — inserting a stage
/// silently redirects the automation.
///
/// So the meaning is configured, once, by whoever configures the stages. A stage with no
/// purpose is an ordinary stage; NEW deliberately has no entry here because nothing
/// automatic puts a deal there.
enum PipelineStagePurpose {
  QUALIFICATION
  QUOTATION
}

model PipelineStage {
  id          String        @id @default(cuid())
  /// Stable identity. The label may be translated; this may not change.
  code        String        @unique
  nameEn      String
  nameAr      String
  position    Int
  /// Default probability offered when a deal enters this stage. Advisory only.
  probability Int           @default(0)
  /// At most one stage may hold each purpose — the unique index is what stops two columns
  /// both claiming to be where quotations land.
  purpose     PipelineStagePurpose? @unique
  isActive    Boolean       @default(true)

  opportunities Opportunity[]
  stageEvents   OpportunityStageEvent[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([position])
}

/// Terminal result. Separate from stage on purpose: a deal is either still moving
/// through the pipeline, or it is finished. Collapsing the two into one enum is how
/// "Won" ends up being draggable back into "Negotiation".
enum OpportunityOutcome {
  OPEN
  WON
  LOST
}

model Opportunity {
  id             String             @id @default(cuid())
  title          String
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id])

  stageId        String
  stage          PipelineStage      @relation(fields: [stageId], references: [id])

  outcome        OpportunityOutcome @default(OPEN)
  /// Required by the service whenever outcome becomes LOST.
  lostReason     String?
  closedAt       DateTime?

  /// Expected value. Currency is explicit so a future multi-currency policy has
  /// somewhere to land; the commission engine refuses anything but SAR today.
  amount         Decimal            @default(0) @db.Decimal(18, 2)
  currency       String             @default("SAR")
  probability    Int                @default(0)
  expectedCloseAt DateTime?
  nextFollowUpAt DateTime?

  ownerId        String
  owner          Employee           @relation("OpportunityOwner", fields: [ownerId], references: [id])

  conversion     LeadConversion?
  owners         OpportunityOwner[]
  stageEvents    OpportunityStageEvent[]
  quotes         Quote[]
  samples        SampleShipment[]
  activities     Activity[]
  orderLinks     OpportunityOrder[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ownerId, outcome])
  @@index([stageId, outcome])
  @@index([outcome, closedAt])
  @@index([nextFollowUpAt])
  salesCollections SalesCollection[]
}

/// Split attribution. Percentages are stored, not inferred, and the service requires
/// them to total 100 when any split exists.
///
/// Historical accruals are never re-pointed when ownership changes: a new split takes
/// effect from its own effectiveFrom, and what was already earned stays earned.
model OpportunityOwner {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation("OpportunitySplitOwner", fields: [employeeId], references: [id])
  /// 0–100, two decimals. 60.00 means sixty percent.
  sharePercent  Decimal     @db.Decimal(5, 2)
  effectiveFrom DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, employeeId])
  @@index([employeeId])
}

/// Every stage move, owner change and value change, kept for the pipeline-duration
/// report and for answering "who moved this and when".
model OpportunityStageEvent {
  id            String        @id @default(cuid())
  opportunityId String
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fromStageId   String?
  toStageId     String?
  toStage       PipelineStage? @relation(fields: [toStageId], references: [id])

  fromOutcome   OpportunityOutcome?
  toOutcome     OpportunityOutcome?

  reason        String?
  actorId       String?
  createdAt     DateTime      @default(now())

  @@index([opportunityId, createdAt])
}

enum SampleStatus {
  PREPARING
  SENT
  FEEDBACK_RECEIVED
  CANCELLED
}

/// Sample tracking. Records what was promised and what came back.
///
/// Deliberately does NOT move stock: the roastery has a packaging and inventory
/// path with its own guards, and a CRM screen must not become a second way to
/// decrement a shelf.
model SampleShipment {
  id            String       @id @default(cuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  productSkuId  String?
  productSku    ProductSKU?  @relation(fields: [productSkuId], references: [id])
  description   String?
  quantity      Decimal      @default(0) @db.Decimal(12, 3)
  unit          String       @default("KG")

  status        SampleStatus @default(PREPARING)
  sentAt        DateTime?
  feedbackAt    DateTime?
  feedbackScore Int?
  feedbackNotes String?

  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([opportunityId, status])
}

enum ActivityType {
  CALL
  VISIT
  MEETING
  NOTE
  TASK
  SAMPLE_FOLLOW_UP
}

/// WHAT HAPPENED in a recorded interaction, as distinct from what KIND it was.
///
/// The type says a call was made; only this says whether anybody answered. That
/// difference decides whether a prospect has become active selling work, so it is a
/// stored value the server reads — not a phrase somebody typed into a note.
///
/// The five outcomes that qualify a lead are the ones that cannot happen without the
/// customer having engaged: interest confirmed, an appointment agreed, or an appointment
/// held. NOTE_ONLY and FOLLOW_UP_REQUIRED deliberately do not, and neither does a TASK —
/// an internal reminder to call someone next Tuesday is not the customer agreeing to
/// anything, and treating it as one fills the pipeline with deals nobody is working.
enum ActivityOutcome {
  NO_ANSWER
  LEFT_MESSAGE
  INTERESTED
  MEETING_SCHEDULED
  VISIT_SCHEDULED
  MEETING_COMPLETED
  VISIT_COMPLETED
  FOLLOW_UP_REQUIRED
  NOT_INTERESTED
  NOTE_ONLY
}

/// A call, visit, note or task. Attaches to a lead or an opportunity, and survives
/// conversion: the lead's history stays readable after it becomes a customer.
///
/// Recording that contact happened is NOT sending a message. Nothing here dispatches
/// email, SMS or WhatsApp, and no screen implies it does.
model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  subject       String
  body          String?

  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])

  /// Nullable: every activity written before this existed has no recorded outcome, and
  /// inventing one for them would be a claim about conversations nobody witnessed.
  outcome       ActivityOutcome?

  dueAt         DateTime?
  completedAt   DateTime?

  ownerId       String
  owner         Employee     @relation("ActivityOwner", fields: [ownerId], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId, completedAt, dueAt])
  @@index([leadId])
  @@index([opportunityId])
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model Quote {
  id            String      @id @default(cuid())
  /// Human reference, unique per revision chain.
  quoteNumber   String      @unique
  revision      Int         @default(1)
  /// Points at the quote this one revises, so a chain is walkable in both directions.
  supersedesId  String?     @unique
  supersedes    Quote?      @relation("QuoteRevision", fields: [supersedesId], references: [id])
  supersededBy  Quote?      @relation("QuoteRevision")

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  status        QuoteStatus @default(DRAFT)
  currency      String      @default("SAR")
  validUntil    DateTime?

  /// Totals computed on the server from the lines. Stored so an issued quote is a
  /// fixed document: recomputing it later from live prices would change history.
  subtotal      Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(18, 2)

  /// Frozen copy of the lines and prices at the moment of issue.
  issuedSnapshot Json?
  issuedAt      DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectionNote String?

  /// Set when a discount above the configured threshold was authorised.
  discountApprovedById String?
  discountApprovedAt   DateTime?

  lines         QuoteLine[]
  orderLinks    OpportunityOrder[]

  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId, status])
  @@index([customerId])
  salesCollections SalesCollection[]
}

model QuoteLine {
  id           String     @id @default(cuid())
  quoteId      String
  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productSkuId String?
  productSku   ProductSKU? @relation(fields: [productSkuId], references: [id])
  /// Free-text description for a line with no catalogue SKU (a bespoke blend, a service).
  description  String?

  /// Decimal(12,3) carries kilogram fractions honestly. Whether fractions are ALLOWED
  /// is a product question the service asks the SKU, not something the column decides:
  /// 1.5 kg of beans is ordinary, 1.5 retail bags is not.
  quantity     Decimal    @db.Decimal(12, 3)
  unit         String     @default("KG")

  unitPrice    Decimal    @db.Decimal(18, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @db.Decimal(5, 2)

  lineSubtotal Decimal    @default(0) @db.Decimal(18, 2)
  lineTax      Decimal    @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal    @default(0) @db.Decimal(18, 2)

  position     Int        @default(0)

  @@index([quoteId, position])
}

/// The bridge from a won deal to the order system.
///
/// Unique on (quoteId, orderId) plus a unique requestKey: converting the same accepted
/// quote twice returns the first order instead of creating a second. One deal may
/// legitimately produce several orders over time — repeat business is not a defect —
/// so this is a many-to-many link rather than a column on Opportunity.
model OpportunityOrder {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  quoteId       String?
  quote         Quote?      @relation(fields: [quoteId], references: [id])
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Distinguishes the first order won from the repeat orders that follow it, which
  /// the attribution policy may treat differently.
  isFirstOrder  Boolean     @default(false)
  requestKey    String      @unique

  createdById   String?
  createdAt     DateTime    @default(now())

  @@unique([quoteId, orderId])
  @@index([opportunityId])
  @@index([orderId])
}

// ─── Commissions ───────────────────────────────────────────────────────────────

enum CommissionBasis {
  /// Net collected cash, excluding tax, refunds and non-qualifying lines.
  NET_COLLECTION
}

enum CommissionTierMode {
  /// Each tier's rate applies only to the portion of base inside that tier's band.
  INCREMENTAL
  /// The highest reached tier's rate applies to the whole base.
  /// Declared so the concept is nameable; REFUSED at validation in this version
  /// rather than half-implemented. See COMMISSION_RULES.md.
  RETROACTIVE
}

model CommissionPlan {
  id          String                  @id @default(cuid())
  code        String                  @unique
  name        String
  nameAr      String?
  description String?
  isActive    Boolean                 @default(true)

  versions    CommissionPlanVersion[]
  assignments CommissionAssignment[]

  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

/// A plan is versioned, and a version is immutable once anything has accrued against
/// it. Editing a live rule in place would silently restate commissions people have
/// already been told they earned.
model CommissionPlanVersion {
  id            String             @id @default(cuid())
  planId        String
  plan          CommissionPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int

  basis         CommissionBasis    @default(NET_COLLECTION)
  tierMode      CommissionTierMode @default(INCREMENTAL)
  /// The flat rate applied when no tier matches, as a percentage: 1.500000 = 1.5%.
  baseRatePercent Decimal          @db.Decimal(9, 6)
  currency      String             @default("SAR")

  effectiveFrom DateTime
  effectiveTo   DateTime?

  tiers         CommissionTier[]
  assignments   CommissionAssignment[]
  accruals      CommissionAccrual[]

  ledgerEntries  CommissionLedgerEntry[]
  createdById   String?
  createdAt     DateTime           @default(now())

  @@unique([planId, version])
  @@index([effectiveFrom])
}

/// One band. `fromAmount` inclusive, `toAmount` exclusive; a null `toAmount` is "and above".
model CommissionTier {
  id              String                @id @default(cuid())
  planVersionId   String
  planVersion     CommissionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  fromAmount      Decimal               @db.Decimal(18, 2)
  toAmount        Decimal?              @db.Decimal(18, 2)
  /// Added to the base rate for the portion inside this band, in percentage points:
  /// 0.500000 means "half a point more on this slice".
  ratePercent     Decimal               @db.Decimal(9, 6)
  position        Int                   @default(0)

  @@index([planVersionId, position])
}

model CommissionAssignment {
  id            String                @id @default(cuid())
  employeeId    String
  employee      Employee              @relation("CommissionAssignee", fields: [employeeId], references: [id])
  planId        String
  plan          CommissionPlan        @relation(fields: [planId], references: [id])
  planVersionId String
  planVersion   CommissionPlanVersion @relation(fields: [planVersionId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdById   String?
  createdAt     DateTime              @default(now())

  @@index([employeeId, effectiveFrom])
}

enum CollectionEventStatus {
  RECORDED
  REVERSED
}

/// SANDBOX COLLECTION SOURCE.
///
/// This system has no invoice, payment or receivables model — checked, not assumed.
/// Commission is owed on money actually collected, so rather than invent a receivables
/// ledger inside a CRM task, collection is an ADAPTER and this table is its one
/// implementation: events entered through a clearly-labelled testing surface.
///
/// `sourceSystem` is stored on every row so a real integration can be added later and
/// told apart from sandbox data without guessing. The UI states that the source is a
/// sandbox; nothing here is described as a working financial integration.
model CollectionEvent {
  id            String                @id @default(cuid())
  sourceSystem  String                @default("SANDBOX")
  /// The source's own identifier, so a re-delivered webhook is recognised, not re-accrued.
  externalRef   String
  status        CollectionEventStatus @default(RECORDED)

  customerId    String?
  customer      Customer?             @relation(fields: [customerId], references: [id])
  opportunityId String?
  orderId       String?
  order         Order?                @relation(fields: [orderId], references: [id])

  /// Gross cash received, and the split that makes the qualifying base computable.
  amountGross   Decimal               @db.Decimal(18, 2)
  amountTax     Decimal               @default(0) @db.Decimal(18, 2)
  /// Portion of the net that does not qualify (excluded products, freight, …).
  amountNonQualifying Decimal         @default(0) @db.Decimal(18, 2)
  currency      String                @default("SAR")

  collectedAt   DateTime
  reversedAt    DateTime?
  reversalOfId  String?
  note          String?

  accruals      CommissionAccrual[]

  ledgerEntries  CommissionLedgerEntry[]
  /// The finance-verified receipt that produced this event, when one did. Sandbox events
  /// have none, which is how the two sources stay tellable apart.
  salesCollection SalesCollection?    @relation("CollectionCommissionEvent")

  createdById   String?
  createdAt     DateTime              @default(now())

  @@unique([sourceSystem, externalRef])
  @@index([customerId, collectedAt])
  @@index([collectedAt])
}

enum AccrualStatus {
  PREVIEW
  ACCRUED
  APPROVED
  PAID
  REVERSED
}

/// What one employee earned from one collection event under one plan version.
///
/// Unique on (collectionEventId, employeeId, planVersionId): a re-delivered collection
/// event cannot accrue a second time for the same person on the same rules. Corrections
/// are new rows, never edits to an approved one.
model CommissionAccrual {
  id                String                @id @default(cuid())
  collectionEventId String
  collectionEvent   CollectionEvent       @relation(fields: [collectionEventId], references: [id], onDelete: Restrict)

  employeeId        String
  employee          Employee              @relation("CommissionEarner", fields: [employeeId], references: [id])
  planVersionId     String
  planVersion       CommissionPlanVersion @relation(fields: [planVersionId], references: [id])

  /// Period the accrual belongs to, as an Asia/Riyadh month, stored as the UTC instant
  /// of that month's first moment in Riyadh.
  periodStart       DateTime
  periodEnd         DateTime

  /// The qualifying base this row was computed from, and the share applied to it.
  qualifyingBase    Decimal               @db.Decimal(18, 2)
  sharePercent      Decimal               @default(100) @db.Decimal(5, 2)
  /// Effective rate actually applied, after tiers — recorded so the figure can be
  /// explained to the person who earned it without recomputing anything.
  effectiveRatePercent Decimal            @db.Decimal(9, 6)
  amount            Decimal               @db.Decimal(18, 2)
  currency          String                @default("SAR")

  status            AccrualStatus         @default(ACCRUED)
  approvedById      String?
  approvedAt        DateTime?

  ledgerEntries     CommissionLedgerEntry[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([collectionEventId, employeeId, planVersionId])
  @@index([employeeId, periodStart])
  @@index([status, periodStart])
}

enum LedgerEntryType {
  ACCRUAL
  ADJUSTMENT
  REVERSAL
  PAYOUT
}

/// Append-only commission ledger. An approved figure is never rewritten; a correction
/// is a new entry that references what it corrects and says who made it and why.
model CommissionLedgerEntry {
  id          String            @id @default(cuid())
  type        LedgerEntryType
  employeeId  String
  employee    Employee          @relation("CommissionLedgerOwner", fields: [employeeId], references: [id])

  accrualId   String?
  accrual     CommissionAccrual? @relation(fields: [accrualId], references: [id])
  /// A single entry this one corrects. Kept for the manual `adjust` path, which targets at
  /// most one. Engine reversals use `corrects` below, because one negative movement can
  /// compensate several earlier ones once tiers or splits are involved.
  correctsId  String?

  periodStart DateTime
  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("SAR")
  reason      String?

  /// ── Durable provenance ───────────────────────────────────────────────────────────
  ///
  /// Written once, at the moment of the movement, and never updated. The accrual row is a
  /// mutable projection of what an event currently contributes; these fields are the
  /// immutable record of what was actually awarded when the money moved, so a later
  /// recomputation cannot restate history. Null on entries written before this existed and
  /// on manual adjustments, which have no engine computation behind them.
  collectionEventId    String?
  collectionEvent      CollectionEvent?       @relation(fields: [collectionEventId], references: [id])
  planVersionId        String?
  planVersion          CommissionPlanVersion? @relation(fields: [planVersionId], references: [id])
  /// The share of this event's qualifying base that this movement was computed on.
  qualifyingBase       Decimal?               @db.Decimal(18, 2)
  sharePercent         Decimal?               @db.Decimal(5, 2)
  /// The period's effective rate at the time — which is why a tiered month's marginal
  /// amount is not simply base x headline rate.
  effectiveRatePercent Decimal?               @db.Decimal(9, 6)

  /// What this movement compensates, and by how much of itself. A partial reversal, a
  /// split across two earners, or a tier change that reaches back over several earlier
  /// movements all produce more than one row here.
  corrects    CommissionLedgerCorrection[] @relation("CorrectingEntry")
  correctedBy CommissionLedgerCorrection[] @relation("CorrectedEntry")

  actorId     String?
  createdAt   DateTime          @default(now())

  @@index([employeeId, periodStart])
  @@index([type, createdAt])
  @@index([collectionEventId])
  @@index([accrualId])
}

/// Which earlier movement a negative movement compensates, and by how much.
///
/// A join table rather than a second nullable column because the relationship is genuinely
/// many-to-many in amount: reversing one collection in a tiered month lowers the period's
/// effective rate, so the single negative delta pays back part of its own event's movement
/// AND part of movements belonging to other events. Recording one `correctsId` would have
/// to pick one of them and silently drop the rest.
///
/// Allocation is decided at write time from the append-only log, never reconstructed later
/// by matching amounts or timestamps.
model CommissionLedgerCorrection {
  id        String @id @default(cuid())

  /// The negative movement doing the compensating.
  entryId   String
  entry     CommissionLedgerEntry @relation("CorrectingEntry", fields: [entryId], references: [id], onDelete: Cascade)

  /// The earlier movement being compensated.
  correctsEntryId String
  corrects        CommissionLedgerEntry @relation("CorrectedEntry", fields: [correctsEntryId], references: [id], onDelete: Restrict)

  /// A positive figure: how much of `entry` is applied against `corrects`. The rows for one
  /// entry sum to at most the absolute value of that entry's amount.
  amount    Decimal @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([entryId, correctsEntryId])
  @@index([correctsEntryId])
}

/// A monthly sales target for a person. Deliberately separate from commission: hitting
/// a target may pay a bonus, but a target is not a commission rate and the two are not
/// summed by accident.
model SalesTarget {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation("SalesTargetOwner", fields: [employeeId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  targetAmount Decimal  @db.Decimal(18, 2)
  currency     String   @default("SAR")
  bonusAmount  Decimal  @default(0) @db.Decimal(18, 2)
  note         String?

  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, periodStart])
  @@index([periodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales collections — manual, finance-verified receipts (additive).
//
// This ERP still has no invoice or accounts-receivable subsystem; that was checked
// against the schema, not assumed. What follows is NOT one. It is a durable internal
// record of "a salesperson says money arrived, and Finance either agrees or does not",
// and it is the only thing allowed to create commission entitlement.
//
// It deliberately does NOT replace `CollectionEvent`. That table is the commission
// engine's input adapter and is unchanged: on approval this workflow writes one row into
// it stamped `MANUAL_FINANCE_VERIFICATION`, so the engine's tiers, splits, period
// boundaries and reversal arithmetic are reused rather than reimplemented beside them.
//
// Nothing here is a bank integration and no screen says it is.
// ─────────────────────────────────────────────────────────────────────────────

/// How the money arrived. Recorded for reconciliation; used in no calculation.
enum SalesCollectionMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  POS_CARD
  OTHER
}

/// The lifecycle of a claimed receipt.
///
/// `APPROVED` is the only state that has ever created commission, and `REVERSED` is the
/// only way out of it — there is no delete and no edit-in-place, because by then the
/// figure has been used to tell somebody what they earned.
enum SalesCollectionStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  REVERSED
}

model SalesCollection {
  id String @id @default(cuid())

  /// What the money is against. The opportunity is required — commission is owed on a
  /// deal — and the accepted quotation is what the amounts are checked against.
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  quoteId       String?
  quote         Quote?      @relation(fields: [quoteId], references: [id])
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  /// Client-generated, unique per submitter: a double-clicked form, a retried request and
  /// a replayed queue message all carry the same key and land once.
  idempotencyKey  String
  /// The payer's own reference — a transfer id, a cheque number. Deliberately NOT unique:
  /// two genuine receipts can quote the same bank batch.
  referenceNumber String?

  /// Gross is what the salesperson claims arrived. Tax and net are DERIVED by the server
  /// from the linked document and then stored, so the figures a decision was made against
  /// survive a later revision of that document.
  amountGross Decimal @db.Decimal(18, 2)
  amountTax   Decimal @db.Decimal(18, 2)
  amountNet   Decimal @db.Decimal(18, 2)
  currency    String  @default("SAR")

  paymentMethod SalesCollectionMethod @default(BANK_TRANSFER)
  collectedAt   DateTime
  note          String?

  status SalesCollectionStatus @default(PENDING_VERIFICATION)

  submittedById String
  submittedBy   Employee @relation("CollectionSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  /// The verify-or-reject decision. Kept apart from the reversal fields below, because a
  /// reversal happens AFTER an approval and must not overwrite who approved it.
  decidedById    String?
  decidedBy      Employee? @relation("CollectionDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionReason String?

  reversedById   String?
  reversedBy     Employee? @relation("CollectionReverser", fields: [reversedById], references: [id])
  reversedAt     DateTime?
  reversalReason String?

  /// The commission-adapter row this became when Finance approved it. One-to-one, and the
  /// unique constraint is what makes a replayed approval a no-op rather than a second
  /// accrual.
  collectionEventId String?          @unique
  collectionEvent   CollectionEvent? @relation("CollectionCommissionEvent", fields: [collectionEventId], references: [id])

  evidence CollectionEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submittedById, idempotencyKey])
  @@index([opportunityId, status])
  @@index([status, submittedAt])
  @@index([submittedById, submittedAt])
}

/// Proof that the money arrived: a transfer screenshot, a deposit slip, a receipt.
///
/// The bytes live in `content` rather than on disk, because the deployment target has an
/// ephemeral filesystem and a file written there is gone at the next cold start. A
/// deliberate first implementation for a small, low-volume, private artefact:
/// `lib/services/sales/evidence.ts` is the only reader and writer, so moving to object
/// storage later changes that file and this column and nothing else.
model CollectionEvidence {
  id           String          @id @default(cuid())
  collectionId String
  collection   SalesCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  filename String
  /// The type proven by the file's own signature, never the one the browser claimed.
  mimeType String
  byteSize Int
  /// SHA-256 of the bytes, so a re-upload of the same proof is recognisable and a stored
  /// file can be shown not to have changed.
  checksum String
  content  Bytes

  uploadedById String
  uploadedBy   Employee @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([collectionId])
}

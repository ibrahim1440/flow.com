{
  "name": "hiqbah-coffee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --webpack",
    "build": "tsx scripts/validate-env.ts && prisma generate && next build",
    "validate:env": "tsx scripts/validate-env.ts",
    "start": "next start",
    "lint": "eslint",
    "seed": "prisma generate && tsx prisma/seed.ts",
    "db:push:local": "prisma db push",
    "db:migrate:deploy": "node scripts/migrate-deploy.mjs",
    "db:studio": "prisma studio",
    "e2e": "node scripts/e2e/regression/run-all.mjs",
    "regression": "node scripts/e2e/regression/run-all.mjs",
    "regression:sales": "node scripts/e2e/regression/run-sales.mjs",
    "uat:sales": "playwright test --project=sales",
    "e2e:legacy": "node scripts/e2e/shelf-flow.mjs && node scripts/e2e/roast-to-stock.mjs && node scripts/e2e/race.mjs && node scripts/e2e/pages.mjs",
    "e2e:legacy:shelf": "node scripts/e2e/shelf-flow.mjs",
    "e2e:legacy:race": "node scripts/e2e/race.mjs",
    "e2e:legacy:stock": "node scripts/e2e/roast-to-stock.mjs",
    "e2e:legacy:pages": "node scripts/e2e/pages.mjs",
    "e2e:legacy:reset": "node scripts/e2e/reset.mjs",
    "uat": "playwright test",
    "uat:desktop": "playwright test --project=desktop",
    "uat:report": "playwright show-report",
    "db:generate": "prisma generate",
    "build:test-domain": "tsc -p tsconfig.test-domain.json",
    "harness:build": "node tests/harness/build.mjs",
    "harness:ui": "node tests/harness/build.mjs && playwright test -c playwright.harness.config.ts",
    "test:shell": "playwright test -c playwright.shell.config.ts",
    "preview:nav-fixtures": "tsx scripts/sales-preview/nav-fixtures.ts",
    "preview:nav-fixtures:remove": "tsx scripts/sales-preview/nav-fixtures.ts --remove",
    "test:finance:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/finance/unit/*.test.ts",
    "test:automation:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/automation/*.test.ts",
    "test:automation:http": "tsx --test --test-concurrency=1 tests/automation/http/*.test.ts",
    "test:print:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/print/unit/*.test.ts",
    "test:ops:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/ops/unit/*.test.ts",
    "test:ops:http": "tsx --test --test-concurrency=1 tests/ops/http/*.test.ts",
    "test:ui:unit": "tsx --import ./tests/support/css-stub.mjs --test tests/ui/unit/*.test.ts",
    "test:sales:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/sales/unit/*.test.ts",
    "test:users:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/users/unit/*.test.ts",
    "test:users:http": "tsx --test --test-concurrency=1 tests/users/http/*.test.ts",
    "test:notifications:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/notifications/unit/*.test.ts",
    "test:notifications:http": "tsx --test --test-concurrency=1 tests/notifications/http/*.test.ts",
    "test:sales:http": "tsx --test --test-concurrency=1 tests/sales/http/*.test.ts",
    "test:sales:db": "tsx --import ./tests/support/simple-mode-off.mjs --test --test-concurrency=1 --test-force-exit tests/sales/db/*.test.ts",
    "test:finance:db": "tsx --env-file=.env.test --import ./tests/support/simple-mode-off.mjs --test --test-concurrency=1 --test-force-exit tests/finance/integration/*.test.ts",
    "db:local": "node scripts/finance/local-postgres.mjs start",
    "test:finance:http": "node --test tests/finance/http/*.test.mjs",
    "test:finance:ui": "node tests/finance/visual/workflow-ui.mjs",
    "finance:fixture": "tsx --env-file=.env scripts/finance/seed-local-fixture.ts",
    "db:local:stop": "node scripts/finance/local-postgres.mjs stop",
    "db:local:status": "node scripts/finance/local-postgres.mjs status",
    "test:hr:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/hr/unit/*.test.ts",
    "test:hr:db": "tsx --env-file=.env.test --import ./tests/support/simple-mode-off.mjs --test --test-concurrency=1 --test-force-exit tests/hr/integration/*.test.ts",
    "test:hr:http": "node scripts/hr/run-http-suites.mjs",
    "test:hr:shell": "node --test tests/hr/visual/shell.test.mjs",
    "hr:fixture": "tsx --env-file=.env scripts/hr/seed-preview-fixture.ts",
    "test:marketing:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/marketing/unit/*.test.ts",
    "test:marketing:http": "tsx --test --test-concurrency=1 tests/marketing/http/*.test.ts",
    "test:workspace:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/workspace/unit/*.test.ts",
    "test:workspace:db": "tsx --import ./tests/support/simple-mode-off.mjs --import ./tests/support/server-only-stub.mjs --test --test-concurrency=1 --test-force-exit tests/workspace/db/*.test.ts",
    "test:workspace:visual": "node --test --test-concurrency=1 tests/workspace/visual/*.test.mjs",
    "test:accounting:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/accounting/unit/*.test.ts",
    "test:accounting:db": "tsx --import ./tests/support/simple-mode-off.mjs --test --test-concurrency=1 --test-force-exit tests/accounting/db/*.test.ts",
    "test:accounting:http": "tsx --test --test-concurrency=1 tests/accounting/http/*.test.ts",
    "test:zatca:unit": "tsx --import ./tests/support/simple-mode-off.mjs --test tests/zatca/unit/*.test.ts",
    "test:zatca:db": "tsx --import ./tests/support/simple-mode-off.mjs --test --test-concurrency=1 --test-force-exit tests/zatca/db/*.test.ts",
    "test:zatca:http": "tsx --test --test-concurrency=1 tests/zatca/http/*.test.ts",
    "zatca:mock": "tsx tests/zatca/mock-fatoora.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "2.8.2",
    "@xmldom/xmldom": "0.9.12",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "prisma": "^7.8.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
